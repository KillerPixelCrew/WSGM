<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IsTestProject>true</IsTestProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);1573;1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1"/>
    <!-- Avalonia.Headless.XUnit 12.1.2 is built against xunit.v3 3.2.2; 4.0 breaks its test discoverer. -->
    <PackageReference Include="xunit.v3" Version="3.2.2"/>
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" PrivateAssets="all"/>
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.2"/>
    <PackageReference Include="Avalonia.Skia" Version="12.1.2"/>
    <ProjectReference Include="../../src/WSGM/WSGM.csproj"/>
    <Compile Include="../Shared/RepositoryFiles.cs" Link="Shared/RepositoryFiles.cs"/>
    <Compile Include="../WSGM.Tests/Fakes/FakeButtonSource.cs" Link="Fakes/FakeButtonSource.cs"/>
    <Compile Include="../WSGM.Tests/Fakes/FakeHybridCoreApi.cs" Link="Fakes/FakeHybridCoreApi.cs"/>
    <Using Include="Xunit"/>
    <None Update="Baselines/*.png" CopyToOutputDirectory="PreserveNewest"/>
    <None Update="Fixtures/*.json" CopyToOutputDirectory="PreserveNewest"/>
  </ItemGroup>
</Project>

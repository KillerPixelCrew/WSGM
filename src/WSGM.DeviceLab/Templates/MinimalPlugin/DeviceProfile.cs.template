// Generated by Device Lab from a returned lab report. It is data, not a driver: the identity rules,
// button sources, axis maps and capability roles the tester's evidence and the knowledge record gave.
// Entries marked Confirmed were promoted from the lab evidence; the others are still unconfirmed
// beliefs. Use them to build the plugin's transports, and re-read the device before trusting any of it.

using System.Collections.Generic;
using WSGM.Device.Sdk.Capabilities;
using WSGM.Device.Sdk.Identity;

namespace {{ROOT_NAMESPACE}};

/// <summary>How a button press reaches Windows.</summary>
internal enum DeviceButtonSource
{
    /// <summary>The firmware types a key or key combination.</summary>
    KeyboardChord,

    /// <summary>A bit, or a whole byte value, in a vendor HID input report.</summary>
    HidReport,

    /// <summary>A WMI event carries a code.</summary>
    WmiEvent,

    /// <summary>The standard gamepad report or XInput state.</summary>
    Gamepad,

    /// <summary>Known to exist; its source was not found.</summary>
    Declared,
}

/// <summary>One button and the source it arrives on.</summary>
/// <param name="Name">Vendor or tester name.</param>
/// <param name="WizardButton">Device Lab control name, for example <c>OemLeft</c>.</param>
/// <param name="Source">Where it arrives.</param>
/// <param name="PressKeys">Keys the firmware sends on press, for a keyboard chord.</param>
/// <param name="ReportId">HID report ID, for a report source.</param>
/// <param name="ByteOffset">Byte offset with the report ID at 0.</param>
/// <param name="Mask">Bit mask, or the exact byte value when <paramref name="MatchesValue" /> is set.</param>
/// <param name="MatchesValue">Whether <paramref name="Mask" /> is a whole-byte value.</param>
/// <param name="EventCode">WMI event code, for a WMI source.</param>
/// <param name="Confirmed">Whether a tester confirmed it in the Device Lab wizard.</param>
internal sealed record DeviceButton(
    string Name,
    string? WizardButton,
    DeviceButtonSource Source,
    IReadOnlyList<string> PressKeys,
    int? ReportId,
    int? ByteOffset,
    int? Mask,
    bool MatchesValue,
    int? EventCode,
    bool Confirmed);

/// <summary>
///     A sensor axis map in the knowledge record's convention: output[Swap[raw]] = Sign[output] * raw, with
///     output X right, Y out of the screen and Z towards the player.
/// </summary>
/// <param name="Swap">Raw axis to output axis.</param>
/// <param name="Sign">Sign of each output axis.</param>
/// <param name="Confirmed">Whether a tester confirmed it in the Device Lab wizard.</param>
internal sealed record DeviceAxisMap(
    IReadOnlyDictionary<string, string> Swap,
    IReadOnlyDictionary<string, int> Sign,
    bool Confirmed);

/// <summary>What the lab report established about this device.</summary>
internal static class DeviceProfile
{
    /// <summary>The report this profile came from.</summary>
    public const string SourceReport = "{{LAB_REPORT_CS}}";

    /// <summary>The knowledge record it was built from.</summary>
    public const string KnowledgeRecord = "{{RECORD_ID_CS}}";

    /// <summary>Identity rules, the same ones the package manifest declares.</summary>
    public static IReadOnlyList<HardwareMatchRule> Hardware { get; } =
    [
{{HARDWARE_CS}}
    ];

    /// <summary>Buttons beyond the standard gamepad, and where each arrives.</summary>
    public static IReadOnlyList<DeviceButton> Buttons { get; } =
    [
{{BUTTONS_CS}}
    ];

    /// <summary>Gyrometer axis map, or null when none is known.</summary>
    public static DeviceAxisMap? Gyrometer { get; } = {{GYROMETER_CS}};

    /// <summary>Accelerometer axis map, or null when none is known.</summary>
    public static DeviceAxisMap? Accelerometer { get; } = {{ACCELEROMETER_CS}};

    /// <summary>Capability roles the evidence supports; the manifest also lists the example roles.</summary>
    public static IReadOnlyList<CapabilityRole> Capabilities { get; } =
    [
{{CAPABILITIES_CS}}
    ];

    /// <summary>Whether the observed identity matches one of <see cref="Hardware" />.</summary>
    /// <param name="identity">Identity from the detection context.</param>
    /// <returns>True for an exact rule match.</returns>
    public static bool Matches(DeviceIdentitySnapshot identity)
    {
        return HardwareMatcher.Match(Hardware, identity) is { Fallback: false };
    }
}

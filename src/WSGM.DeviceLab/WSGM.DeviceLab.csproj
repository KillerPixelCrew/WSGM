<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The Windows 10 SDK version exposes Windows.Gaming.Input and Windows.Devices.Sensors to the wizard. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>wsgm-device</AssemblyName>
    <RootNamespace>WSGM.DeviceLab</RootNamespace>
    <Version>0.1.2</Version>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <!-- LibraryImport generates unsafe marshalling stubs for the cfgmgr32 inventory calls. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3"/>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3"/>
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3"/>
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3"/>
    <!-- Device Lab inventory and probes use WMI; WSGM proper has no direct System.Management dependency. -->
    <PackageReference Include="System.Management" Version="10.0.12"/>
    <!-- Read-only EC, AMD SMU and Intel MSR access through PawnIO, the version Handheld Companion 1.3.1.6 ships (MPL-2.0). -->
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6"/>
    <PackageReference Include="Vortice.DirectInput" Version="3.8.3"/>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference
      Include="..\WSGM.Device.Sdk\WSGM.Device.Sdk.csproj"/>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\WSGM\Interop\Kernel32.cs"
             Link="Shared\Kernel32.cs"/>
    <Compile Include="..\WSGM\Interop\NativePackageSource.cs"
             Link="Shared\NativePackageSource.cs"/>
    <Compile Include="..\WSGM\Interop\NativePathIdentity.cs"
             Link="Shared\NativePathIdentity.cs"/>
    <Compile Include="..\WSGM\Interop\NativeHidHide.cs"
             Link="Shared\NativeHidHide.cs"/>
  </ItemGroup>
  <!-- The wizard records the commit it was built from in every project manifest. -->
  <Target Name="StampSourceRevision" BeforeTargets="GetAssemblyVersion;GenerateAssemblyInfo"
          Condition="'$(SourceRevisionId)' == ''">
    <Exec Command="git rev-parse --short=12 HEAD" ConsoleToMSBuild="true" IgnoreExitCode="true"
          StandardOutputImportance="low" StandardErrorImportance="low" WorkingDirectory="$(MSBuildProjectDirectory)">
      <Output TaskParameter="ConsoleOutput" PropertyName="SourceRevisionId"/>
    </Exec>
  </Target>
  <ItemGroup>
    <!-- Knowledge records: extracted ones come from eng/extract-hc-devices.ps1, curated ones are hand-written. -->
    <EmbeddedResource Include="Knowledge\Devices\*.json">
      <LogicalName>WSGM.DeviceLab.Knowledge.Devices.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <!-- The PawnIO pin is always embedded; the installer only when eng/acquire-pawnio.ps1 ran first. -->
    <EmbeddedResource Include="..\..\external\pawnio\pawnio.lock.json"
                      LogicalName="WSGM.DeviceLab.PawnIO.lock.json"/>
    <EmbeddedResource Include="..\..\artifacts\pawnio\PawnIO_setup.exe"
                      Condition="Exists('..\..\artifacts\pawnio\PawnIO_setup.exe')"
                      LogicalName="WSGM.DeviceLab.PawnIO.setup.exe"/>
    <!-- The RyzenSMU module is embedded when eng/acquire-pawnio.ps1 extracted it; KX.exe is committed. -->
    <EmbeddedResource Include="..\..\artifacts\pawnio\RyzenSMU.bin"
                      Condition="Exists('..\..\artifacts\pawnio\RyzenSMU.bin')"
                      LogicalName="WSGM.DeviceLab.PawnIO.RyzenSMU.bin"/>
    <EmbeddedResource Include="..\..\external\kx\KX.exe" LogicalName="WSGM.DeviceLab.KX.exe"/>
    <EmbeddedResource Include="..\..\external\kx\kx.lock.json" LogicalName="WSGM.DeviceLab.KX.lock.json"/>
    <!-- The scaffold's LICENSE.txt is a checked-in template, not WSGM's own licence file. A
         generated plugin links only the MIT SDK, so stamping it with the application's GPL-3 (and
         with this project's copyright holder) claimed something untrue about someone else's work. -->
    <EmbeddedResource Include="Templates\MinimalPlugin\*.template">
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
    <!-- The wizard's "Help and licences" window shows these, so a single-file build carries them. -->
    <EmbeddedResource Include="README.md" LogicalName="WSGM.DeviceLab.Help.README.md"/>
    <EmbeddedResource Include="THIRD_PARTY_NOTICES.md" LogicalName="WSGM.DeviceLab.Help.THIRD_PARTY_NOTICES.md"/>
    <EmbeddedResource Include="LICENSE" LogicalName="WSGM.DeviceLab.Help.LICENSE"/>
    <None Update="THIRD_PARTY_NOTICES.md"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"/>
  </ItemGroup>
</Project>

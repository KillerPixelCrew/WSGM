<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors>$(WarningsAsErrors);CS1573;CS1591</WarningsAsErrors>
    <Description>Install layout, bundled plugin manifest, hardware offers and setup components shared by WSGM and its setup.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\WSGM.Device.Sdk\WSGM.Device.Sdk.csproj"/>
    <InternalsVisibleTo Include="WSGM.Tests"/>
  </ItemGroup>
  <ItemGroup>
    <!-- The logon service compiles the same file, so it lives under src\Shared. -->
    <Compile Include="..\Shared\Install\InstallLayout.cs" Link="InstallLayout.cs"/>
  </ItemGroup>
</Project>

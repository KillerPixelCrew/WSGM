<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <NativeOutput>$(MSBuildProjectDirectory)\obj\native\$(Configuration)</NativeOutput>
    <Description>Live Windows compositor backdrops for Avalonia overlay windows.</Description>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <None Include="$(NativeOutput)\Avalonia.LiveBackdrop.Native.dll" Link="Avalonia.LiveBackdrop.Native.dll"
          Condition="'$(OS)' == 'Windows_NT' and '$(SkipNativeArtifacts)' != 'true'"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="REFERENCE-LICENSE.txt" Link="Avalonia.LiveBackdrop.ThirdParty.txt"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../LICENSE" Link="Avalonia.LiveBackdrop.LICENSE.txt"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="BuildLiveBackdropNative" BeforeTargets="PrepareForBuild"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(OS)' == 'Windows_NT' and '$(SkipNativeArtifacts)' != 'true'"
          Inputs="$(MSBuildProjectDirectory)\Native\Backdrop.cpp;$(MSBuildProjectDirectory)\Native\build.ps1"
          Outputs="$(NativeOutput)\Avalonia.LiveBackdrop.Native.dll">
    <Exec Command="pwsh -NoProfile -File &quot;$(MSBuildProjectDirectory)\Native\build.ps1&quot; -OutputDirectory &quot;$(NativeOutput)&quot;" />
  </Target>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- No ImplicitUsings, same as WSGM proper: the shared BootManifest.cs carries
         explicit usings and must compile identically in both projects. -->
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\WSGM\Assets\wsgm.ico</ApplicationIcon>
    <AssemblyName>WSGM.LogonService</AssemblyName>
    <RootNamespace>WSGM.LogonService</RootNamespace>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <!-- The boot manifest is the only contract between the per-user app and this
         SYSTEM service — one shared source file, no project reference (the service
         must not pull in Avalonia or the rest of WSGM). -->
    <Compile Include="..\Shared\Boot\BootManifest.cs" Link="Shared\BootManifest.cs"/>
    <Compile Include="..\Shared\Boot\AtomicFile.cs" Link="Shared\AtomicFile.cs"/>
    <Compile Include="..\Shared\Install\InstallLayout.cs" Link="Shared\InstallLayout.cs"/>
    <!-- Rotating diagnostics log, shared with the launch wrapper the same way. -->
    <Compile Include="..\Shared\Process\RotatingFileLog.cs" Link="Shared\RotatingFileLog.cs"/>
    <Compile Include="..\Shared\Process\Win32Common.cs" Link="Shared\Win32Common.cs"/>
  </ItemGroup>
</Project>

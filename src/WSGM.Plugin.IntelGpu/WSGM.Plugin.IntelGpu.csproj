<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>0.1.0</Version>
    <!-- IGCL is bound through function pointers and blittable structs whose layouts mirror
         igcl_api.h exactly. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../WSGM.Plugin.Sdk/WSGM.Plugin.Sdk.csproj"/>
    <!-- The shared GPU runtime's state file and write admission, linked as NVIDIA and AMD link them. -->
    <Compile Include="../Shared/Gpu/*.cs" Link="Runtime/%(Filename)%(Extension)"/>
    <InternalsVisibleTo Include="WSGM.Plugin.IntelGpu.Tests"/>
    <None Update="plugin.wsgm.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/>
    <None Update="PROVENANCE.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/>
    <!-- The package ships its licence beside the assembly, because the installed package is read
         as a standalone directory with no repository around it. -->
    <None Update="LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/>
  </ItemGroup>
</Project>

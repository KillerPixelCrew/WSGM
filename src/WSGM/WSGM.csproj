<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>WSGM</AssemblyName>
    <RootNamespace>WSGM</RootNamespace>
    <Version>0.9.0</Version>

    <!-- NativeAOT single exe -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <!-- Per Avalonia NativeAOT guidance -->
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>

    <!-- A resident shell on an 8-16 GB handheld: favor small heap over GC
         throughput (no background GC thread; see also ConserveMemory below). -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>

    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  <ItemGroup>
    <!-- Steam Input Lease injects this gate into steam.exe while a WSGM input
         surface owns a lease. Keep both x64 native libraries beside the AOT
         executable; the managed binding resolves them by their file names. -->
    <None Include="Native\SteamInputLease\*.dll"
          Link="%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <!-- The lease CLI is the user-facing wrapper: its copied Steam launch
         option blocks Steam Input for one game, the same way the de-elevation
         helper's does for integrity. It needs steam_input_gate.dll beside it,
         which the rule above already places here. -->
    <None Include="Native\SteamInputLease\steam-input-lease.exe"
          Link="%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="Native\SteamInputLease\*.txt"
          Link="%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="Native\SteamInputLease\*.md"
          Link="%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <!-- Third-party license texts for managed packages we redistribute. Same
         ship-beside-the-exe pattern as the SteamInputLease license files above;
         the installer lists them explicitly in [Files]. -->
    <None Include="Licenses\*.txt"
          Link="%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- 1-9: how hard the GC works to keep the heap small; 9 = maximum. Reads
         fine under NativeAOT (embedded runtime config). -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="9" />
  </ItemGroup>
  <ItemGroup>
    <!-- Pinned exactly: a shell replacement must ship the patch level that was
         tested on device, and rebuilding a tag must reproduce the same binaries. -->
    <PackageReference Include="Avalonia" Version="11.3.18" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.18" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.18" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.18" />
    <!-- FluentAvaloniaTheme (the runtime accent pipeline regenerates its shades via
         CustomAccentColor) plus WinUI-style controls such as InfoBar and ToggleSwitch. -->
    <PackageReference Include="FluentAvaloniaUI" Version="2.4.1" />
    <!-- Boot-splash spinner styles (Unlicense; the license text ships from
         Licenses\ beside the exe). NativeAOT-publish compatibility was proven
         with a probe build before adopting the package. -->
    <PackageReference Include="LoadingIndicators.Avalonia" Version="11.0.11.1" />
    <!-- Pinned: FluentAvaloniaUI's transitive ColorPicker resolves at 11.2.5 against
         Avalonia 11.3.18 — the explicit pin removes the version skew. -->
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="11.3.18" />
    <!-- Controller input. Plain-DllImport bindings (AOT-safe), bundles native SDL3.dll
         for win-x64 so build and publish output pick it up automatically. -->
    <PackageReference Include="ppy.SDL3-CS" Version="2026.722.0" />
  </ItemGroup>
</Project>

    {
      "id": "armsx2",
      "name": "ARMSX2",
      "systems": ["ps2"],
      "architectures": ["arm64"],
      "executableNames": ["ARMSX2.exe"],
      "launchArguments": ["-batch", "-fullscreen", "-nogui", "--", "{rom}"],
      "packageType": "zip",
      "validationArguments": ["-version"],
      "validationExitCodes": [0, 1],
      "validationOutput": "ARMSX2",
      "sources": {
        "nightly": {
          "provider": "GitHub",
          "baseUrl": "https://api.github.com/",
          "repository": "ARMSX2/ARMSX2",
          "assetPattern": "^ARMSX2-.*-Windows-arm64[.]zip$"
        }
      },
      "dataPolicy": {
        "portableMarkers": ["portable.txt"],
        "dataArguments": ["-portable"],
        "requiresVisualCpp": true,
        "prerequisites": [
          {
            "kind": "bios",
            "name": "PlayStation 2 BIOS",
            "description": "Supply a locally dumped PS2 BIOS and select it in ARMSX2 when several are present.",
            "extensions": [".bin", ".rom"],
            "requiredExtensions": [".bin", ".rom"],
            "required": true,
            "allowDirectory": true,
            "destination": "bios",
            "iniFile": "inis/PCSX2.ini",
            "iniSection": "Folders",
            "iniKey": "Bios"
          }
        ]
      }
    },
    {
      "id": "model2",

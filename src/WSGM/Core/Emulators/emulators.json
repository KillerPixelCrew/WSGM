      "sources": {
        "legacy": {
          "provider": "WebPage",
          "baseUrl": "https://raw.githubusercontent.com/EmuDeck/emudeck-we/main/functions/EmuScripts/emuDeckModel2.ps1",
          "assetPattern": "^(?<version>[0-9]+[.][0-9]+[a-z]?)[.]7z$",
          "checksumFile": "sha256:338c579a2ce9a9661cc6036999a76b19241140dadce42599a8c9e5fbe990fac3"
        }
      },
      "dataPolicy": {
        "prerequisites": [
          {
            "kind": "bios",
            "name": "Model 2 ROM set",
            "description": "Use your own Model 2 ZIP sets. The importer adds the game's containing directory to EMULATOR.INI. The legacy 32-bit emulator needs Microsoft's DirectX June 2010 runtime; use Install required runtimes for its required legacy DirectX DLLs. This is the exact legacy archive referenced by EmuDeck, not a new upstream release.",
            "extensions": [".zip"],
            "allowDirectory": true,
            "destination": "roms"
          }
        ]
      },
      "steamGridDbId": 5316480
    },

{
  "schemaVersion": 1,
  "tools": [
    {
      "id": "optiscaler",
      "name": "OptiScaler",
      "description": "Swaps a game's DLSS, FSR or XeSS upscaler for another one and can add frame generation. Open its in-game menu with the Insert key.",
      "homepage": "https://github.com/optiscaler/OptiScaler",
      "license": "GPL-3.0",
      "notice": "WSGM is not affiliated with OptiScaler. Report problems to WSGM.",
      "antiCheatWarning": "Do not use with online games. Anti-cheat may ban accounts.",
      "channels": [
        {
          "id": "stable",
          "label": "Stable",
          "description": "",
          "source": {
            "provider": "GitHub",
            "baseUrl": "https://api.github.com/",
            "repository": "optiscaler/OptiScaler",
            "assetPattern": "(?i)^optiscaler_.*[.]7z$",
            "channel": "stable",
            "packageType": "7z"
          }
        },
        {
          "id": "nightly",
          "label": "Nightly",
          "description": "Daily test builds of the next version; may be unstable",
          "source": {
            "provider": "GitHub",
            "baseUrl": "https://api.github.com/",
            "repository": "optiscaler/OptiScaler-nightly",
            "assetPattern": "(?i)^optiscaler_v.*[.]7z$",
            "channel": "prerelease",
            "packageType": "7z"
          },
          "versionPattern": "(?i)^optiscaler_v(?<version>[0-9]+(?:[.][0-9]+)*(?:-[a-z0-9.]+)?)_(?<build>[0-9]{8})[.]7z$"
        }
      ],
      "architectures": ["x64"],
      "primaryFile": "OptiScaler.dll",
      "identity": {
        "originalFilename": "OptiScaler.dll",
        "vetoTokens": ["reshade"],
        "otherTools": [
          {
            "token": "reshade",
            "name": "ReShade"
          },
          {
            "token": "special k",
            "name": "Special K"
          },
          {
            "token": "specialk",
            "name": "Special K"
          }
        ]
      },
      "proxy": {
        "default": "dxgi.dll",
        "options": [
          {
            "name": "dxgi.dll",
            "hint": "Most compatible. Try this first."
          },
          {
            "name": "winmm.dll",
            "hint": "Use for Vulkan games. Also worth trying for Xbox and Microsoft Store games."
          },
          {
            "name": "version.dll",
            "hint": "Often works better for Xbox and Microsoft Store games."
          },
          {
            "name": "dbghelp.dll",
            "hint": "An alternative when the others do not load."
          },
          {
            "name": "d3d12.dll",
            "hint": "Try this when DLSS crashes with the other names."
          },
          {
            "name": "wininet.dll",
            "hint": "An alternative when the others do not load."
          },
          {
            "name": "winhttp.dll",
            "hint": "An alternative when the others do not load."
          },
          {
            "name": "OptiScaler.asi",
            "hint": "Only with an ASI loader already installed in this game.",
            "suggest": false
          }
        ],
        "intro": "OptiScaler loads by taking the name of a Windows library the game loads. Try the first one first.",
        "renameIntro": "WSGM renames the installed file. Try another name when the game ignores OptiScaler or crashes.",
        "detectionNames": [
          "OptiScaler.asi",
          "OptiScaler.dll",
          "dxgi.dll",
          "winmm.dll",
          "d3d12.dll",
          "dbghelp.dll",
          "version.dll",
          "wininet.dll",
          "winhttp.dll"
        ],
        "detectionPatterns": ["*.dll", "*.asi", "plugins/*.dll"]
      },
      "payload": {
        "required": ["OptiScaler.dll", "OptiScaler.ini"],
        "familyDirectories": {
          "v10": ["OptiScaler"]
        },
        "exclude": ["setup_windows.bat", "setup_linux.sh", "!! *"],
        "neverExclude": [
          "OptiScaler.ini",
          "plugins/OptiPatcher.asi",
          "OptiScaler/plugins/OptiPatcher.asi"
        ]
      },
      "configFiles": ["OptiScaler.ini"],
      "replaceable": [
        "libxess*.dll",
        "libxell.dll",
        "amd_fidelityfx_*.dll",
        "fakenvapi.dll",
        "fakenvapi.ini",
        "dlssg_to_fsr3_amd_is_better.dll",
        "nvngx.dll",
        "nvapi64.dll",
        "D3D12_Optiscaler/*",
        "Licenses/*",
        "OptiScaler/*",
        "plugins/OptiPatcher.asi"
      ],
      "legacyFiles": [
        "OptiScaler.ini",
        "dxgi.ini",
        "nvngx.dll",
        "nvapi64.dll",
        "fakenvapi.*",
        "!! README*"
      ],
      "runtimeArtifacts": [
        "OptiScaler.log",
        "fakenvapi.log",
        "dlssg_to_fsr3.log",
        "OptiScaler/OptiScaler.log"
      ],
      "requiresUpscaler": [
        {
          "family": "dlss",
          "label": "DLSS"
        },
        {
          "family": "fsr",
          "label": "FSR"
        },
        {
          "family": "xess",
          "label": "XeSS"
        }
      ],
      "families": [
        {
          "id": "v09",
          "pattern": "^0[.]9([.]|$)"
        },
        {
          "id": "v10",
          "pattern": "^(0[.]10|10)([.]|$)"
        }
      ],
      "addons": [
        {
          "id": "optipatcher",
          "name": "OptiPatcher",
          "description": "An OptiScaler plugin that unlocks this game's DLSS and DLSS frame generation inputs without spoofing an NVIDIA graphics card, which saves the spoofing's overhead.",
          "homepage": "https://github.com/optiscaler/OptiPatcher",
          "license": "MIT",
          "source": {
            "provider": "GitHub",
            "baseUrl": "https://api.github.com/",
            "repository": "optiscaler/OptiPatcher",
            "assetPattern": "^OptiPatcher[.]asi$",
            "channel": "stable",
            "packageType": "asi"
          },
          "file": "plugins/OptiPatcher.asi",
          "configSection": "Plugins",
          "configKey": "LoadAsiPlugins",
          "configOn": "true",
          "configOff": "auto",
          "vendors": ["amd", "intel"],
          "vendorNotes": {
            "nvidia": "Not needed on NVIDIA graphics."
          },
          "supportUrl": "https://raw.githubusercontent.com/optiscaler/OptiPatcher/main/OptiPatcher/dllmain.cpp",
          "supportRules": [
            {
              "pattern": "CHECK_UE\\s*\\(\\s*([A-Za-z0-9_]+)\\s*\\)",
              "names": ["{0}-win64-shipping.exe", "{0}-wingdk-shipping.exe"]
            },
            {
              "pattern": "exeName\\s*==\\s*[\"']([^\"']+)[\"']",
              "names": ["{0}"]
            }
          ]
        }
      ],
      "settings": [
        {
          "id": "dlssInputs",
          "label": "DLSS inputs on AMD and Intel",
          "description": "Lets the game offer DLSS so OptiScaler can replace it. Turn off if the game misbehaves.",
          "section": "Spoofing",
          "key": "Dxgi",
          "default": "on",
          "options": [
            {
              "value": "on",
              "label": "Automatic",
              "ini": "auto"
            },
            {
              "value": "off",
              "label": "Off",
              "ini": "false"
            }
          ],
          "vendorNotes": {
            "nvidia": "Not needed on NVIDIA graphics."
          }
        },
        {
          "id": "menuScale",
          "label": "Menu scale",
          "description": "Size of OptiScaler's in-game menu. About 1.2 suits handheld screens.",
          "section": "Menu",
          "key": "Scale",
          "default": "auto",
          "options": [
            {
              "value": "auto",
              "label": "Automatic",
              "ini": "auto"
            },
            {
              "value": "0.8",
              "label": "0.8",
              "ini": "0.8"
            },
            {
              "value": "0.9",
              "label": "0.9",
              "ini": "0.9"
            },
            {
              "value": "1.0",
              "label": "1.0",
              "ini": "1.0"
            },
            {
              "value": "1.1",
              "label": "1.1",
              "ini": "1.1"
            },
            {
              "value": "1.2",
              "label": "1.2",
              "ini": "1.2"
            },
            {
              "value": "1.3",
              "label": "1.3",
              "ini": "1.3"
            },
            {
              "value": "1.4",
              "label": "1.4",
              "ini": "1.4"
            },
            {
              "value": "1.5",
              "label": "1.5",
              "ini": "1.5"
            },
            {
              "value": "1.6",
              "label": "1.6",
              "ini": "1.6"
            }
          ]
        },
        {
          "id": "hideSplash",
          "label": "Hide the startup message",
          "description": "Skips the message OptiScaler shows when the game starts.",
          "section": "Menu",
          "key": "DisableSplash",
          "default": "off",
          "options": [
            {
              "value": "off",
              "label": "Off",
              "ini": "auto"
            },
            {
              "value": "on",
              "label": "On",
              "ini": "true"
            }
          ]
        }
      ]
    },
    {
      "id": "dxvk",
      "name": "DXVK",
      "description": "Translates Direct3D 8, 9, 10 and 11 to Vulkan. Requires a Vulkan-capable GPU and driver; Windows game compatibility varies. Only the selected API and architecture are installed.",
      "homepage": "https://github.com/doitsujin/dxvk",
      "license": "Zlib",
      "notice": "Downloaded directly from the official publisher. No binaries are bundled with WSGM.",
      "antiCheatWarning": "Graphics injectors can be rejected by anti-cheat or result in an online account ban. Only install when the game permits modifications.",
      "channels": [
        {
          "id": "stable",
          "label": "Stable",
          "source": {
            "provider": "GitHub",
            "baseUrl": "https://api.github.com/",
            "repository": "doitsujin/dxvk",
            "assetPattern": "^dxvk-[0-9.]+[.]tar[.]gz$",
            "channel": "stable",
            "packageType": "tar.gz"
          }
        }
      ],
      "architectures": ["x86", "x64"],
      "primaryFile": "WSGM-tool.dll",
      "identity": {
        "originalFilename": "DXVK.dll",
        "productNames": ["DXVK"]
      },
      "proxy": {
        "default": "d3d11.dll"
      },
      "payload": {
        "required": ["WSGM-tool.dll"]
      },
      "configFiles": ["dxvk.conf"],
      "modes": [
        {
          "proxy": "d3d8.dll",
          "architectures": ["x86", "x64"],
          "files": {
            "x{bits}/d3d8.dll": "WSGM-tool.dll",
            "x{bits}/d3d9.dll": "d3d9.dll"
          },
          "apis": ["Direct3D 8"],
          "hint": "Choose the API the game actually uses."
        },
        {
          "proxy": "d3d9.dll",
          "architectures": ["x86", "x64"],
          "files": {
            "x{bits}/d3d9.dll": "WSGM-tool.dll"
          },
          "apis": ["Direct3D 9"],
          "hint": "Choose the API the game actually uses."
        },
        {
          "proxy": "d3d10core.dll",
          "architectures": ["x86", "x64"],
          "files": {
            "x{bits}/d3d10core.dll": "WSGM-tool.dll",
            "x{bits}/d3d11.dll": "d3d11.dll",
            "x{bits}/dxgi.dll": "dxgi.dll"
          },
          "apis": ["Direct3D 10"],
          "hint": "Choose the API the game actually uses."
        },
        {
          "proxy": "d3d11.dll",
          "architectures": ["x86", "x64"],
          "files": {
            "x{bits}/d3d11.dll": "WSGM-tool.dll",
            "x{bits}/dxgi.dll": "dxgi.dll"
          },
          "apis": ["Direct3D 11"],
          "hint": "Choose the API the game actually uses."
        }
      ]
    },

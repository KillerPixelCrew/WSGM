<!-- ControlTheme + state styles for the shared CardButton control (icon,
     title, description, trailing text): a MinHeight 44 card with a 2 px border
     that flips to the accent color on focus (the device-proven border-based
     focus visual — FocusAdorner stays null), plus the primary/danger style
     classes. Accent-family tokens are consumed via DynamicResource (runtime
     accent pipeline); everything else StaticResource. The state styles live at
     the Styles root (not inside the ControlTheme) so they carry regular style
     priority and can override the typography classes used by the template. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:WSGM.Controls">
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Themes/Palette.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <ControlTheme x:Key="{x:Type c:CardButton}" TargetType="c:CardButton">
                <Setter Property="Background" Value="{StaticResource HcCardBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource HcCardBorderBrush}" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Foreground" Value="{StaticResource HcTextPrimaryBrush}" />
                <Setter Property="FocusAdorner" Value="{x:Null}" />
                <Setter Property="Template">
                    <ControlTemplate TargetType="c:CardButton">
                        <Border Name="PART_Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <!-- Fixed 20x20 slot so every row's title starts at
                                     the same x, with the glyph CENTERED inside it:
                                     Avalonia scales a Uniform geometry and then
                                     aligns it top-left in the element box, so a
                                     Path sized 20x20 parks a wide-and-short icon
                                     against the top. MaxWidth/MaxHeight keep the
                                     same uniform scale as the old fixed size while
                                     letting the box hug the drawn glyph, which is
                                     what makes the alignments apply. -->
                                <Panel Width="20"
                                       Height="20"
                                       VerticalAlignment="Center"
                                       IsVisible="{TemplateBinding IconGeometry, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <Path Name="PART_Icon"
                                          MaxWidth="20"
                                          MaxHeight="20"
                                          Data="{TemplateBinding IconGeometry}"
                                          Stretch="Uniform"
                                          Stroke="{TemplateBinding Foreground}"
                                          StrokeThickness="1.8"
                                          StrokeLineCap="Round"
                                          StrokeJoin="Round"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                </Panel>
                                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                    <TextBlock Name="PART_Title"
                                               Classes="setting-title"
                                               Text="{TemplateBinding Title}" />
                                    <TextBlock Name="PART_Description"
                                               Classes="caption"
                                               Text="{TemplateBinding Description}"
                                               IsVisible="{TemplateBinding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            VerticalAlignment="Center">
                                    <Ellipse Name="PART_StatusDot"
                                             Width="10"
                                             Height="10"
                                             VerticalAlignment="Center"
                                             Fill="{TemplateBinding StatusBrush}"
                                             IsVisible="{TemplateBinding StatusBrush, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                    <Path Name="PART_Pin"
                                          Width="16"
                                          Height="16"
                                          Data="{x:Static c:Icons.Pin}"
                                          Stretch="Uniform"
                                          Stroke="{TemplateBinding Foreground}"
                                          StrokeThickness="1.8"
                                          StrokeLineCap="Round"
                                          StrokeJoin="Round"
                                          VerticalAlignment="Center"
                                          IsVisible="{TemplateBinding IsPinned}" />
                                    <!-- The device's own glyph when one resolved, otherwise the
                                         letter. Both bind the same trailing slot, and exactly one
                                         is visible, so a Claw shows its printed button and a
                                         machine with no glyph profile still shows something. -->
                                    <c:PhysicalGlyphImage Name="PART_TrailingGlyph"
                                                          Width="18"
                                                          Height="18"
                                                          VerticalAlignment="Center"
                                                          Foreground="{TemplateBinding Foreground}"
                                                          Plan="{TemplateBinding TrailingGlyph}"
                                                          IsVisible="{TemplateBinding TrailingGlyph, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                    <TextBlock Name="PART_Trailing"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Text="{TemplateBinding TrailingText}"
                                               IsVisible="{TemplateBinding ShowTrailingText}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter>
            </ControlTheme>
        </ResourceDictionary>
    </Styles.Resources>

    <!-- State styles set control-level properties so the TemplateBindings
         above propagate them (icon stroke and title follow Foreground).
         Declaration order is load-bearing: .primary comes after :pointerover
         so a hovered primary card keeps the accent background, and
         .primary:focus comes last so its primary-text border wins. -->
    <Style Selector="c|CardButton:pointerover">
        <Setter Property="Background" Value="{StaticResource HcCardHoverBrush}" />
    </Style>
    <Style Selector="c|CardButton:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource HcAccentBrush}" />
    </Style>
    <Style Selector="c|CardButton.primary">
        <Setter Property="Background" Value="{DynamicResource HcAccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HcAccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource HcOnAccentBrush}" />
    </Style>
    <Style Selector="c|CardButton.primary:focus">
        <Setter Property="BorderBrush" Value="{StaticResource HcTextPrimaryBrush}" />
    </Style>
    <Style Selector="c|CardButton.primary /template/ TextBlock#PART_Description">
        <Setter Property="Foreground" Value="{DynamicResource HcOnAccentCaptionBrush}" />
    </Style>
    <Style Selector="c|CardButton.danger /template/ TextBlock#PART_Title">
        <Setter Property="Foreground" Value="{StaticResource HcDangerBrush}" />
    </Style>
    <Style Selector="c|CardButton.danger /template/ Path#PART_Icon">
        <Setter Property="Stroke" Value="{StaticResource HcDangerBrush}" />
    </Style>
</Styles>

<!-- The Settings window's shell and the setting-row family shared by every Settings page. Included
     last at application level so these rules keep overriding the shared control and text styles; the
     overlay does not use these class names. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Themes/Palette.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- The window: a rail on the darker surface, pages on the header surface. -->
  <Style Selector="Border.settings-rail">
    <Setter Property="Background" Value="{StaticResource HcBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource HcCardBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
  </Style>
  <Style Selector="TextBlock.settings-rail-title">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Margin" Value="24,22,24,14" />
  </Style>
  <Style Selector="Button.settings-rail-item">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.settings-rail-item.selected">
    <Setter Property="Background" Value="{StaticResource HcCardBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource HcAccentBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.settings-page-title">
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="StackPanel.settings-page">
    <Setter Property="Margin" Value="28,0,28,20" />
  </Style>

  <!-- Search suggestions float over the rail and the page. -->
  <Style Selector="Border.settings-search-results">
    <Setter Property="Background" Value="{StaticResource HcBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource HcControlBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="BoxShadow" Value="0 8 24 0 #80000000" />
  </Style>
  <Style Selector="Button.settings-search-row">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <!-- A status chip beside a row's editor; good and attention give it a tone. -->
  <Style Selector="Border.settings-chip">
    <Setter Property="Background" Value="{StaticResource HcBadgeBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource HcBadgeBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="9,2" />
  </Style>
  <Style Selector="Border.settings-chip TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource HcTextSecondaryBrush}" />
  </Style>
  <Style Selector="Border.settings-chip.good">
    <Setter Property="Background" Value="{StaticResource HcBadgeGoodBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource HcBadgeGoodBorderBrush}" />
  </Style>
  <Style Selector="Border.settings-chip.good TextBlock">
    <Setter Property="Foreground" Value="{StaticResource HcSuccessBrush}" />
  </Style>
  <Style Selector="Border.settings-chip.attention">
    <Setter Property="Background" Value="{StaticResource HcBadgeWarnBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource HcBadgeWarnBorderBrush}" />
  </Style>
  <Style Selector="Border.settings-chip.attention TextBlock">
    <Setter Property="Foreground" Value="{StaticResource HcWarningBrush}" />
  </Style>

  <!-- A key or button of a shortcut. -->
  <Style Selector="Border.settings-keycap">
    <Setter Property="Background" Value="{StaticResource HcControlBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource HcControlBorderBrush}" />
    <Setter Property="BorderThickness" Value="1,1,1,3" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="MinWidth" Value="30" />
  </Style>
  <Style Selector="Border.settings-keycap TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <!-- A numbered step of written instructions. -->
  <Style Selector="Border.settings-step">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Background" Value="{StaticResource HcControlBrush}" />
  </Style>
  <Style Selector="Border.settings-step TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- A card that holds more than one row's worth: instructions, a list, a summary of the handheld. -->
  <Style Selector="Border.settings-card, Border.settings-hero">
    <Setter Property="Background" Value="{StaticResource HcCardBrush}" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>
  <Style Selector="Border.settings-hero">
    <Setter Property="Margin" Value="0,4,0,4" />
    <Setter Property="Padding" Value="16,14" />
  </Style>

  <Style Selector="Border.section-header">
    <Setter Property="Margin" Value="2,16,0,6" />
  </Style>
  <Style Selector="Border.section-header TextBlock">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Border.section-header TextBlock.caption">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>

  <!-- One row style: title and one line of help on the left, the editor on the right. -->
  <Style Selector="Border.setting-row">
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="Margin" Value="0,0,0,4" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Background" Value="{StaticResource HcCardBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <!-- A changed row carries an accent edge until it is saved. -->
  <Style Selector="Border.setting-row.pending">
    <Setter Property="BoxShadow" Value="inset 4 0 0 0 #FFFF9D3D" />
  </Style>
  <!-- Save with nothing to write keeps its place and focus but steps back from the primary look. -->
  <Style Selector="Button.primary.settings-save-idle">
    <Setter Property="Background" Value="{StaticResource HcControlBrush}" />
    <Setter Property="Foreground" Value="{StaticResource HcTextMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.caption.settings-unsaved">
    <Setter Property="Foreground" Value="{DynamicResource HcAccentBrush}" />
  </Style>
  <Style Selector="Border.setting-row:focus-within">
    <Setter Property="BorderBrush" Value="{DynamicResource HcAccentBrush}" />
  </Style>
  <Style Selector="Border.setting-row TextBlock.setting-title">
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style Selector="Border.setting-row Button">
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="12,2" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="Border.setting-row TextBox, Border.setting-row ComboBox, Border.setting-row NumericUpDown">
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="Border.setting-row ToggleSwitch, Border.setting-row CheckBox">
    <Setter Property="FontSize" Value="13" />
  </Style>

  <!-- A card of rows sharing column headings, like the overlay widget table. -->
  <Style Selector="Border.settings-table">
    <Setter Property="Padding" Value="0,10,0,6" />
  </Style>
  <Style Selector="TextBlock.settings-column">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource HcTextSecondaryBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.setting-row.settings-table-row">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Padding" Value="12,2" />
  </Style>
  <!-- A picked-up row, which Up and Down move. -->
  <Style Selector="Border.setting-row.settings-table-row.moving">
    <Setter Property="Background" Value="{StaticResource HcCardHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HcAccentBrush}" />
  </Style>
  <!-- Tabs over a page's sub-panels (the splash's Text, Colours and Images): a label with an accent underline. -->
  <Style Selector="RadioButton.settings-tab">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="TabBorder" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent"
                Padding="14,6" CornerRadius="0">
          <ContentPresenter Content="{TemplateBinding Content}" FontSize="14" FontWeight="SemiBold"
                            Foreground="{StaticResource HcTextSecondaryBrush}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.settings-tab:checked /template/ Border#TabBorder">
    <Setter Property="BorderBrush" Value="{DynamicResource HcAccentBrush}" />
  </Style>
  <Style Selector="RadioButton.settings-tab:checked /template/ ContentPresenter">
    <Setter Property="Foreground" Value="{StaticResource HcTextPrimaryBrush}" />
  </Style>
  <Style Selector="RadioButton.settings-tab:pointerover /template/ Border#TabBorder">
    <Setter Property="Background" Value="{StaticResource HcCardBrush}" />
  </Style>
  <Style Selector="RadioButton.settings-tab:focus-visible /template/ Border#TabBorder">
    <Setter Property="Background" Value="{StaticResource HcCardHoverBrush}" />
  </Style>

  <!-- A list of items to pick one of, like the device profiles beside their editor. -->
  <Style Selector="ListBox.settings-list">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ListBox.settings-list ListBoxItem">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Margin" Value="0,0,0,4" />
    <Setter Property="Background" Value="{StaticResource HcCardBrush}" />
  </Style>

  <!-- An icon button that opens a web page or more actions for its row. -->
  <Style Selector="Button.settings-link, Button.settings-more">
    <Setter Property="MinWidth" Value="40" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.settings-link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.settings-grip">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="4,6" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Cursor" Value="SizeNorthSouth" />
  </Style>

  <!-- A caption that reports a failure where it happened. -->
  <Style Selector="TextBlock.caption.problem">
    <Setter Property="Foreground" Value="{StaticResource HcDangerBrush}" />
  </Style>
</Styles>

<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:WSGM.Controls" xmlns:fa="using:FluentAvalonia.UI.Controls">
  <Styles.Resources>
    <SolidColorBrush x:Key="DeckGlassCanvasBrush" Color="#BE171A1F" />
    <SolidColorBrush x:Key="DeckCanvasBrush" Color="#171A1F" />
    <SolidColorBrush x:Key="DeckRailBrush" Color="#E01C2026" />
    <SolidColorBrush x:Key="DeckControlsBrush" Color="#EB191F27" />
    <SolidColorBrush x:Key="DeckGroupBrush" Color="#F02B333F" />
    <SolidColorBrush x:Key="DeckGroupBorderBrush" Color="#526074" />
    <SolidColorBrush x:Key="DeckSurfaceBrush" Color="#303741" />
    <SolidColorBrush x:Key="DeckDividerBrush" Color="#414751" />
    <SolidColorBrush x:Key="DeckTextBrush" Color="#F4F5F7" />
    <SolidColorBrush x:Key="DeckSecondaryBrush" Color="#BEC3CC" />
    <SolidColorBrush x:Key="DeckHoverBrush" Color="#363D47" />
    <SolidColorBrush x:Key="DeckPressedBrush" Color="#454D59" />
    <x:Double x:Key="DeckContentMaxWidth">1600</x:Double>
    <CornerRadius x:Key="DeckControlRadius">4</CornerRadius>
    <CornerRadius x:Key="DeckGroupRadius">6</CornerRadius>
  </Styles.Resources>

  <Style Selector="Button.deck-action">
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="CornerRadius" Value="{StaticResource DeckControlRadius}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Background" Value="{StaticResource DeckGroupBrush}" />
  </Style>
  <Style Selector="Button.deck-action:pointerover">
    <Setter Property="Background" Value="{StaticResource DeckHoverBrush}" />
  </Style>
  <Style Selector="Button.deck-action:pressed">
    <Setter Property="Background" Value="{StaticResource DeckPressedBrush}" />
  </Style>
  <Style Selector="Button.deck-action:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource HcAccentBrush}" />
    <Setter Property="Background" Value="{StaticResource DeckHoverBrush}" />
  </Style>
  <Style Selector="Button.deck-action.primary">
    <Setter Property="Background" Value="{DynamicResource HcAccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource HcOnAccentBrush}" />
  </Style>
  <Style Selector="Button.deck-action.primary TextBlock.caption">
    <Setter Property="Foreground" Value="{DynamicResource HcOnAccentCaptionBrush}" />
  </Style>
  <Style Selector="Button.deck-action.primary:focus-visible">
    <Setter Property="BorderBrush" Value="{StaticResource DeckTextBrush}" />
  </Style>
  <Style Selector="Button.deck-action.danger">
    <Setter Property="Foreground" Value="{StaticResource HcDangerBrush}" />
  </Style>
  <Style Selector="Button.deck-action:disabled">
    <Setter Property="Opacity" Value="0.5" />
  </Style>
  <Style Selector="Window.command-deck">
    <Setter Property="Foreground" Value="{StaticResource DeckTextBrush}" />
  </Style>
  <Style Selector="Window.command-deck.compact Border.header-detail">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="Window.command-deck Button">
    <Setter Property="CornerRadius" Value="{StaticResource DeckControlRadius}" />
    <Setter Property="MinHeight" Value="44" />
  </Style>
  <Style Selector="Window.command-deck ComboBox, Window.command-deck ToggleSwitch">
    <Setter Property="MinHeight" Value="44" />
  </Style>
  <Style Selector="Window.command-deck fa|FASettingsExpanderItem">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsClickEnabled" Value="False" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border BorderBrush="{StaticResource DeckDividerBrush}" BorderThickness="0,0,0,1" Padding="0,8">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" MinHeight="48">
            <StackPanel VerticalAlignment="Center" Spacing="4">
              <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
              <TextBlock Text="{TemplateBinding Description}" Foreground="{StaticResource DeckSecondaryBrush}"
                         FontSize="13" LineHeight="19" TextWrapping="Wrap" />
            </StackPanel>
            <ContentPresenter Grid.Column="1" Content="{TemplateBinding Footer}" VerticalAlignment="Center" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Window.command-deck fa|FASettingsExpanderItem.device-setting-primary">
    <Setter Property="Template">
      <ControlTemplate>
        <Border BorderBrush="{StaticResource DeckDividerBrush}" BorderThickness="0,0,0,1" Padding="0,8">
          <ContentPresenter Content="{TemplateBinding Footer}" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Window.command-deck :is(Border).tile">
    <Setter Property="CornerRadius" Value="{StaticResource DeckControlRadius}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0,8" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Window.command-deck TextBlock.caption">
    <Setter Property="Foreground" Value="{StaticResource DeckSecondaryBrush}" />
  </Style>
  <Style Selector="Window.command-deck Button.primary TextBlock.caption">
    <Setter Property="Foreground" Value="{DynamicResource HcOnAccentCaptionBrush}" />
  </Style>
  <Style Selector="Window.command-deck Border.device-group">
    <Setter Property="Background" Value="{StaticResource DeckGroupBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource DeckGroupRadius}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{StaticResource DeckGroupBorderBrush}" />
    <Setter Property="Padding" Value="16" />
  </Style>
  <Style Selector="Window.command-deck Border.section-divider">
    <Setter Property="Background" Value="{StaticResource DeckGroupBorderBrush}" />
  </Style>
  <Style Selector="ScrollViewer#ContentScroller TextBlock.caption">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="LineHeight" Value="19" />
  </Style>
  <Style Selector="ScrollViewer#ContentScroller TextBlock.eyebrow">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource DeckTextBrush}" />
    <Setter Property="Margin" Value="0,0,0,12" />
  </Style>
  <Style Selector="Button.deck-section">
    <Setter Property="Height" Value="48" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="{StaticResource DeckControlRadius}" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
  </Style>
  <Style Selector="Button.deck-section:pointerover">
    <Setter Property="Background" Value="{StaticResource DeckHoverBrush}" />
  </Style>
  <Style Selector="Button.deck-section.selected">
    <Setter Property="Background" Value="{StaticResource DeckGroupBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource HcAccentBrush}" />
  </Style>
  <Style Selector="Button.deck-section Border.selection-rule">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.deck-section.selected Border.selection-rule">
    <Setter Property="Background" Value="{DynamicResource HcAccentBrush}" />
  </Style>
  <Style Selector="Button.deck-section:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource HcAccentBrush}" />
    <Setter Property="Background" Value="{StaticResource DeckHoverBrush}" />
  </Style>
  <Style Selector="Button.deck-section:pressed">
    <Setter Property="Background" Value="{StaticResource DeckPressedBrush}" />
  </Style>
</Styles>

<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:WSGM.Controls" xmlns:cv="using:Avalonia.Data.Converters" xmlns:fa="using:FluentAvalonia.UI.Controls"
        xmlns:ov="using:WSGM.Overlay">
  <Styles.Resources>
    <!-- The Open apps strip's items, shared by the sheet's rail and the Game Mode taskbar. Their
         presses are routed by OpenAppsStrip from the strip's scrollers, so the templates carry no
         handlers. A chip keeps a fixed height and its place as windows come and go. -->
    <DataTemplate x:Key="DeckAppChipTemplate" x:DataType="ov:AppSwitcherEntry">
      <Button Classes="app-chip"
              Classes.active="{Binding IsActive}"
              Classes.minimized="{Binding IsMinimized}"
              AutomationProperties.Name="{Binding Title}"
              ToolTip.Tip="{Binding Title}">
        <Panel>
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Panel Width="18" Height="18" VerticalAlignment="Center">
              <Image Source="{Binding Icon}" Width="18" Height="18" />
              <!-- Fallback glyph when no icon could be resolved. -->
              <TextBlock Text="▢" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                         IsVisible="{Binding HasNoIcon}" />
            </Panel>
            <TextBlock Classes="app-chip-title" Text="{Binding Title}" />
          </StackPanel>
          <Border Classes="active-indicator" Height="3" CornerRadius="1.5" VerticalAlignment="Bottom"
                  Margin="0,0,0,-4" />
        </Panel>
      </Button>
    </DataTemplate>
    <DataTemplate x:Key="DeckTrayIconTemplate" x:DataType="ov:TrayIconEntry">
      <Button Classes="pill tray"
              AutomationProperties.Name="{Binding Tip}"
              ToolTip.Tip="{Binding Tip}">
        <Image Source="{Binding Image}" Width="18" Height="18" />
      </Button>
    </DataTemplate>

    <!-- One native window backdrop; nested surfaces add tint, never another blur pass. -->
    <SolidColorBrush x:Key="DeckGlassCanvasBrush" Color="#80171A1F" />
    <SolidColorBrush x:Key="DeckCanvasBrush" Color="#171A1F" />
    <SolidColorBrush x:Key="DeckRailBrush" Color="#481C2026" />
    <SolidColorBrush x:Key="DeckControlsBrush" Color="#30191F27" />
    <SolidColorBrush x:Key="DeckGroupBrush" Color="#602B333F" />
    <SolidColorBrush x:Key="DeckGroupBorderBrush" Color="#607E8B9E" />
    <!-- Separate popup windows need a readable solid surface of their own. -->
    <SolidColorBrush x:Key="DeckSurfaceBrush" Color="#303741" />
    <SolidColorBrush x:Key="DeckDividerBrush" Color="#414751" />
    <SolidColorBrush x:Key="DeckTextBrush" Color="#F4F5F7" />
    <SolidColorBrush x:Key="DeckSecondaryBrush" Color="#BEC3CC" />
    <SolidColorBrush x:Key="DeckHoverBrush" Color="#363D47" />
    <SolidColorBrush x:Key="DeckPressedBrush" Color="#454D59" />
    <!-- Dims the game behind the Game Mode taskbar; the dimmed area is the tap-to-close target. -->
    <SolidColorBrush x:Key="DeckScrimBrush" Color="#59000000" />
    <x:Double x:Key="DeckContentMaxWidth">1600</x:Double>
    <x:Double x:Key="DeckControlHeight">36</x:Double>
    <x:Double x:Key="DeckActionHeight">44</x:Double>
    <x:Double x:Key="DeckRowGap">8</x:Double>
    <x:Double x:Key="DeckSectionGap">12</x:Double>
    <Thickness x:Key="DeckControlPadding">10,4</Thickness>
    <!-- Fluent reserves a separate 32-DIP arrow column. Do not reserve it twice. -->
    <Thickness x:Key="DeckSelectorPadding">10,4,0,4</Thickness>
    <Thickness x:Key="DeckGroupPadding">12</Thickness>
    <Thickness x:Key="DeckPanePadding">12</Thickness>
    <Thickness x:Key="DeckWorkspaceMargin">16,12</Thickness>
    <CornerRadius x:Key="DeckControlRadius">4</CornerRadius>
    <CornerRadius x:Key="DeckGroupRadius">6</CornerRadius>
  </Styles.Resources>

  <Style Selector="Button.deck-action">
    <Setter Property="MinHeight" Value="{StaticResource DeckActionHeight}" />
    <Setter Property="Padding" Value="{StaticResource DeckControlPadding}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="CornerRadius" Value="{StaticResource DeckControlRadius}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Background" Value="{StaticResource DeckGroupBrush}" />
  </Style>
  <!-- A row that is the body of a card: no fill of its own at rest, the card's hover and focus when used. -->
  <Style Selector="Button.deck-action.flat">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.deck-action.section-pin">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="8" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.deck-action.section-pin.pinned">
    <Setter Property="Foreground" Value="{DynamicResource HcAccentBrush}" />
  </Style>
  <Style Selector="Button.deck-action:pointerover">
    <Setter Property="Background" Value="{StaticResource DeckHoverBrush}" />
  </Style>
  <Style Selector="Button.deck-action:pressed">
    <Setter Property="Background" Value="{StaticResource DeckPressedBrush}" />
  </Style>
  <Style Selector="Button.deck-action:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource HcAccentBrush}" />
    <Setter Property="Background" Value="{StaticResource DeckHoverBrush}" />
  </Style>
  <Style Selector="Button.deck-action.primary">
    <Setter Property="Background" Value="{DynamicResource HcAccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource HcOnAccentBrush}" />
  </Style>
  <Style Selector="Button.deck-action.primary TextBlock.caption">
    <Setter Property="Foreground" Value="{DynamicResource HcOnAccentCaptionBrush}" />
  </Style>
  <Style Selector="Button.deck-action.primary:focus-visible">
    <Setter Property="BorderBrush" Value="{StaticResource DeckTextBrush}" />
  </Style>
  <Style Selector="Button.deck-action.danger">
    <Setter Property="Foreground" Value="{StaticResource HcDangerBrush}" />
  </Style>
  <Style Selector="Button.deck-action:disabled">
    <Setter Property="Opacity" Value="0.5" />
  </Style>
  <!-- A page's view switcher (OverlaySubView.ViewTabs): segments on an inset track, the selected one filled. -->
  <Style Selector="Border.deck-segments">
    <Setter Property="Background" Value="{StaticResource DeckGroupBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource DeckGroupBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource DeckGroupRadius}" />
    <Setter Property="Padding" Value="3" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector="Button.deck-action.segment">
    <Setter Property="MinHeight" Value="{StaticResource DeckControlHeight}" />
    <Setter Property="Padding" Value="12,2" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource DeckSecondaryBrush}" />
  </Style>
  <Style Selector="Button.deck-action.segment:pointerover">
    <Setter Property="Background" Value="{StaticResource DeckHoverBrush}" />
  </Style>
  <Style Selector="Button.deck-action.segment.selected">
    <Setter Property="Background" Value="{StaticResource DeckPressedBrush}" />
    <Setter Property="Foreground" Value="{StaticResource DeckTextBrush}" />
  </Style>
  <Style Selector="Button.deck-action.segment:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource HcAccentBrush}" />
  </Style>
  <Style Selector="Window.command-deck">
    <Setter Property="Foreground" Value="{StaticResource DeckTextBrush}" />
  </Style>
  <Style Selector="Window.command-deck.compact Border.header-detail">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="Window.command-deck Button">
    <Setter Property="CornerRadius" Value="{StaticResource DeckControlRadius}" />
    <Setter Property="MinHeight" Value="{StaticResource DeckActionHeight}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Window.command-deck TextBox, Window.command-deck NumericUpDown">
    <Setter Property="Background" Value="{StaticResource DeckControlsBrush}" />
    <Setter Property="Foreground" Value="{StaticResource DeckTextBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource DeckGroupBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource DeckControlRadius}" />
    <Setter Property="MinHeight" Value="{StaticResource DeckControlHeight}" />
    <Setter Property="Padding" Value="{StaticResource DeckControlPadding}" />
  </Style>
  <Style Selector="Window.command-deck TextBox">
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Window.command-deck ComboBox">
    <Setter Property="MinHeight" Value="{StaticResource DeckControlHeight}" />
    <Setter Property="Padding" Value="{StaticResource DeckSelectorPadding}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Background" Value="{StaticResource DeckSurfaceBrush}" />
    <Setter Property="Foreground" Value="{StaticResource DeckTextBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource DeckGroupBorderBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="{StaticResource DeckControlRadius}" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
  </Style>
  <Style Selector="Window.command-deck ComboBox:pointerover /template/ Border#Background">
    <Setter Property="Background" Value="{StaticResource DeckHoverBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource DeckGroupBorderBrush}" />
  </Style>
  <Style Selector="Window.command-deck ComboBox:pressed /template/ Border#Background">
    <Setter Property="Background" Value="{StaticResource DeckPressedBrush}" />
  </Style>
  <Style Selector="Window.command-deck ComboBox:focus-visible /template/ Border#Background">
    <Setter Property="BorderBrush" Value="{DynamicResource HcAccentBrush}" />
  </Style>
  <Style Selector="Window.command-deck ComboBox:focus-visible /template/ Border#HighlightBackground">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="Window.command-deck ComboBox /template/ Border#PopupBorder">
    <Setter Property="Background" Value="{StaticResource DeckSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource DeckGroupBorderBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource DeckControlRadius}" />
  </Style>
  <Style Selector="Window.command-deck ComboBoxItem">
    <Setter Property="MinHeight" Value="{StaticResource DeckControlHeight}" />
    <Setter Property="Padding" Value="{StaticResource DeckControlPadding}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{StaticResource DeckTextBrush}" />
  </Style>
  <Style Selector="Window.command-deck ComboBox:disabled /template/ Border#Background">
    <Setter Property="Background" Value="{StaticResource DeckSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource DeckDividerBrush}" />
  </Style>
  <Style Selector="Window.command-deck ComboBoxItem:pointerover /template/ Border#LayoutRoot, Window.command-deck ComboBoxItem:selected /template/ Border#LayoutRoot">
    <Setter Property="Background" Value="{StaticResource DeckHoverBrush}" />
  </Style>
  <Style Selector="Window.command-deck ComboBoxItem:pressed /template/ Border#LayoutRoot">
    <Setter Property="Background" Value="{StaticResource DeckPressedBrush}" />
  </Style>
  <Style Selector="Window.command-deck ToggleSwitch">
    <Setter Property="MinHeight" Value="{StaticResource DeckControlHeight}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Window.command-deck fa|FASettingsExpanderItem">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsClickEnabled" Value="False" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border BorderBrush="{StaticResource DeckDividerBrush}" BorderThickness="0,0,0,1" Padding="0,4">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource DeckSectionGap}" MinHeight="{StaticResource DeckControlHeight}">
            <StackPanel VerticalAlignment="Center" Spacing="2">
              <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
              <TextBlock IsVisible="{Binding Description, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static cv:StringConverters.IsNotNullOrEmpty}}" Text="{TemplateBinding Description}" Foreground="{StaticResource DeckSecondaryBrush}"
                         FontSize="13" LineHeight="19" TextWrapping="Wrap" />
            </StackPanel>
            <ContentPresenter Grid.Column="1" Content="{TemplateBinding Footer}" VerticalAlignment="Center" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Window.command-deck fa|FASettingsExpanderItem.device-setting-primary">
    <Setter Property="Template">
      <ControlTemplate>
        <Border BorderBrush="{StaticResource DeckDividerBrush}" BorderThickness="0,0,0,1" Padding="0,4">
          <ContentPresenter Content="{TemplateBinding Footer}" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Window.command-deck :is(Border).tile">
    <Setter Property="CornerRadius" Value="{StaticResource DeckControlRadius}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0,4" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Window.command-deck TextBlock.caption">
    <Setter Property="Foreground" Value="{StaticResource DeckSecondaryBrush}" />
  </Style>
  <!-- A sub-view's progress or usage bar: accent fill on the deck surface, 6 DIP like Steam's meter. -->
  <Style Selector="Window.command-deck ProgressBar.overlay-progress">
    <Setter Property="MinHeight" Value="6" />
    <Setter Property="Height" Value="6" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Foreground" Value="{DynamicResource HcAccentBrush}" />
    <Setter Property="Background" Value="{StaticResource DeckSurfaceBrush}" />
  </Style>
  <Style Selector="Window.command-deck Button.primary TextBlock.caption">
    <Setter Property="Foreground" Value="{DynamicResource HcOnAccentCaptionBrush}" />
  </Style>
  <Style Selector="Window.command-deck Border.device-group">
    <Setter Property="Background" Value="{StaticResource DeckGroupBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource DeckGroupRadius}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{StaticResource DeckGroupBorderBrush}" />
    <Setter Property="Padding" Value="{StaticResource DeckGroupPadding}" />
  </Style>
  <!-- One key of a hotkey (Overlay Keycaps): a raised cap with the key's name; "large" in the editor. -->
  <Style Selector="Window.command-deck Border.keycap">
    <Setter Property="Background" Value="{StaticResource DeckSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource DeckGroupBorderBrush}" />
    <Setter Property="BorderThickness" Value="1,1,1,2" />
    <Setter Property="CornerRadius" Value="{StaticResource DeckControlRadius}" />
    <Setter Property="Padding" Value="7,1" />
    <Setter Property="MinWidth" Value="26" />
    <Setter Property="MinHeight" Value="24" />
  </Style>
  <Style Selector="Window.command-deck Border.keycap > TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource DeckTextBrush}" />
  </Style>
  <Style Selector="Window.command-deck Border.keycap.large">
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="MinWidth" Value="36" />
    <Setter Property="MinHeight" Value="34" />
  </Style>
  <Style Selector="Window.command-deck Border.keycap.large > TextBlock">
    <Setter Property="FontSize" Value="15" />
  </Style>
  <Style Selector="Window.command-deck TextBlock.keycap-joiner">
    <Setter Property="Foreground" Value="{StaticResource DeckSecondaryBrush}" />
  </Style>
  <!-- The hotkey capture field: a card that takes focus, with the deck's accent focus border. -->
  <Style Selector="Window.command-deck Border.device-group.hotkey-capture">
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="Window.command-deck Border.device-group.hotkey-capture:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource HcAccentBrush}" />
  </Style>
  <!-- A row the running game's own profile supplies: accent bar and a "Game override" line. -->
  <Style Selector="Border.profile-override-bar">
    <Setter Property="Width" Value="3" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Background" Value="{DynamicResource HcAccentBrush}" />
  </Style>
  <Style Selector="TextBlock.profile-override-label">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource HcAccentBrush}" />
  </Style>
  <Style Selector="Button.profile-override-reset">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="CornerRadius" Value="{StaticResource DeckControlRadius}" />
  </Style>
  <Style Selector="Window.command-deck Border.section-divider">
    <Setter Property="Background" Value="{StaticResource DeckGroupBorderBrush}" />
  </Style>
  <Style Selector="ScrollViewer#ContentScroller TextBlock.caption">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="LineHeight" Value="19" />
  </Style>
  <Style Selector="ScrollViewer#ContentScroller TextBlock.eyebrow">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource DeckTextBrush}" />
    <Setter Property="Margin" Value="0,0,0,12" />
  </Style>
  <Style Selector="Button.deck-section">
    <Setter Property="Height" Value="48" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="{StaticResource DeckControlRadius}" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
  </Style>
  <Style Selector="Button.deck-section:pointerover">
    <Setter Property="Background" Value="{StaticResource DeckHoverBrush}" />
  </Style>
  <Style Selector="Button.deck-section.selected">
    <Setter Property="Background" Value="{StaticResource DeckGroupBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource HcAccentBrush}" />
  </Style>
  <Style Selector="Button.deck-section Border.selection-rule">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.deck-section.selected Border.selection-rule">
    <Setter Property="Background" Value="{DynamicResource HcAccentBrush}" />
  </Style>
  <Style Selector="Button.deck-section:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource HcAccentBrush}" />
    <Setter Property="Background" Value="{StaticResource DeckHoverBrush}" />
  </Style>
  <Style Selector="Button.deck-section:pressed">
    <Setter Property="Background" Value="{StaticResource DeckPressedBrush}" />
  </Style>
  <!-- Deck chrome shared by the Quick access sheet and the Game Mode taskbar: header and tray
       pills, Open apps chips and stroke status icons. Scoped to command-deck windows. -->
  <!-- Header status pills: compact rounded buttons. The local BorderBrush
           wins the equal-specificity tie against Shared.axaml's Button:focus-visible, so
           the accent focus border is restated here (same workaround as
           TabStripTheme); otherwise a focused pill would have no cue. -->
  <Style Selector="Window.command-deck Button.pill">
    <Setter Property="MinWidth" Value="44" />
    <Setter Property="Height" Value="44" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="Background" Value="{StaticResource DeckGroupBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource HcCardBorderBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Window.command-deck Button.pill:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource HcAccentBrush}" />
  </Style>
  <Style Selector="Window.command-deck Button.pill:pointerover">
    <Setter Property="Background" Value="{StaticResource DeckHoverBrush}" />
  </Style>
  <Style Selector="Window.command-deck Button.pill.tray">
    <Setter Property="MinWidth" Value="44" />
    <Setter Property="Padding" Value="4,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Window.command-deck Button.pill.tray:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource HcAccentBrush}" />
  </Style>
  <Style Selector="Window.command-deck Button.pill.close">
    <Setter Property="Foreground" Value="{StaticResource HcTextMutedBrush}" />
    <Setter Property="FontSize" Value="16" />
  </Style>
  <Style Selector="Window.command-deck Button.pill.close:focus-visible">
    <Setter Property="Foreground" Value="{StaticResource HcTextPrimaryBrush}" />
  </Style>
  <!-- Read-only pills (battery, clock) share the shape without a focus stop. -->
  <Style Selector="Window.command-deck Border.pill-static">
    <Setter Property="Height" Value="44" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Background" Value="{StaticResource DeckGroupBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource HcCardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <!-- Stroke-rendered like the TabStrip icons: the Icons geometries are
           stroke-style, filling them collapses interior detail. -->
  <Style Selector="Window.command-deck Path.status-icon">
    <Setter Property="Fill" Value="{x:Null}" />
    <Setter Property="Stroke" Value="{StaticResource HcTextMutedBrush}" />
    <Setter Property="StrokeThickness" Value="1.5" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="StrokeLineCap" Value="Round" />
  </Style>

  <!-- Open apps chips: fixed 40 px height, card background, accent
           underline when the window is foreground, dimmed when minimized. -->
  <Style Selector="Window.command-deck Button.app-chip">
    <Setter Property="Height" Value="48" />
    <Setter Property="Padding" Value="10,0,12,0" />
    <Setter Property="Background" Value="{StaticResource DeckGroupBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Window.command-deck Button.app-chip:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource HcAccentBrush}" />
  </Style>
  <Style Selector="Window.command-deck Button.app-chip:pointerover">
    <Setter Property="Background" Value="{StaticResource DeckHoverBrush}" />
  </Style>
  <Style Selector="Window.command-deck Button.app-chip.minimized Image">
    <Setter Property="Opacity" Value="0.5" />
  </Style>
  <Style Selector="Window.command-deck Button.app-chip.minimized TextBlock">
    <Setter Property="Opacity" Value="0.5" />
  </Style>
  <Style Selector="Window.command-deck Button.app-chip Border.active-indicator">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Window.command-deck Button.app-chip.active Border.active-indicator">
    <Setter Property="Background" Value="{DynamicResource HcAccentBrush}" />
  </Style>
  <Style Selector="Window.command-deck TextBlock.app-chip-title">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="MaxWidth" Value="150" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Game Mode taskbar: Start matches the chips' height, and a chip's Close sits beside it as
       a quiet pill of the same height. -->
  <Style Selector="Window.command-deck Button.pill.start">
    <Setter Property="Height" Value="48" />
    <Setter Property="Padding" Value="12,0,14,0" />
  </Style>
  <Style Selector="Window.command-deck Button.pill.start.open">
    <Setter Property="Background" Value="{StaticResource DeckPressedBrush}" />
  </Style>
  <Style Selector="Window.command-deck Button.pill.window-close">
    <Setter Property="MinWidth" Value="32" />
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="48" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Window.command-deck Button.pill.window-close:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource HcAccentBrush}" />
  </Style>
  <Style Selector="Window.command-deck Button.pill.window-close:pointerover">
    <Setter Property="Background" Value="{StaticResource DeckHoverBrush}" />
  </Style>
</Styles>

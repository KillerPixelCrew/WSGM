<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:WSGM.Controls"
        x:Class="WSGM.Overlay.KeyboardPanel"
        Background="{StaticResource DeckSurfaceBrush}">

  <Grid>
    <Border BorderBrush="{StaticResource DeckDividerBrush}" BorderThickness="1" Padding="4">
      <StackPanel Spacing="4" HorizontalAlignment="Stretch">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="4" MinHeight="44">
          <TextBlock x:Name="PromptText" FontSize="12" MaxWidth="160" Margin="6,0"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          <TextBox x:Name="Input" Grid.Column="1" FontSize="18" MinHeight="44" Padding="8,4"
                   ClearSelectionOnLostFocus="False"
                   IsInactiveSelectionHighlightEnabled="True" />
          <Button x:Name="RevealButton" Grid.Column="2" Content="Show" MinHeight="44"
                  Click="OnReveal" IsVisible="False" />
          <Button x:Name="AcceptButton" Grid.Column="3" Classes="primary" Content="Done ↵"
                  MinHeight="44" Click="OnAccept" />
          <Button Grid.Column="4" Content="⌄" MinHeight="44" MinWidth="44" Click="OnCancel"
                  AutomationProperties.Name="Cancel text entry" ToolTip.Tip="Cancel text entry" />
        </Grid>
        <c:OnScreenKeyboard x:Name="Keyboard" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>

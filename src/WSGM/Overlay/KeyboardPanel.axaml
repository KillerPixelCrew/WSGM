<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:WSGM.Controls"
        x:Class="WSGM.Overlay.KeyboardPanel"
        Background="{StaticResource DeckSurfaceBrush}">

  <Grid>
    <Border BorderBrush="{StaticResource DeckDividerBrush}" BorderThickness="1" Padding="12">
      <StackPanel Spacing="8" HorizontalAlignment="Stretch">
        <TextBlock x:Name="PromptText" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBox x:Name="Input" FontSize="16" ClearSelectionOnLostFocus="False"
                   IsInactiveSelectionHighlightEnabled="True" />
          <Button x:Name="RevealButton" Grid.Column="1" Content="Show" Click="OnReveal" IsVisible="False" />
        </Grid>
        <c:OnScreenKeyboard x:Name="Keyboard" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button x:Name="AcceptButton" Classes="primary" Content="Accept" Click="OnAccept" />
          <Button Content="Cancel" Click="OnCancel" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>

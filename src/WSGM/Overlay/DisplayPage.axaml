<StackPanel xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:c="using:WSGM.Controls"
            x:Class="WSGM.Overlay.DisplayPage"
            Spacing="10">
  <TextBlock Text="DISPLAY" Classes="eyebrow" Margin="2,0,2,2" />
  <StackPanel x:Name="DisplayBrightnessHost" />
  <!-- Opens Tools › Display › Custom resolutions when a graphics owner is attached. -->
  <c:ActionButton x:Name="CustomResolutionsButton" Click="OnCustomResolutions"
                  Tag="system.display.custom-resolutions"
                  IconGeometry="{x:Static c:Icons.Monitor}"
                  Title="Custom resolutions"
                  Description="The GPU driver's resolution list for each display"
                  IsVisible="False" />
</StackPanel>

<StackPanel xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:ov="using:WSGM.Overlay"
            xmlns:c="using:WSGM.Controls"
            x:Class="WSGM.Overlay.StoragePage"
            x:DataType="ov:OverlayViewModel"
            Spacing="10">
  <TextBlock Text="STORAGE" Classes="eyebrow" Margin="2,0,2,2" />
  <c:ActionButton Click="OnEject"
                  Tag="system.eject"
                  IconGeometry="{x:Static c:Icons.Eject}"
                  Title="Safely remove hardware"
                  Description="Eject an SD card or USB drive" />
  <c:ActionButton Click="OnFormatSdCard"
                  Tag="system.format-card"
                  IsVisible="{Binding ShowSdCard}"
                  IconGeometry="{x:Static c:Icons.SdCard}"
                  Title="Format SD Card"
                  Description="Erase a card as a Steam game library" />
</StackPanel>

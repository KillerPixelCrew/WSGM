<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:WSGM.Controls"
        xmlns:sh="using:WSGM.Shell"
        x:Class="WSGM.Overlay.EjectWindow"
        x:DataType="sh:RemovableDriveManager"
        WindowDecorations="None"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="Manual"
        Width="500"
        Height="420"
        Background="{StaticResource HcBackgroundBrush}"
        Title="Safely remove hardware">
    <!-- A real top-level window, not a flyout: GamepadNavigation only traverses
         its window, so a device list inside a popup would not be reachable with
         a controller at all (same reasoning as the radio and audio panels). -->
    <LayoutTransformControl x:Name="RootScale">
    <Border BorderBrush="{StaticResource HcCardBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="14">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">

            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                <TextBlock Text="Safely remove"
                           FontSize="19"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Content="Refresh"
                        Click="OnRefreshClicked"
                        ToolTip.Tip="Look again for removable drives" />
            </Grid>

            <!-- Named so the code-behind can scroll a controller-focused row into
                 view: directional Focus() does not raise RequestBringIntoView, so
                 a row below the fold would take focus invisibly. -->
            <ScrollViewer x:Name="ListScroller"
                          Grid.Row="1"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="4">
                    <TextBlock Text="No removable drives."
                               Classes="caption"
                               IsVisible="{Binding !HasDrives}" />
                    <ItemsControl ItemsSource="{Binding Drives}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="sh:RemovableDriveEntry">
                                <!-- Selecting a row reveals its Eject button
                                     rather than acting immediately: a stray tap
                                     must never rip a game library out from under
                                     a running session. -->
                                <Border Classes="radio-row"
                                        Classes.selected="{Binding Expanded}"
                                        Margin="0,0,0,3">
                                    <StackPanel>
                                        <Button Classes="radio-row-header"
                                                Click="OnDriveClicked">
                                            <Grid ColumnDefinitions="Auto,*"
                                                  VerticalAlignment="Center">
                                                <Path Classes="row-icon"
                                                      Data="{x:Static c:Icons.Eject}"
                                                      Width="18"
                                                      Stretch="Uniform"
                                                      Margin="0,0,12,0"
                                                      VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" />
                                                    <TextBlock Text="{Binding StatusLine}"
                                                               Classes="caption" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                        <StackPanel Classes="radio-row-actions"
                                                    IsVisible="{Binding Expanded}">
                                            <Button Content="Eject"
                                                    Click="OnDriveEject"
                                                    IsEnabled="{Binding ActionEnabled}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Spacing="8">
                <TextBlock Text="{Binding StatusText}"
                           Classes="caption"
                           TextWrapping="Wrap"
                           IsVisible="{Binding HasStatus}" />
                <Button x:Name="CloseButton"
                        Content="Close"
                        HorizontalAlignment="Right"
                        Click="OnCloseClicked" />
            </StackPanel>
        </Grid>
    </Border>
    </LayoutTransformControl>

    <Window.Styles>
        <Style Selector="Border.radio-row">
            <Setter Property="Background" Value="{DynamicResource HcCardBrush}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Border.radio-row.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource HcAccentBrush}" />
        </Style>
        <Style Selector="Button.radio-row-header">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>
        <Style Selector="StackPanel.radio-row-actions">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Spacing" Value="8" />
            <Setter Property="Margin" Value="10,0,10,10" />
        </Style>
        <!-- Stroke-rendered like the taskbar's status icons: the Icons
             geometries are stroke-style, filling them collapses detail. -->
        <Style Selector="Path.row-icon">
            <Setter Property="Fill" Value="{x:Null}" />
            <Setter Property="Stroke" Value="{StaticResource HcTextMutedBrush}" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="StrokeJoin" Value="Round" />
            <Setter Property="StrokeLineCap" Value="Round" />
        </Style>
    </Window.Styles>
</Window>

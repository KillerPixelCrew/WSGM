<!-- Read-only: the same Core\Credits the Settings About page shows. Links stay in
     Settings, where a browser is the expected thing to open; here the names and the
     addresses are text. -->
<StackPanel xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:core="using:WSGM.Core"
            x:Class="WSGM.Overlay.AboutPage"
            Spacing="10">
  <TextBlock Text="ABOUT" Classes="eyebrow" Margin="2,0,2,2" />
  <StackPanel Spacing="2" Margin="2,0,2,6">
    <TextBlock Text="{x:Static core:Credits.VersionText}" />
    <TextBlock Text="{x:Static core:Credits.Copyright}" Classes="caption" TextWrapping="Wrap" />
    <TextBlock Text="{x:Static core:Credits.License}" Classes="caption" TextWrapping="Wrap" />
    <TextBlock Text="{x:Static core:Credits.ProjectUrl}" Classes="caption" TextWrapping="Wrap" />
  </StackPanel>
  <TextBlock Text="THANKS" Classes="eyebrow" Margin="2,0,2,2" />
  <ItemsControl ItemsSource="{x:Static core:Credits.People}" Margin="2,0,2,6">
    <ItemsControl.ItemTemplate>
      <DataTemplate x:DataType="core:Credit">
        <StackPanel Spacing="2" Margin="0,0,0,8">
          <TextBlock Text="{Binding Name}" />
          <TextBlock Text="{Binding Role}" Classes="caption" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Url}" Classes="caption" TextWrapping="Wrap" />
        </StackPanel>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>
  <TextBlock Text="BUILT ON" Classes="eyebrow" Margin="2,0,2,2" />
  <ItemsControl ItemsSource="{x:Static core:Credits.Projects}" Margin="2,0,2,0">
    <ItemsControl.ItemTemplate>
      <DataTemplate x:DataType="core:Credit">
        <StackPanel Spacing="2" Margin="0,0,0,8">
          <TextBlock Text="{Binding Name}" />
          <TextBlock Text="{Binding Role}" Classes="caption" TextWrapping="Wrap" />
        </StackPanel>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>
</StackPanel>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:WSGM.Controls"
        x:Class="WSGM.Overlay.KeyboardWindow"
        Title="WSGM Keyboard"
        WindowDecorations="None"
        CanResize="False"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        Background="{StaticResource HcBackgroundBrush}">

    <!-- A separate keyboard window opened beside the slim quick-access sidebar (which
         has no room for a keyboard). Gamepad focus crosses left/right between the two
         windows at their edges (see OverlayController). -->
    <LayoutTransformControl x:Name="RootScale">
        <Border BorderBrush="{StaticResource HcCardBorderBrush}" BorderThickness="1" Padding="12">
            <StackPanel Spacing="8" Width="440">
                <TextBlock x:Name="PromptText" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBox x:Name="Input" FontSize="16" />
                <c:OnScreenKeyboard x:Name="Keyboard" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="AcceptButton" Classes="primary" Content="Accept" Click="OnAccept" />
                    <Button Content="Cancel" Click="OnCancel" />
                </StackPanel>
            </StackPanel>
        </Border>
    </LayoutTransformControl>
</Window>

<StackPanel xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:ov="using:WSGM.Overlay"
            xmlns:c="using:WSGM.Controls"
            x:Class="WSGM.Overlay.PowerWakePage"
            x:DataType="ov:OverlayViewModel"
            Spacing="10">
  <TextBlock Text="WAKE" Classes="eyebrow" Margin="2,0,2,2" />
  <StackPanel x:Name="KeepAwakeHost" IsVisible="{Binding ShowKeepAwake}" Spacing="8">
    <TextBlock x:Name="KeepAwakeDetail" Classes="caption" TextWrapping="Wrap" />
  </StackPanel>
  <c:ActionButton Click="OnWakeLocks"
                  Tag="system.wake-locks"
                  IconGeometry="{x:Static c:Icons.ListLines}"
                  Title="What's keeping this awake"
                  Description="List the programs holding a wake lock" />
  <StackPanel x:Name="LockOnWakePolicyHost" Spacing="8" />
</StackPanel>

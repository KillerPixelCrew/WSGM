<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ov="using:WSGM.Overlay"
        xmlns:c="using:WSGM.Controls"
        xmlns:sh="using:WSGM.Shell"
        x:Class="WSGM.Overlay.TaskbarWindow"
        x:DataType="ov:TaskbarViewModel"
        Title="WSGM Taskbar"
        SizeToContent="Height"
        Width="800"
        WindowDecorations="None"
        CanResize="False"
        Topmost="True"
        ShowInTaskbar="False"
        Background="{StaticResource HcBackgroundBrush}">

    <!-- Full-width three-zone bar (approved redesign): WSGM home button on the
         left, the app tile strip in the middle, status cluster (tray, Wi-Fi,
         Bluetooth, battery, clock) on the right. Opaque, square corners, border
         on the top edge only. Height stays content-sized; the code-behind spans
         the width across the primary display and slides the bar up from the
         bottom edge.
         Column sizing is Auto,*,Auto ON PURPOSE: the two fixed zones are
         measured first and always get their space, and the tile strip lives in
         the single star column, which is bounded by whatever is left. The strip
         was previously the Auto column between two stars, so a session with
         enough open windows grew it past the bar and clipped the home button and
         the whole status cluster (a 1280x800 Steam Deck — game mode forces 100%
         scaling — overflows at ~18 tiles). The strip scrolls horizontally
         instead; tiles keep their fixed 44 px size at every count. Within that
         band the tiles are LEFT-aligned (device-requested), so they start right
         after the home button and a tile keeps its place as windows open and
         close, instead of the whole strip sliding sideways under the cursor.
         The RIGHT Auto column is bounded as well (see its own comment): the tray
         strip is the other collection whose length WSGM does not control.
         RootScale: game mode forces 100% display scaling, so DIP sizes render
         1:1 on very dense handheld panels — the code-behind scales the whole
         bar by the desktop DPI to keep tiles touchable (see ApplyTouchScale). -->
    <LayoutTransformControl x:Name="RootScale">
    <Border BorderBrush="{StaticResource HcCardBorderBrush}" BorderThickness="0,1,0,0" Padding="8,2">
        <Grid ColumnDefinitions="Auto,*,Auto">
            <!-- Left zone: quick-access home button. -->
            <Button Grid.Column="0"
                    x:Name="HomeButton"
                    Classes="home-tile"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Click="OnHome"
                    ToolTip.Tip="Open quick access">
                <TextBlock Text="WSGM"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="{DynamicResource HcAccentBrush}" />
            </Button>

            <!-- Center zone: the app tile strip, bounded by the star column and
                 scrolled horizontally once the tiles no longer fit. The strip is
                 centre-aligned, so it stays centred while it fits and fills the
                 viewport once it overflows. Vertical scrolling is Disabled so the
                 window keeps its SizeToContent="Height" behaviour.

                 Does the scrollbar appearing at the overflow threshold change the
                 bar's height? VERIFIED for Avalonia 11.3.18's own Fluent template
                 (src/Avalonia.Themes.Fluent/Controls/ScrollViewer.xaml at tag
                 11.3.18, read from the tagged source — the NuGet package ships
                 only compiled XAML): PART_HorizontalScrollBar sits in the template
                 Grid's Auto row, and the style `^[AllowAutoHide=True] /template/
                 ScrollContentPresenter#PART_ContentPresenter` sets Grid.RowSpan=2
                 / Grid.ColumnSpan=2, so the presenter spans the star row AND that
                 Auto row; Grid.EnsureMinSizeInDefinitionRange (Avalonia
                 Grid.cs @11.3.18) distributes a spanning child's height into the
                 non-Auto definitions and keeps Auto ones "tight", so the ~12 px
                 scrollbar row is absorbed by the 44 px tile height instead of
                 being added to it.
                 NOT verified: WSGM renders under FluentAvaloniaTheme 2.4.1, whose
                 own ScrollViewer control theme REPLACES that template, and the
                 FluentAvalonia repo publishes no v2.4.1 tag to read it from (the
                 shipped 2.4.1 assembly does contain the same PART_ names). Its
                 current source hard-codes RowSpan="2"/ColumnSpan="2" on the
                 presenter unconditionally, which would give the same outcome —
                 that is an assumption, not a confirmed fact for the pinned build.
                 It does not matter either way: SizeChanged → SnapToBottomEdge
                 re-docks the bar flush to the bottom edge whenever its height does
                 change.
                 Controller focus is scrolled into view explicitly in the
                 code-behind (OnStripGotFocus) — see the comment there. -->
            <ScrollViewer Grid.Column="1"
                          x:Name="TileScroller"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          AllowAutoHide="True"
                          VerticalAlignment="Center">
            <!-- Left-aligned (device-requested): the tiles start right after the
                 home button and stay put as windows come and go, instead of the
                 whole strip sliding sideways on every open/close. -->
            <StackPanel Orientation="Horizontal"
                        Spacing="4"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center">
                <TextBlock Text="No open apps"
                           Classes="caption"
                           VerticalAlignment="Center"
                           Margin="10,0"
                           IsVisible="{Binding !HasEntries}" />
                <ItemsControl x:Name="AppTiles" ItemsSource="{Binding Entries}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="ov:TaskbarEntry">
                            <!-- Fixed 44 px tiles: reconcile-in-place must never
                                 shift geometry under the focused button. -->
                            <Button Classes="task-tile"
                                    Classes.active="{Binding IsActive}"
                                    Classes.minimized="{Binding IsMinimized}"
                                    Click="OnPickWindow"
                                    ToolTip.Tip="{Binding Title}">
                                <Panel Width="40" Height="40">
                                    <Image Source="{Binding Icon}"
                                           Width="28" Height="28"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                                    <!-- Fallback glyph when no icon could be resolved. -->
                                    <TextBlock Text="▢"
                                               FontSize="20"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding HasNoIcon}" />
                                    <Border Classes="active-indicator"
                                            Width="20" Height="3"
                                            CornerRadius="1.5"
                                            VerticalAlignment="Bottom"
                                            HorizontalAlignment="Center" />
                                </Panel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
            </ScrollViewer>

            <!-- Right zone per the approved design: tray · Wi-Fi · Bluetooth ·
                 battery · clock. The tray part binds the taskbar view model, so
                 it sits OUTSIDE StatusZone's SystemStatus data context.

                 This Auto column is bounded by budgeting the TRAY only. The tray
                 count is not WSGM's to control — the Shell_TrayWnd host collects
                 whatever the running apps register — so an unbounded tray strip
                 grows this whole column and shoves the status cluster off the
                 right edge (≈17 icons at 1280 px logical), which is exactly the
                 failure the tile-strip fix removed from the centre zone. The
                 status controls that follow are the fixed, non-growing part: they
                 stay outside the scroller and are therefore always fully visible
                 and hittable.
                 Why the tray keeps its OWN scroller instead of moving into the
                 star column next to the tiles: sharing one viewport would make
                 the tray's on-screen position depend on the tile count, and a
                 busy session would push the tray out of sight entirely behind the
                 tiles. A separate bounded region keeps tray and tiles independent
                 and preserves the approved tray · Wi-Fi · BT · battery · clock
                 order. Trade-off: the tray zone can claim up to
                 TrayWidthFraction of the bar, which is width the tile strip does
                 not get — the tiles absorb that by scrolling, which they already
                 do. MaxWidth is set from the code-behind
                 (TaskbarWindow.ComputeTrayMaxWidth) because it depends on the
                 display width and the RootScale touch factor. -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="4"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <!-- Tray area (populated by the Shell_TrayWnd host; the whole
                     scroller collapses when empty, so it costs no width and the
                     separator below hides with it). Tiles keep their fixed 36x44
                     size at every count — reconcile-in-place must never move
                     geometry under the focused button. -->
                <ScrollViewer x:Name="TrayScroller"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              AllowAutoHide="True"
                              VerticalAlignment="Center"
                              IsVisible="{Binding HasTrayIcons}">
                <ItemsControl ItemsSource="{Binding TrayIcons}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="ov:TrayIconEntry">
                            <Button Classes="task-tile tray"
                                    Click="OnTrayClick"
                                    PointerReleased="OnTrayPointerReleased"
                                    ToolTip.Tip="{Binding Tip}">
                                <Image Source="{Binding Image}" Width="20" Height="20" />
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </ScrollViewer>
                <Border Width="1" Height="28"
                        Background="{StaticResource HcCardBorderBrush}"
                        Margin="4,0"
                        IsVisible="{Binding HasTrayIcons}" />
                <StackPanel x:Name="StatusZone"
                            x:DataType="sh:SystemStatus"
                            Orientation="Horizontal"
                            Spacing="4"
                            VerticalAlignment="Center">
                <Button x:Name="WifiButton"
                        Classes="status-tile"
                        ToolTip.Tip="Wi-Fi"
                        Click="OnRadioTileClicked"
                        Tag="wifi">
                    <!-- Drawn, not a static path: the tile has to distinguish
                         off from merely disconnected from connected, and show
                         signal strength, which one glyph cannot express. -->
                    <c:RadioIcon Width="20" Height="20"
                                 State="{Binding Radios.WifiIconState}"
                                 Signal="{Binding Radios.WifiSignal}"
                                 Accent="{DynamicResource HcAccentBrush}"
                                 Muted="{DynamicResource HcTextPrimaryBrush}"
                                 VerticalAlignment="Center"
                                 HorizontalAlignment="Center" />
                </Button>
                <Button x:Name="BluetoothButton"
                        Classes="status-tile"
                        ToolTip.Tip="Bluetooth"
                        Click="OnRadioTileClicked"
                        Tag="bluetooth">
                    <c:RadioIcon Width="20" Height="20"
                                 Bluetooth="True"
                                 State="{Binding Radios.BluetoothIconState}"
                                 Accent="{DynamicResource HcAccentBrush}"
                                 Muted="{DynamicResource HcTextPrimaryBrush}"
                                 VerticalAlignment="Center"
                                 HorizontalAlignment="Center" />
                </Button>
                <StackPanel Orientation="Horizontal"
                            Spacing="5"
                            VerticalAlignment="Center"
                            Margin="4,0,0,0"
                            IsVisible="{Binding HasBattery}">
                    <!-- Width only, no Height: Avalonia's Shape scales a Uniform
                         geometry and then aligns it TOP-LEFT inside the element box
                         (Shape.CalculateSizeAndTransform translates only by the
                         geometry origin), so a square box around this 18.5x8 battery
                         left ~11 px of dead space below it and the icon rode high
                         next to the percentage. Measuring width-only makes the box
                         hug the drawn glyph, so VerticalAlignment actually centers it. -->
                    <Path Classes="status-icon"
                          Data="{x:Static c:Icons.Battery}"
                          Width="20"
                          Stretch="Uniform"
                          VerticalAlignment="Center" />
                    <TextBlock Text="{Binding BatteryText}"
                               FontSize="12"
                               VerticalAlignment="Center" />
                </StackPanel>
                <!-- Time over date, both centred on the stack's own width so the
                     shorter date sits centred under the clock rather than flush
                     right against the bar edge. -->
                <StackPanel VerticalAlignment="Center" Margin="8,0,4,0">
                    <TextBlock Text="{Binding ClockText}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding DateText}"
                               Classes="caption"
                               FontSize="10"
                               HorizontalAlignment="Center" />
                </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
    </LayoutTransformControl>

    <Window.Styles>
        <!-- App tiles: fixed 44 px, card background, accent underline when
             active, dimmed content when minimized. The :focus/:pointerover rules
             are restated here to win the equal-specificity tie against
             Shared.axaml's global Button styles. -->
        <Style Selector="Button.task-tile">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{StaticResource HcCardBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.task-tile:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource HcAccentBrush}" />
        </Style>
        <Style Selector="Button.task-tile:pointerover">
            <Setter Property="Background" Value="{StaticResource HcCardHoverBrush}" />
        </Style>
        <Style Selector="Button.task-tile.minimized Image">
            <Setter Property="Opacity" Value="0.55" />
        </Style>
        <Style Selector="Button.task-tile.minimized TextBlock">
            <Setter Property="Opacity" Value="0.55" />
        </Style>
        <Style Selector="Button.task-tile Border.active-indicator">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.task-tile.active Border.active-indicator">
            <Setter Property="Background" Value="{DynamicResource HcAccentBrush}" />
        </Style>
        <Style Selector="Button.task-tile.tray">
            <Setter Property="Width" Value="36" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- WSGM home button (left zone). -->
        <Style Selector="Button.home-tile">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="Button.home-tile:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource HcAccentBrush}" />
        </Style>
        <Style Selector="Button.home-tile:pointerover">
            <Setter Property="Background" Value="{StaticResource HcCardHoverBrush}" />
        </Style>

        <!-- Status buttons (right zone): neutral stroke icons; only a known-on
             radio state (Wi-Fi connected) tints the icon with the accent. -->
        <Style Selector="Button.status-tile">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.status-tile:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource HcAccentBrush}" />
        </Style>
        <Style Selector="Button.status-tile:pointerover">
            <Setter Property="Background" Value="{StaticResource HcCardHoverBrush}" />
        </Style>
        <!-- Stroke-rendered like the TabStrip icons: the Icons geometries are
             stroke-style, filling them collapses interior detail. -->
        <Style Selector="Path.status-icon">
            <Setter Property="Fill" Value="{x:Null}" />
            <Setter Property="Stroke" Value="{StaticResource HcTextMutedBrush}" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="StrokeJoin" Value="Round" />
            <Setter Property="StrokeLineCap" Value="Round" />
        </Style>
        <Style Selector="Button.status-tile.active Path.status-icon">
            <Setter Property="Stroke" Value="{DynamicResource HcAccentBrush}" />
        </Style>
    </Window.Styles>
</Window>

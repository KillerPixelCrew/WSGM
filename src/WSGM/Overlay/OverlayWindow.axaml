<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ov="using:WSGM.Overlay"
        xmlns:c="using:WSGM.Controls"
        xmlns:sh="using:WSGM.Shell"
        xmlns:li="using:LoadingIndicators.Avalonia"
        xmlns:fa="using:FluentAvalonia.UI.Controls"
        x:Class="WSGM.Overlay.OverlayWindow"
        x:DataType="ov:OverlayViewModel"
        Title="WSGM Quick Access"
        Width="360"
        MinWidth="320"
        WindowDecorations="None"
        CanResize="False"
        Topmost="True"
        ShowInTaskbar="False"
        Background="{StaticResource HcBackgroundBrush}">

    <!-- Approved quick-access redesign: slim header, bumper TabStrip
         (Session / Tools / Power, LB/RB cycle with wrap), three always-alive
         per-tab panels toggled by IsVisible, CardButton rows, glyph footer.
         No CornerRadius/Background here: the window surface behind it is opaque
         and identically colored, so rounded corners could never render.
         RootScale: renders the panel at the desktop's DPI — game mode forces
         100% scaling, which shrinks DIP-sized UI on dense handheld panels
         (see DockToRightEdge / DisplayScale.GetUiScalePercent). -->
    <LayoutTransformControl x:Name="RootScale">
    <Border>
        <Grid RowDefinitions="Auto,Auto,*,Auto">
            <Border Grid.Row="0" Background="{StaticResource HcHeaderBrush}" BorderBrush="{StaticResource HcCardBorderBrush}" BorderThickness="0,0,0,1" Padding="10,6">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <TextBlock Text="WSGM" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text="QUICK ACCESS" Classes="eyebrow" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="icon close" Content="×" Click="OnClose" ToolTip.Tip="Close quick access" />
                </Grid>
            </Border>

            <!-- Tab descriptors (labels + Icons geometries) are assigned in
                 code-behind; LB/RB cycle via GamepadNavigation. -->
            <Border Grid.Row="1" Background="{StaticResource HcBackgroundBrush}" BorderBrush="{StaticResource HcCardBorderBrush}" BorderThickness="0,0,0,1">
                <c:TabStrip x:Name="Tabs" />
            </Border>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8,8" Spacing="4">
                    <!-- Panel-level warning: sits above the tab panels, so it is
                         visible on every tab. -->
                    <fa:FAInfoBar IsOpen="{Binding HasWarning}" Title="WSGM" Message="{Binding WarningText}" Severity="Warning" IsClosable="False" Margin="0,0,0,4" />

                    <StackPanel x:Name="PanelSession" Spacing="4" IsVisible="True">
                        <c:CardButton x:Name="HomeAppButton" Classes="primary" Click="OnHomeApp"
                                      IconGeometry="{x:Static c:Icons.Play}"
                                      Title="{Binding HomeAppButtonText}"
                                      Description="Open Steam Big Picture"
                                      TrailingText="A" />
                        <c:CardButton x:Name="DesktopButton" Click="OnDesktop"
                                      IconGeometry="{x:Static c:Icons.Monitor}"
                                      Title="{Binding DesktopButtonText}"
                                      Description="Show or hide the Windows desktop" />
                        <c:CardButton x:Name="ExitBigPictureButton" Click="OnExitBigPicture"
                                      IconGeometry="{x:Static c:Icons.ExitFullscreen}"
                                      Title="Exit Big Picture"
                                      Description="Switch Steam to its desktop window" />
                        <c:CardButton x:Name="CloseLauncherButton" Click="OnCloseLauncher"
                                      IsVisible="{Binding HomeAppAlive}"
                                      IconGeometry="{x:Static c:Icons.Close}"
                                      Title="{Binding CloseLauncherText}"
                                      Description="Quit Steam completely" />
                    </StackPanel>

                    <StackPanel x:Name="PanelTools" Spacing="4" IsVisible="False">
                        <c:CardButton Click="OnSettings"
                                      IconGeometry="{x:Static c:Icons.Gear}"
                                      Title="Settings"
                                      Description="Shell, startup, and quick access configuration" />
                        <c:CardButton Click="OnTaskManager"
                                      IconGeometry="{x:Static c:Icons.Grid4}"
                                      Title="Task Manager"
                                      Description="Processes and performance" />
                        <!-- The x:Name lives on the button: the copy handlers
                             rewrite its Title with the copy result. -->
                        <c:CardButton x:Name="DeelevationCommandTitle" Click="OnCopyDeelevationCommand"
                                      IconGeometry="{x:Static c:Icons.CopyDoc}"
                                      Title="Copy de-elevation command"
                                      Description="Paste into a game's Steam launch options" />
                        <c:CardButton x:Name="SteamInputBlockCommandTitle" Click="OnCopySteamInputBlockCommand"
                                      IconGeometry="{x:Static c:Icons.BlockedCircle}"
                                      Title="Copy Steam Input block command"
                                      Description="For games that read the controller themselves" />
                        <c:CardButton Click="OnFormatSdCard"
                                      IconGeometry="{x:Static c:Icons.SdCard}"
                                      Title="Format SD Card"
                                      Description="Erase a card as a Steam game library" />
                        <c:CardButton Click="OnAddLibrary"
                                      IconGeometry="{x:Static c:Icons.FolderPlus}"
                                      Title="Add Steam Library"
                                      Description="Register a folder, drive, or network share" />
                    </StackPanel>

                    <!-- Format flow lives in-place (a Popup/Flyout would be
                         unreachable by the controller — GamepadNavigation is
                         scoped to this window). Three states toggle by
                         visibility: pick a drive, confirm the erase, watch it
                         run. The whole sub-view is hidden from the tab strip. -->
                    <StackPanel x:Name="PanelFormat" x:DataType="sh:SdFormatManager" Spacing="6" IsVisible="False">
                        <TextBlock x:Name="FormatHeading"
                                   Text="Format SD Card"
                                   FontSize="15"
                                   FontWeight="SemiBold" />

                        <!-- State 1: target list -->
                        <StackPanel x:Name="FormatPickView" Spacing="4">
                            <TextBlock Text="Choose a drive to erase and set up as a Steam library. Everything on it will be lost."
                                       Classes="caption"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="No removable drives found."
                                       Classes="caption"
                                       IsVisible="{Binding !HasTargets}" />
                            <ItemsControl ItemsSource="{Binding Targets}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="sh:FormatTargetEntry">
                                        <c:CardButton Click="OnFormatTargetChosen"
                                                      IconGeometry="{x:Static c:Icons.SdCard}"
                                                      Title="{Binding Name}"
                                                      Description="{Binding Detail}"
                                                      IsEnabled="{Binding $parent[ItemsControl].((sh:SdFormatManager)DataContext).NotBusy, FallbackValue=True}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="Refresh" Click="OnFormatRefresh" HorizontalAlignment="Left" />
                        </StackPanel>

                        <!-- State 2: confirm -->
                        <StackPanel x:Name="FormatConfirmView" Spacing="8" IsVisible="False">
                            <Border Background="{StaticResource HcCardBrush}"
                                    BorderBrush="{StaticResource HcDangerBrush}"
                                    BorderThickness="2"
                                    CornerRadius="6"
                                    Padding="12">
                                <StackPanel Spacing="6">
                                    <TextBlock x:Name="FormatConfirmTarget" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock x:Name="FormatConfirmDetail" Classes="caption" TextWrapping="Wrap" />
                                    <TextBlock Text="Everything on this drive will be permanently erased."
                                               Foreground="{StaticResource HcDangerBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Name (volume and Steam library)" Classes="caption" />
                                <TextBox x:Name="FormatNameInput" MaxLength="32" PlaceholderText="Games" />
                                <c:OnScreenKeyboard x:Name="FormatKeyboard" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="FormatConfirmButton"
                                        Classes="danger"
                                        Content="Erase and format"
                                        Click="OnFormatConfirmed" />
                                <Button Content="Cancel" Click="OnFormatCancel" />
                            </StackPanel>
                        </StackPanel>

                        <!-- State 3: progress / done -->
                        <StackPanel x:Name="FormatProgressView" Spacing="10" IsVisible="False">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <li:LoadingIndicator Mode="Ring"
                                                     Width="22" Height="22"
                                                     IsVisible="{Binding Busy}"
                                                     VerticalAlignment="Center" />
                                <TextBlock Text="{Binding StatusText}"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <Button x:Name="FormatDoneButton"
                                    Content="Done"
                                    Click="OnFormatCancel"
                                    IsVisible="{Binding NotBusy}"
                                    HorizontalAlignment="Left" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="PanelPower" Spacing="4" IsVisible="False">
                        <c:CardButton Click="OnSleep"
                                      IconGeometry="{x:Static c:Icons.Moon}"
                                      Title="Sleep"
                                      Description="Put this handheld to sleep" />
                        <!-- The two-step confirms rewrite Title ("Really?") from
                             code-behind, same auto-revert as before. -->
                        <c:CardButton x:Name="RestartButton" Click="OnRestart"
                                      IconGeometry="{x:Static c:Icons.Restart}"
                                      Title="Restart"
                                      Description="Restart Windows" />
                        <c:CardButton x:Name="ShutdownButton" Classes="danger" Click="OnShutdown"
                                      IconGeometry="{x:Static c:Icons.Power}"
                                      Title="Shut down"
                                      Description="Turn off this handheld" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="3" Classes="hc-footer" Padding="8,5">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="17">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <ov:GlyphIcon Width="18" Height="18" Button="a" GlyphStyle="{Binding GlyphStyle}" VerticalAlignment="Center" />
                            <TextBlock Text="Select" Classes="caption" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <ov:GlyphIcon Width="18" Height="18" Button="b" GlyphStyle="{Binding GlyphStyle}" VerticalAlignment="Center" />
                            <TextBlock Text="Back" Classes="caption" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14">
                        <TextBlock Text="LB/RB  Tab" Classes="caption" VerticalAlignment="Center" />
                        <TextBlock Text="D-pad  Navigate" Classes="caption" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
    </LayoutTransformControl>

    <Window.Styles>
        <Style Selector="Button.close">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource HcTextMutedBrush}" />
        </Style>
        <Style Selector="Button.close:focus">
            <Setter Property="Foreground" Value="White" />
        </Style>
    </Window.Styles>
</Window>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ov="using:WSGM.Overlay"
        xmlns:fa="using:FluentAvalonia.UI.Controls"
        x:Class="WSGM.Overlay.OverlayWindow"
        x:DataType="ov:OverlayViewModel"
        Title="WSGM Quick Access"
        Width="360"
        MinWidth="320"
        SystemDecorations="None"
        CanResize="False"
        Topmost="True"
        ShowInTaskbar="False"
        Background="{StaticResource HcBackgroundBrush}">

    <!-- Ported from Handheld Companion QuickTools: compact status strip, grouped
         SettingsCard-style rows, and a bottom controller-navigation bar.
         No CornerRadius/Background here: the window surface behind it is opaque
         and identically colored, so rounded corners could never render. -->
    <Border>
        <Grid RowDefinitions="Auto,*,Auto">
            <Border Grid.Row="0" Background="#FF282828" BorderBrush="#FF343434" BorderThickness="0,0,0,1" Padding="10,6">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <TextBlock Text="WSGM" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text="QUICK ACCESS" FontSize="10" Foreground="{StaticResource HcTextMutedBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="icon close" Content="×" Click="OnClose" ToolTip.Tip="Close quick access" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8,8" Spacing="4">
                    <fa:InfoBar IsOpen="{Binding HasWarning}" Title="WSGM" Message="{Binding WarningText}" Severity="Warning" IsClosable="False" Margin="0,0,0,4" />

                    <TextBlock Text="Session" Classes="section-title" Margin="0,0,0,2" />
                    <Button x:Name="HomeAppButton" Classes="quick-row primary" Click="OnHomeApp">
                        <Grid ColumnDefinitions="32,*,Auto" ColumnSpacing="10">
                            <TextBlock Text="▶" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding HomeAppButtonText}" Classes="setting-title" />
                                <TextBlock Text="Open Steam Big Picture" Classes="caption" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="A" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button x:Name="DesktopButton" Classes="quick-row" Click="OnDesktop">
                        <Grid ColumnDefinitions="32,*" ColumnSpacing="10">
                            <TextBlock Text="▣" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DesktopButtonText}" Classes="setting-title" />
                                <TextBlock Text="Show or hide the Windows desktop" Classes="caption" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button x:Name="ExitBigPictureButton" Classes="quick-row" Click="OnExitBigPicture">
                        <Grid ColumnDefinitions="32,*" ColumnSpacing="10">
                            <TextBlock Text="⤢" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                <TextBlock Text="Exit Big Picture" Classes="setting-title" />
                                <TextBlock Text="Switch Steam to its desktop window" Classes="caption" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button x:Name="SwitchAppButton" Classes="quick-row" Click="OnSwitchApps">
                        <Grid ColumnDefinitions="32,*" ColumnSpacing="10">
                            <TextBlock Text="⇄" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                <TextBlock Text="Switch app" Classes="setting-title" />
                                <TextBlock Text="Pick one of your running programs" Classes="caption" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <ItemsControl IsVisible="{Binding ShowWindowList}" ItemsSource="{Binding SwitchableWindows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="ov:AppWindowEntry">
                                <Button Classes="quick-row" Margin="24,2,0,0" Click="OnPickWindow">
                                    <TextBlock Text="{Binding Title}" Classes="setting-title" TextTrimming="CharacterEllipsis" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button x:Name="CloseLauncherButton" Classes="quick-row" Click="OnCloseLauncher"
                            IsVisible="{Binding HomeAppAlive}">
                        <Grid ColumnDefinitions="32,*" ColumnSpacing="10">
                            <TextBlock Text="✕" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CloseLauncherText}" Classes="setting-title" />
                                <TextBlock Text="Quit Steam completely" Classes="caption" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <TextBlock Text="WSGM" Classes="section-title" Margin="0,4,0,2" />
                    <Button Classes="quick-row" Click="OnSettings">
                        <Grid ColumnDefinitions="32,*" ColumnSpacing="10">
                            <TextBlock Text="⚙" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                <TextBlock Text="Settings" Classes="setting-title" />
                                <TextBlock Text="Shell, startup, and quick access configuration" Classes="caption" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button Classes="quick-row" Click="OnTaskManager">
                        <Grid ColumnDefinitions="32,*" ColumnSpacing="10">
                            <TextBlock Text="▦" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                <TextBlock Text="Task Manager" Classes="setting-title" />
                                <TextBlock Text="Processes and performance" Classes="caption" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <TextBlock Text="Power" Classes="section-title" Margin="0,4,0,2" />
                    <Button Classes="quick-row" Click="OnSleep">
                        <Grid ColumnDefinitions="32,*" ColumnSpacing="10">
                            <TextBlock Text="☾" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                <TextBlock Text="Sleep" Classes="setting-title" />
                                <TextBlock Text="Put this handheld to sleep" Classes="caption" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button x:Name="RestartButton" Classes="quick-row" Click="OnRestart">
                        <Grid ColumnDefinitions="32,*" ColumnSpacing="10">
                            <TextBlock Text="↻" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                <TextBlock x:Name="RestartTitle" Text="Restart" Classes="setting-title" />
                                <TextBlock Text="Restart Windows" Classes="caption" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button x:Name="ShutdownButton" Classes="quick-row danger" Click="OnShutdown">
                        <Grid ColumnDefinitions="32,*" ColumnSpacing="10">
                            <TextBlock Text="⏻" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                <TextBlock x:Name="ShutdownTitle" Text="Shut down" Classes="setting-title" />
                                <TextBlock Text="Turn off this handheld" Classes="caption" />
                            </StackPanel>
                        </Grid>
                    </Button>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Classes="hc-footer" Padding="8,5">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="17">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <ov:GlyphIcon Width="18" Height="18" Button="a" GlyphStyle="{Binding GlyphStyle}" VerticalAlignment="Center" />
                            <TextBlock Text="Select" Classes="caption" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <ov:GlyphIcon Width="18" Height="18" Button="b" GlyphStyle="{Binding GlyphStyle}" VerticalAlignment="Center" />
                            <TextBlock Text="Back" Classes="caption" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="D-pad  Navigate" Classes="caption" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Border>

    <Window.Styles>
        <!-- Focus ring flicker fix: Avalonia's default focus visual is an ADORNER
             that is destroyed and rebuilt on every focus move (and silently lost
             on activation blips). Kill it and paint a stable :focus border inside
             the buttons instead — constant 2px thickness so nothing shifts. -->
        <Style Selector="Button">
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>
        <Style Selector="Button.quick-row">
            <Setter Property="Background" Value="{StaticResource HcCardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource HcCardBorderBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.quick-row:focus">
            <Setter Property="BorderBrush" Value="{StaticResource HcAccentBrush}" />
        </Style>
        <Style Selector="Button.quick-row.primary:focus">
            <Setter Property="BorderBrush" Value="White" />
        </Style>
        <Style Selector="Button.close:focus">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.quick-row:pointerover">
            <Setter Property="Background" Value="#FF383838" />
        </Style>
        <Style Selector="Button.quick-row.primary">
            <Setter Property="Background" Value="{StaticResource HcAccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource HcAccentBrush}" />
            <Setter Property="Foreground" Value="Black" />
        </Style>
        <Style Selector="Button.quick-row.primary TextBlock.caption">
            <Setter Property="Foreground" Value="#CC000000" />
        </Style>
        <Style Selector="Button.close">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource HcTextMutedBrush}" />
        </Style>
    </Window.Styles>
</Window>

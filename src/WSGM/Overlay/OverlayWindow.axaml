<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ov="using:WSGM.Overlay"
        xmlns:c="using:WSGM.Controls"
        xmlns:core="using:WSGM.Core"
        xmlns:sh="using:WSGM.Shell"
        xmlns:li="using:LoadingIndicators.Avalonia"
        xmlns:fa="using:FluentAvalonia.UI.Controls"
        xmlns:labs="using:Avalonia.Labs.Panels"
        x:Class="WSGM.Overlay.OverlayWindow"
        x:DataType="ov:OverlayViewModel"
        Title="WSGM Quick Access"
        Width="1280"
        Height="800"
        Classes="command-deck"
        TransparencyLevelHint="Transparent"
        TransparencyBackgroundFallback="{StaticResource DeckCanvasBrush}"
        WindowDecorations="None"
        CanResize="False"
        Topmost="True"
        ShowInTaskbar="False"
        Background="Transparent">

  <!-- Fullscreen live glass. The fixed close control is always reachable. -->
  <LayoutTransformControl x:Name="RootScale">
    <Grid x:Name="SurfaceRoot">
      <Border x:Name="GlassCanvas" Background="{StaticResource DeckCanvasBrush}" />
      <Grid x:Name="DeckContent" RowDefinitions="Auto,Auto,*,Auto,Auto">
        <Border Grid.Row="0" x:Name="Header" Background="{StaticResource DeckRailBrush}"
                BorderBrush="{StaticResource DeckDividerBrush}" BorderThickness="0,0,0,1" Padding="24,0" Height="72">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
              <Button x:Name="BackButton" Classes="pill" IsVisible="False" AutomationProperties.Name="Back"
                      ToolTip.Tip="Back" Click="OnHeaderBack">
                <Path Classes="status-icon" Data="{x:Static c:Icons.ArrowLeft}" Width="18" Stretch="Uniform" />
              </Button>
              <TextBlock Text="WSGM" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
              <Border Width="1" Height="24" Background="{StaticResource DeckDividerBrush}" />
              <StackPanel Spacing="2" Width="176" VerticalAlignment="Center">
                <TextBlock x:Name="ProfileContext" Text="Profile" FontSize="11"
                           Foreground="{StaticResource DeckSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                <ComboBox x:Name="HeaderProfile" SelectedIndex="0" IsEnabled="False"
                          HorizontalAlignment="Stretch" AutomationProperties.Name="Settings profile"
                          ToolTip.Tip="Start or focus an application to give it separate settings."
                          SelectionChanged="OnHeaderProfileChanged" DropDownOpened="OnHeaderProfileOpened"
                          DropDownClosed="OnHeaderProfileClosed">
                  <ComboBoxItem Content="Global" />
                  <ComboBoxItem Content="Per-application" />
                </ComboBox>
              </StackPanel>
              <Button x:Name="ManageProfiles" Classes="pill" AutomationProperties.Name="Manage application profiles"
                      ToolTip.Tip="Manage application profiles" Click="OnManageProfiles">
                <Path Classes="status-icon" Data="{x:Static c:Icons.ListLines}" Width="18" Stretch="Uniform" />
              </Button>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <StackPanel x:Name="StatusZone" DataContext="{x:Null}" x:DataType="sh:SystemStatus"
                          Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button x:Name="WifiButton"
                        Classes="pill"
                        AutomationProperties.Name="Wi-Fi settings"
                        ToolTip.Tip="Wi-Fi"
                        Click="OnRadioTileClicked"
                        Tag="wifi">
                  <!-- Drawn, not a static path: the pill distinguishes
                                     off / disconnected / connected and shows signal
                                     strength, which one glyph cannot express. -->
                  <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                    <c:RadioIcon Width="18" Height="18"
                                 State="{Binding Radios.WifiIconState}"
                                 Signal="{Binding Radios.WifiSignal}"
                                 Accent="{DynamicResource HcAccentBrush}"
                                 Muted="{StaticResource HcTextPrimaryBrush}"
                                 VerticalAlignment="Center" />
                    <Border Classes="header-detail">
                    <TextBlock x:Name="WifiLabel" Text="{Binding Radios.ConnectedSsid}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               MaxWidth="90"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               IsVisible="{Binding Radios.WifiConnected}" />
                    </Border>
                  </StackPanel>
                </Button>
<Button x:Name="BluetoothButton"
                        Classes="pill"
                        AutomationProperties.Name="Bluetooth settings"
                        ToolTip.Tip="Bluetooth"
                        Click="OnRadioTileClicked"
                        Tag="bluetooth">
                  <c:RadioIcon Width="18" Height="18"
                               Bluetooth="True"
                               State="{Binding Radios.BluetoothIconState}"
                               Accent="{DynamicResource HcAccentBrush}"
                               Muted="{StaticResource HcTextPrimaryBrush}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center" />
                </Button>
                <Border Width="1" Height="24" Background="{StaticResource DeckDividerBrush}" Margin="6,0" />
                <Button x:Name="AudioButton"
                        Classes="pill"
                        AutomationProperties.Name="Audio settings"
                        ToolTip.Tip="{Binding Audio.VolumeText}"
                        Click="OnAudioTileClicked">
                  <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                    <Path Classes="status-icon" Data="{x:Static c:Icons.Volume}" Width="18" Stretch="Uniform"
                          VerticalAlignment="Center" />
                    <Border Classes="header-detail">
                    <TextBlock x:Name="VolumeLabel" Text="{Binding Audio.VolumeText}" FontSize="12" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    </Border>
                  </StackPanel>
                </Button>
                <Button x:Name="BrightnessButton" Classes="pill" AutomationProperties.Name="Display brightness"
                        ToolTip.Tip="Display brightness" Click="OnHeaderBrightness">
                  <Path Classes="status-icon" Data="{x:Static c:Icons.Sun}" Width="20" Stretch="Uniform" />
                </Button>
                <Button x:Name="EjectButton"
                        Classes="pill"
                        AutomationProperties.Name="Safely remove hardware"
                        ToolTip.Tip="Safely remove hardware"
                        IsVisible="{Binding Drives.HasDrives}"
                        Click="OnEjectTileClicked">
                  <Path Classes="status-icon" Data="{x:Static c:Icons.Eject}" Width="16" Stretch="Uniform"
                        VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Button>
                <Border Width="1" Height="24" Background="{StaticResource DeckDividerBrush}" Margin="6,0" />
                <Button x:Name="KeyboardButton" Classes="pill" AutomationProperties.Name="On-screen keyboard"
                        ToolTip.Tip="On-screen keyboard" Click="OnHeaderKeyboard">
                  <Path Classes="status-icon" Data="{x:Static c:Icons.Keyboard}" Width="20" Stretch="Uniform" />
                </Button>
                <Border x:Name="BatteryStatus" Classes="pill-static" IsVisible="{Binding HasBattery}">
                  <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Path Classes="status-icon" Data="{x:Static c:Icons.Battery}" Width="20" Stretch="Uniform" VerticalAlignment="Center" />
                    <TextBlock x:Name="BatteryLabel" Text="{Binding BatteryText}" FontSize="13" VerticalAlignment="Center" />
                  </StackPanel>
                </Border>
                <TextBlock x:Name="ClockLabel" Text="{Binding ClockText}" FontSize="15" FontWeight="SemiBold" Margin="8,0"
                           VerticalAlignment="Center" />
              </StackPanel>
              <Border Width="1" Height="28" Background="{StaticResource DeckDividerBrush}" Margin="4,0" />
              <Button x:Name="CloseButton" Classes="pill close" Content="×" Click="OnClose"
                      AutomationProperties.Name="Close quick access" ToolTip.Tip="Close quick access" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- Tab descriptors (labels + Icons geometries) are assigned in
                 code-behind; LB/RB cycle via GamepadNavigation. -->
        <Border Grid.Row="1" Background="{StaticResource DeckRailBrush}"
                BorderBrush="{StaticResource DeckDividerBrush}" BorderThickness="0,0,0,1" Padding="16,0">
          <c:TabStrip x:Name="Tabs" Classes="sheet" />
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="*,2*" ColumnSpacing="{StaticResource DeckSectionGap}" Margin="{StaticResource DeckWorkspaceMargin}"
              MaxWidth="{StaticResource DeckContentMaxWidth}" HorizontalAlignment="Stretch">
          <Border Background="{StaticResource DeckRailBrush}" CornerRadius="{StaticResource DeckGroupRadius}" Padding="{StaticResource DeckPanePadding}">
            <Grid RowDefinitions="Auto,*" RowSpacing="{StaticResource DeckSectionGap}">
              <StackPanel Spacing="6" Margin="8,8,8,0">
                <TextBlock x:Name="WorkspaceTitle" Text="Quick access" FontSize="26" FontWeight="SemiBold" />
                <TextBlock x:Name="WorkspaceDescription" Text="Your pinned controls and widgets" Classes="caption" TextWrapping="Wrap" />
              </StackPanel>
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" GotFocus="OnContentGotFocus">
                <StackPanel x:Name="SectionRail" Spacing="4" />
              </ScrollViewer>
            </Grid>
          </Border>
          <Border Grid.Column="1" Background="{StaticResource DeckControlsBrush}" CornerRadius="{StaticResource DeckGroupRadius}">
        <ScrollViewer x:Name="ContentScroller"
                      VerticalScrollBarVisibility="Auto"
                      GotFocus="OnContentGotFocus">
          <StackPanel Margin="{StaticResource DeckPanePadding}" Spacing="{StaticResource DeckSectionGap}">
            <!-- Panel-level warning: sits above the destination roots, so it
                         is visible on every one. -->
            <fa:FAInfoBar IsOpen="{Binding HasWarning}" Title="WSGM" Message="{Binding WarningText}" Severity="Warning"
                          IsClosable="False" Margin="0,0,0,4" />

            <!-- Quick access combines action cards, complete pinned sections and widgets.
                         Section headers own pinning; their controls keep normal editing behavior. -->
            <StackPanel x:Name="PanelQuickAccess" Spacing="12" IsVisible="True">
              <UniformGrid x:Name="PinnedGrid" Columns="2" />
              <StackPanel x:Name="PinnedSectionsGrid" Spacing="12" />
              <StackPanel x:Name="PinnedPluginWidgetsHost" Spacing="8" />
            </StackPanel>

            <!-- Steam: a menu of categories, like the Device root. The controls
                         themselves live on the category pages below. -->
            <UniformGrid x:Name="PanelSteam" Columns="2" IsVisible="False">
              <c:ActionButton Classes="tile" Click="OnEnterCategory"
                            CommandParameter="{x:Static ov:OverlayPage.SteamLibrary}"
                            Margin="0,0,10,10"
                            IconGeometry="{x:Static c:Icons.SteamLike}"
                            Title="Steam library"
                            Description="Tabs, artwork, card manager and library folders" />
              <c:ActionButton Classes="tile" Click="OnEnterCategory"
                            CommandParameter="{x:Static ov:OverlayPage.SteamLaunchFixes}"
                            Margin="0,0,10,10"
                            IconGeometry="{x:Static c:Icons.Rocket}"
                            Title="Per-game launch fixes"
                            Description="De-elevation, the Steam Input lease and custom launch actions" />
            </UniformGrid>

            <StackPanel x:Name="PanelSteamLibrary" Spacing="10" IsVisible="False" HorizontalAlignment="Stretch">
              <TextBlock Text="STEAM LIBRARY" Classes="eyebrow" Margin="2,0,2,2" />
              <TextBlock Text="Steam integration is turned off in Settings."
                         Classes="caption"
                         IsVisible="{Binding !ShowSteamLibrarySection}" />
              <c:ActionButton Click="OnGameLibrary"
                            Tag="steam.game-library"
                            IsVisible="{Binding ShowGameLibrary}"
                            IconGeometry="{x:Static c:Icons.Grid4}"
                            Title="Game Library"
                            Description="Bring games from other launchers into Steam" />
              <c:ActionButton Click="OnLibraryTabs"
                            Tag="steam.library-tabs"
                            IsVisible="{Binding ShowLibraryTabs}"
                            IconGeometry="{x:Static c:Icons.SteamLike}"
                            Title="Library Tabs"
                            Description="Custom filter tabs and genres" />
              <c:ActionButton Click="OnCardManager"
                            Tag="steam.card-manager"
                            IsVisible="{Binding ShowCardManager}"
                            IconGeometry="{x:Static c:Icons.SdCard}"
                            Title="Card Manager"
                            Description="Rename, hide, and view SD-card libraries" />
              <c:ActionButton Click="OnAddLibrary"
                            Tag="steam.add-library"
                            IsVisible="{Binding ShowSdCard}"
                            IconGeometry="{x:Static c:Icons.FolderPlus}"
                            Title="Add Steam Library"
                            Description="Register a folder, drive, or network share" />
              <!-- Formatting normally lives inside the Card Manager; this
                             entry only returns when that manager is switched off, so
                             the SD-format toggle can never be on with no way in. -->
              <c:ActionButton Click="OnFormatSdCard"
                            Tag="steam.format-card"
                            IsVisible="{Binding ShowFormatInTools}"
                            IconGeometry="{x:Static c:Icons.SdCard}"
                            Title="Format SD Card"
                            Description="Erase a card as a Steam game library" />
            </StackPanel>

            <StackPanel x:Name="PanelSteamLaunch" Spacing="10" IsVisible="False" HorizontalAlignment="Stretch">
              <TextBlock Text="PER-GAME LAUNCH FIXES" Classes="eyebrow" Margin="2,0,2,2" />
              <!-- The x:Name lives on the button: the handlers rewrite its
                             Title with the result. Titles and descriptions are set
                             once in the constructor (they differ for the CEF and
                             clipboard paths) and must NOT be bound, or a binding
                             re-evaluation would wipe the result text. -->
              <c:ActionButton x:Name="DeelevateFixButton" Click="OnApplyLaunchFix"
                            CommandParameter="{x:Static core:LaunchWrapperMode.Deelevate}"
                            Tag="steam.launch.deelevate"
                            IconGeometry="{x:Static c:Icons.ArrowDown}" />
              <c:ActionButton x:Name="InputLeaseFixButton" Click="OnApplyLaunchFix"
                            CommandParameter="{x:Static core:LaunchWrapperMode.InputLease}"
                            Tag="steam.launch.input-lease"
                            IconGeometry="{x:Static c:Icons.BlockedCircle}" />
              <c:ActionButton x:Name="BothFixesButton" Click="OnApplyLaunchFix"
                            CommandParameter="{x:Static core:LaunchWrapperMode.Both}"
                            Tag="steam.launch.both"
                            IconGeometry="{x:Static c:Icons.Rocket}" />
              <c:ActionButton x:Name="CustomLaunchButton" Click="OnPickCustomLaunchAction"
                            Tag="steam.launch.custom"
                            IsVisible="{Binding ConfigureLaunchOptionsLive}"
                            IconGeometry="{x:Static c:Icons.FolderPlus}"
                            Title="Replace launch action"
                            Description="Run an EXE, CMD, BAT, or PowerShell script" />
              <c:ActionButton x:Name="RemoveFixesButton" Click="OnApplyLaunchFix"
                            CommandParameter="{x:Static core:LaunchWrapperMode.None}"
                            Tag="steam.launch.restore"
                            IsVisible="{Binding ShowRemoveLaunchWrapper}"
                            IconGeometry="{x:Static c:Icons.Close}"
                            Title="Restore original launch action"
                            Description="Remove WSGM changes and restore the original" />
            </StackPanel>

            <!-- Format flow lives in-place (a Popup/Flyout would be
                         unreachable by the controller — GamepadNavigation is
                         scoped to this window). Three states toggle by
                         visibility: pick a drive, confirm the erase, watch it
                         run. The whole sub-view is hidden from the tab strip. -->
            <StackPanel x:Name="PanelFormat" DataContext="{x:Null}" x:DataType="sh:SdFormatManager" Spacing="6"
                        IsVisible="False" HorizontalAlignment="Stretch">
              <TextBlock x:Name="FormatHeading"
                         Text="Format SD Card"
                         FontSize="15"
                         FontWeight="SemiBold" />

              <!-- State 1: target list -->
              <StackPanel x:Name="FormatPickView" Spacing="4">
                <TextBlock Text="Choose a drive to erase and set up as a Steam library. Everything on it will be lost."
                           Classes="caption"
                           TextWrapping="Wrap" />
                <TextBlock Text="No removable drives found."
                           Classes="caption"
                           IsVisible="{Binding !HasTargets}" />
                <ItemsControl ItemsSource="{Binding Targets}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="sh:FormatTargetEntry">
                      <c:ActionButton Click="OnFormatTargetChosen"
                                    IconGeometry="{x:Static c:Icons.SdCard}"
                                    Title="{Binding Name}"
                                    Description="{Binding Detail}"
                                    IsEnabled="{Binding $parent[ItemsControl].((sh:SdFormatManager)DataContext).NotBusy, FallbackValue=True}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Refresh" Click="OnFormatRefresh" HorizontalAlignment="Stretch" />
              </StackPanel>

              <!-- State 2: confirm -->
              <StackPanel x:Name="FormatConfirmView" Spacing="8" IsVisible="False">
                <Border Background="{StaticResource HcCardBrush}"
                        BorderBrush="{StaticResource HcDangerBrush}"
                        BorderThickness="2"
                        CornerRadius="6"
                        Padding="12">
                  <StackPanel Spacing="6">
                    <TextBlock x:Name="FormatConfirmTarget" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="FormatConfirmDetail" Classes="caption" TextWrapping="Wrap" />
                    <TextBlock Text="Everything on this drive will be permanently erased."
                               Foreground="{StaticResource HcDangerBrush}"
                               TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
                <!-- Press-to-edit row, the same shape every other name field
                                 in the panel uses (tab editor, card rename): the current
                                 value lives on the row and the in-window keyboard owns
                                 the typing. A bare TextBox reads as broken on a controller,
                                 which is exactly how this one was reported. -->
                <c:ActionButton x:Name="FormatNameButton"
                              Click="OnFormatEditName"
                              IconGeometry="{x:Static c:Icons.CopyDoc}"
                              Title="Name (volume and Steam library)"
                              Description="Games" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button x:Name="FormatConfirmButton"
                          Classes="danger"
                          Content="Erase and format"
                          Click="OnFormatConfirmed" />
                  <Button Content="Cancel" Click="OnFormatCancel" />
                </StackPanel>
              </StackPanel>

              <!-- State 3: progress / done -->
              <StackPanel x:Name="FormatProgressView" Spacing="10" IsVisible="False">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <li:LoadingIndicator Mode="Ring"
                                       Width="22" Height="22"
                                       IsVisible="{Binding Busy}"
                                       VerticalAlignment="Center" />
                  <TextBlock Text="{Binding StatusText}"
                             TextWrapping="Wrap"
                             VerticalAlignment="Center" />
                </StackPanel>
                <Button x:Name="FormatDoneButton"
                        Content="Done"
                        Click="OnFormatCancel"
                        IsVisible="{Binding NotBusy}"
                        HorizontalAlignment="Stretch" />
              </StackPanel>
            </StackPanel>

            <!-- Self-drawing gamepad nested pages (see OverlaySubView); hidden
                         from the tab strip like PanelFormat, with the same
                         LB/RB-suppress + B-cancels wiring. Width-capped: they were
                         designed as single columns and read badly stretched across
                         the whole sheet. -->
            <ov:LibraryTabsView x:Name="LibraryTabsHost" IsVisible="False" HorizontalAlignment="Stretch" />
            <ov:CardManagerView x:Name="CardManagerHost" IsVisible="False" HorizontalAlignment="Stretch" />
            <ov:GameLibraryView x:Name="GameLibraryHost" IsVisible="False" HorizontalAlignment="Stretch" />
            <ov:LaunchWrapperView x:Name="LaunchWrapperHost" IsVisible="False" HorizontalAlignment="Stretch" />
            <ov:WakeLockHoldersView x:Name="WakeLockHost" IsVisible="False" HorizontalAlignment="Stretch" />

            <!-- Device RGB editor. It stages changes and commits once so persistent
                         firmware lighting is never written continuously while navigating. -->
            <ov:DeviceColorView x:Name="DeviceColorHost" IsVisible="False" HorizontalAlignment="Stretch" />

            <!-- Device destination. Plugin rows come from the closed semantic descriptor
                         vocabulary; WSGM-owned commands are separate view models. Packages cannot
                         provide markup, styles, URLs, or arbitrary commands through this surface. -->
            <StackPanel x:Name="PanelDevice" Spacing="12" MaxWidth="{StaticResource DeckContentMaxWidth}" HorizontalAlignment="Stretch"
                        IsVisible="False">
              <TextBlock x:Name="DeviceStatusTitle"
                         Text="Device integration"
                         FontSize="16"
                         FontWeight="SemiBold"
                         Margin="2,0,2,0" />
              <TextBlock x:Name="DeviceStatusDetail"
                         Text="Waiting for coordinator state"
                         Classes="caption"
                         TextWrapping="Wrap"
                         Margin="2,0,2,6" />
              <!-- A device package can arrive on an install that has no controller
                             support, because the Plugins folder is one an administrator can
                             copy a package file into. Without this the package simply does nothing and
                             nothing says why. Lives on the Device page because that is where a
                             person goes when their device is not working. -->
              <Border x:Name="DevicePrerequisiteBanner" Classes="device-group"
                      IsVisible="False" Margin="2,0,2,8">
                <StackPanel Spacing="8">
                  <TextBlock x:Name="DevicePrerequisiteDetail" TextWrapping="Wrap" />
                  <Button x:Name="DevicePrerequisiteEnable" Content="Enable Device Integration"
                          IsVisible="False" HorizontalAlignment="Stretch"
                          Click="OnEnableDeviceIntegration" />
                </StackPanel>
              </Border>
              <labs:FlexPanel x:Name="DevicePowerOverview" Wrap="Wrap" ColumnSpacing="12" RowSpacing="12" IsVisible="False">
                <Border x:Name="DevicePowerControlsCard" VerticalAlignment="Top"
                        MinWidth="280" labs:Flex.Grow="1">
                  <StackPanel Spacing="12">
                    <Border Classes="device-group" IsVisible="{Binding #DeviceWindowsPower.IsVisible}">
                      <StackPanel x:Name="DeviceWindowsPower" Spacing="8">
                        <StackPanel x:Name="DevicePowerSchemeHeading" />
                        <ov:PowerSchemeView x:Name="DevicePowerSchemeHost" />
                      </StackPanel>
                    </Border>
                    <Border Classes="device-group" IsVisible="{Binding #DevicePowerPresetContainer.IsVisible}">
                      <StackPanel x:Name="DevicePowerPresetContainer" IsVisible="False">
                        <ov:DevicePowerPresetView x:Name="DevicePowerPresetHost" IsVisible="False" />
                      </StackPanel>
                    </Border>
                    <Border Classes="device-group" IsVisible="{Binding #ManualTdpHost.IsVisible}">
                      <StackPanel x:Name="ManualTdpHost" IsVisible="False" />
                    </Border>
                  </StackPanel>
                </Border>
                <Border x:Name="DevicePerformanceCard" MinWidth="280" labs:Flex.Grow="1" Classes="device-group"
                        VerticalAlignment="Top">
                  <StackPanel x:Name="DevicePerformanceColumn" />
                </Border>
              </labs:FlexPanel>
              <StackPanel x:Name="DeviceCapabilityList" Spacing="12" />
              <Expander x:Name="DeviceWidgetsExpander" Header="Quick Access pins" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="8">
                  <TextBlock Text="Choose sections and widgets to show on Quick Access." Classes="caption" />
                  <StackPanel x:Name="DeviceSectionPinsHost" Spacing="8" />
                  <StackPanel x:Name="DeviceWidgetPinsHost" Spacing="8" />
                </StackPanel>
              </Expander>

              <!-- Windows power policy like the energy plan above, so it belongs here
                             rather than in WSGM Settings, and it stays available with device
                             integration off. Hidden on a CPU with one kind of core. -->
              <Expander x:Name="DeviceHybridCores" Header="Processor cores" IsVisible="False"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,12,0,0">
                <ov:HybridCoreView x:Name="DeviceHybridCoreHost" />
              </Expander>
            </StackPanel>

            <!-- Tools (the System destination): what is left once Steam, Device
                         and Power have their own destinations, as a menu of categories.
                         Performance and Plugins appear only when they have something in
                         them, which is resolved in code alongside their content. -->
            <UniformGrid x:Name="PanelSystem" Columns="2" IsVisible="False">
              <c:ActionButton Classes="tile" Click="OnEnterCategory"
                            CommandParameter="{x:Static ov:OverlayPage.SystemTools}"
                            Margin="0,0,10,10"
                            IconGeometry="{x:Static c:Icons.Gear}"
                            Title="System"
                            Description="WSGM Settings and the Windows Task Manager" />
              <c:ActionButton x:Name="SystemPerformanceTile" Classes="tile" Click="OnEnterCategory"
                            CommandParameter="{x:Static ov:OverlayPage.SystemPerformance}"
                            Margin="0,0,10,10"
                            IsVisible="False"
                            IconGeometry="{x:Static c:Icons.Grid4}"
                            Title="Performance"
                            Description="Frame limit, overlay and per-application profiles" />
              <c:ActionButton Classes="tile" Click="OnEnterCategory"
                            CommandParameter="{x:Static ov:OverlayPage.SystemStorage}"
                            Margin="0,0,10,10"
                            IconGeometry="{x:Static c:Icons.SdCard}"
                            Title="Storage"
                            Description="Eject an SD card or USB drive" />
              <c:ActionButton Classes="tile" Click="OnEnterCategory"
                            CommandParameter="{x:Static ov:OverlayPage.SystemDisplay}"
                            Margin="0,0,10,10"
                            IconGeometry="{x:Static c:Icons.Monitor}"
                            Title="Display"
                            Description="Panel brightness and display routes" />
              <c:ActionButton x:Name="SystemPluginsTile" Classes="tile" Click="OnEnterCategory"
                            CommandParameter="{x:Static ov:OverlayPage.SystemPlugins}"
                            Margin="0,0,10,10"
                            IsVisible="False"
                            IconGeometry="{x:Static c:Icons.Wrench}"
                            Title="Plugins"
                            Description="Controls published by the enabled common plugins" />
              <c:ActionButton Classes="tile" Click="OnEnterCategory"
                            CommandParameter="{x:Static ov:OverlayPage.SystemController}"
                            Margin="0,0,10,10"
                            IconGeometry="{x:Static c:Icons.BlockedCircle}"
                            Title="Controller ownership"
                            Description="The on-screen keyboard and the Steam Input handoff" />
            </UniformGrid>

            <StackPanel x:Name="PanelSystemTools" Spacing="10" IsVisible="False" HorizontalAlignment="Stretch">
              <TextBlock Text="SYSTEM" Classes="eyebrow" Margin="2,0,2,2" />
              <c:ActionButton Click="OnSettings"
                            Tag="system.settings"
                            IconGeometry="{x:Static c:Icons.Gear}"
                            Title="Settings"
                            Description="Shell, startup, and quick access configuration" />
              <c:ActionButton Click="OnTaskManager"
                            Tag="system.task-manager"
                            IconGeometry="{x:Static c:Icons.Grid4}"
                            Title="Task Manager"
                            Description="Processes and performance" />
            </StackPanel>

            <!-- One shared performance projection is reparented into Device while
                         integration is visible and lives on this page otherwise. Its source owns
                         RTSS lifetime and state; this window only observes and invokes rows. -->
            <StackPanel x:Name="PanelSystemPerformance" Spacing="10" IsVisible="False"
                        HorizontalAlignment="Stretch">
              <StackPanel x:Name="PerformanceSection" Spacing="4" IsVisible="False">
                <TextBlock Text="PERFORMANCE" Classes="eyebrow" Margin="2,0,2,2" />
                <TextBlock x:Name="PerformanceStatus"
                           Classes="caption"
                           TextWrapping="Wrap"
                           Margin="2,0,2,2" />
                <StackPanel x:Name="PerformanceRows" Spacing="4" />
              </StackPanel>
            </StackPanel>

            <StackPanel x:Name="PanelSystemStorage" Spacing="10" IsVisible="False"
                        HorizontalAlignment="Stretch">
              <TextBlock Text="STORAGE" Classes="eyebrow" Margin="2,0,2,2" />
              <c:ActionButton Click="OnEjectTileClicked"
                            Tag="system.eject"
                            IconGeometry="{x:Static c:Icons.Eject}"
                            Title="Safely remove hardware"
                            Description="Eject an SD card or USB drive" />
            </StackPanel>

            <StackPanel x:Name="PanelSystemDisplay" Spacing="10" IsVisible="False"
                        HorizontalAlignment="Stretch">
              <TextBlock Text="DISPLAY" Classes="eyebrow" Margin="2,0,2,2" />
              <StackPanel x:Name="DisplayBrightnessHost" />
            </StackPanel>

            <StackPanel x:Name="PanelSystemPlugins" Spacing="10" IsVisible="False"
                        HorizontalAlignment="Stretch">
              <TextBlock Text="PLUGINS" Classes="eyebrow" Margin="2,0,2,2" />
              <StackPanel x:Name="CommonPluginRows" Spacing="8" />
            </StackPanel>

            <StackPanel x:Name="PanelSystemController" Spacing="10" IsVisible="False"
                        HorizontalAlignment="Stretch">
              <TextBlock Text="CONTROLLER OWNERSHIP" Classes="eyebrow" Margin="2,0,2,2" />
              <c:ActionButton Title="On-Screen Keyboard" Click="OnScreenKeyboard"
                            Tag="system.keyboard" Description="Open the keyboard for the current mode" />
              <TextBlock x:Name="SteamOwnershipStatus" Text="Unavailable" Classes="caption" />
              <c:ActionButton x:Name="ReleaseSteamOwnership" Title="Release to Steam"
                            Tag="system.release-steam" IsEnabled="False" />
              <c:ActionButton x:Name="ReacquireSteamOwnership" Title="Reacquire for WSGM"
                            Tag="system.reacquire-steam" IsEnabled="False" />
            </StackPanel>

            <!-- Power: wake, idle timeouts, and the session-ending actions as
                         three categories. Each timeout row cycles its preset; the trailing
                         badge is the current value read live from the active power
                         scheme. The two-step confirms rewrite Title ("Really?") from
                         code-behind, same auto-revert as before. -->
            <UniformGrid x:Name="PanelPower" Columns="2" IsVisible="False">
              <c:ActionButton Classes="tile" Click="OnEnterCategory"
                            CommandParameter="{x:Static ov:OverlayPage.PowerWake}"
                            Margin="0,0,10,10"
                            IconGeometry="{x:Static c:Icons.Mug}"
                            Title="Wake"
                            Description="Keep Awake and what is holding a wake lock" />
              <c:ActionButton Classes="tile" Click="OnEnterCategory"
                            CommandParameter="{x:Static ov:OverlayPage.PowerTimeouts}"
                            Margin="0,0,10,10"
                            IconGeometry="{x:Static c:Icons.Moon}"
                            Title="Idle timeouts"
                            Description="Screen off and standby, on battery and plugged in" />
              <c:ActionButton Classes="tile" Click="OnEnterCategory"
                            CommandParameter="{x:Static ov:OverlayPage.PowerActions}"
                            Margin="0,0,10,10"
                            IconGeometry="{x:Static c:Icons.Power}"
                            Title="Power"
                            Description="Standby, hibernate, restart and shut down" />
              <c:ActionButton Classes="tile" Click="OnEnterCategory"
                            CommandParameter="{x:Static ov:OverlayPage.PowerSession}"
                            Margin="0,0,10,10"
                            IconGeometry="{x:Static c:Icons.Play}"
                            Title="Session"
                            Description="Big Picture, the desktop, and quitting Steam" />
            </UniformGrid>

            <!-- Session: the former root tab, now a Power category. The four rows keep
                         their names, tags and handlers so pins and focus keys are unchanged. -->
            <StackPanel x:Name="PanelPowerSession" Spacing="10" IsVisible="False" HorizontalAlignment="Stretch">
              <TextBlock Text="SESSION" Classes="eyebrow" Margin="2,0,2,2" />
              <c:ActionButton x:Name="HomeAppButton" Classes="primary" Click="OnHomeApp"
                            Tag="home.steam"
                            IconGeometry="{x:Static c:Icons.Play}"
                            Title="{Binding HomeAppButtonText}"
                            Description="Open Steam Big Picture"
                            TrailingText="A" />
              <c:ActionButton x:Name="DesktopButton" Click="OnDesktop"
                            Tag="home.desktop"
                            IconGeometry="{x:Static c:Icons.Monitor}"
                            Title="{Binding DesktopButtonText}"
                            Description="Show or hide the Windows desktop"
                            IsVisible="{Binding ModeSwitchAvailable}" />
              <c:ActionButton x:Name="ExitBigPictureButton" Click="OnExitBigPicture"
                            Tag="home.exit-big-picture"
                            IconGeometry="{x:Static c:Icons.ExitFullscreen}"
                            Title="Exit Big Picture"
                            Description="Switch Steam to its desktop window" />
              <c:ActionButton x:Name="CloseLauncherButton" Click="OnCloseLauncher"
                            Tag="home.close-steam"
                            IsVisible="{Binding HomeAppAlive}"
                            IconGeometry="{x:Static c:Icons.Close}"
                            Title="{Binding CloseLauncherText}"
                            Description="Quit Steam completely" />
            </StackPanel>

            <StackPanel x:Name="PanelPowerWake" Spacing="10" IsVisible="False" HorizontalAlignment="Stretch">
              <TextBlock Text="WAKE" Classes="eyebrow" Margin="2,0,2,2" />
              <StackPanel x:Name="KeepAwakeHost" IsVisible="{Binding ShowKeepAwake}" Spacing="8">
                <TextBlock x:Name="KeepAwakeDetail" Classes="caption" TextWrapping="Wrap" />
              </StackPanel>
              <c:ActionButton Click="OnShowWakeLockHolders"
                            Tag="system.wake-locks"
                            IconGeometry="{x:Static c:Icons.ListLines}"
                            Title="What's keeping this awake"
                            Description="List the programs holding a wake lock" />
            </StackPanel>

            <StackPanel x:Name="PanelPowerTimeouts" Spacing="10" IsVisible="False"
                        HorizontalAlignment="Stretch">
              <TextBlock Text="IDLE TIMEOUTS" Classes="eyebrow" Margin="2,0,2,2" />
              <StackPanel x:Name="PowerTimeoutEditors" Spacing="8" />
            </StackPanel>

            <StackPanel x:Name="PanelPowerActions" Spacing="8" IsVisible="False" HorizontalAlignment="Stretch">
              <Button Content="Open power menu" Classes="deck-action" Click="OnOpenPowerMenu" />
              <c:ActionButton x:Name="SignOutButton" Title="Sign out" Description="End the current Windows session"
                              IconGeometry="{x:Static c:Icons.SignOut}"
                              Click="OnSignOut" />
              <TextBlock Text="POWER" Classes="eyebrow" Margin="2,0,2,2" />
              <c:ActionButton Click="OnStandby"
                            Tag="system.standby"
                            IconGeometry="{x:Static c:Icons.Moon}"
                            Title="Standby"
                            Description="Suspend to RAM and resume where you left off" />
              <c:ActionButton Click="OnHibernate"
                            Tag="system.hibernate"
                            IconGeometry="{x:Static c:Icons.Snowflake}"
                            Title="Hibernate"
                            Description="Save the session to disk and power off" />
              <c:ActionButton x:Name="RestartButton" Click="OnRestart"
                            Tag="system.restart"
                            IconGeometry="{x:Static c:Icons.Restart}"
                            Title="Restart"
                            Description="Restart Windows" />
              <c:ActionButton x:Name="ShutdownButton" Classes="danger" Click="OnShutdown"
                            Tag="system.shutdown"
                            IconGeometry="{x:Static c:Icons.Power}"
                            Title="Shut down"
                            Description="Turn off this device" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
          </Border>
        </Grid>


        <!-- Pin feedback toast (mock: PinFlow): floats over the content just above
                 the Open apps strip; hit-test transparent so it can never trap focus. -->
        <Border x:Name="PinToast"
                Grid.Row="2"
                IsVisible="False"
                IsHitTestVisible="False"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,10"
                Height="40"
                Padding="16,0"
                CornerRadius="10"
                Background="{StaticResource HcCardHoverBrush}"
                BorderBrush="{StaticResource DeckDividerBrush}"
                BorderThickness="1"
                BoxShadow="0 10 30 0 #73000000">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock x:Name="PinToastText" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock x:Name="PinToastHint" Classes="caption" VerticalAlignment="Center" />
          </StackPanel>
        </Border>

        <!-- Open apps: the former taskbar's tile strip as a chip row pinned to
                 the sheet bottom. Chips keep a fixed height at every count and the
                 strip scrolls sideways once they no longer fit; a chip keeps its
                 place as windows open and close (reconcile-in-place). Controller
                 focus is scrolled into view explicitly (OnStripGotFocus). -->
        <Border Grid.Row="3" x:Name="AppsStrip" DataContext="{x:Null}" x:DataType="ov:AppSwitcherViewModel"
                BorderBrush="{StaticResource DeckDividerBrush}" BorderThickness="0,1,0,0" Padding="24,8" Background="{StaticResource DeckRailBrush}">
          <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
            <TextBlock Text="OPEN APPS" Classes="eyebrow" VerticalAlignment="Center" />
            <ScrollViewer Grid.Column="1"
                          x:Name="TileScroller"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled"
                          AllowAutoHide="True"
                          VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <TextBlock Text="No open apps"
                           Classes="caption"
                           VerticalAlignment="Center"
                           Margin="4,0"
                           IsVisible="{Binding !HasEntries}" />
                <ItemsControl x:Name="AppTiles" ItemsSource="{Binding Entries}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="10" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="ov:AppSwitcherEntry">
                      <Button Classes="app-chip"
                              Classes.active="{Binding IsActive}"
                              Classes.minimized="{Binding IsMinimized}"
                              Click="OnPickWindow"
                              ToolTip.Tip="{Binding Title}">
                        <Panel>
                          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Panel Width="18" Height="18" VerticalAlignment="Center">
                              <Image Source="{Binding Icon}" Width="18" Height="18" />
                              <!-- Fallback glyph when no icon could be resolved. -->
                              <TextBlock Text="▢" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                         IsVisible="{Binding HasNoIcon}" />
                            </Panel>
                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" MaxWidth="150"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                          </StackPanel>
                          <Border Classes="active-indicator" Height="3" CornerRadius="1.5" VerticalAlignment="Bottom"
                                  Margin="0,0,0,-4" />
                        </Panel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
                          <ScrollViewer Grid.Column="2" Margin="12,0,0,0" x:Name="TrayScroller" DataContext="{x:Null}"
                            x:DataType="ov:AppSwitcherViewModel"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollBarVisibility="Disabled"
                            AllowAutoHide="True"
                            VerticalAlignment="Center"
                            IsVisible="{Binding HasTrayIcons}">
                <ItemsControl ItemsSource="{Binding TrayIcons}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="2" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="ov:TrayIconEntry">
                      <Button Classes="pill tray"
                              Click="OnTrayClick"
                              PointerReleased="OnTrayPointerReleased"
                              AutomationProperties.Name="{Binding Tip}"
                              ToolTip.Tip="{Binding Tip}">
                        <Image Source="{Binding Image}" Width="18" Height="18" />
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>

            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center"
                        IsVisible="{Binding HasEntries}">
              <ov:GlyphIcon Width="18" Height="18" Button="y"
                            GlyphStyle="{Binding $parent[Window].((ov:OverlayViewModel)DataContext).GlyphStyle, FallbackValue=Xbox}"
                            VerticalAlignment="Center" />
              <TextBlock Text="Next app" Classes="caption" VerticalAlignment="Center" />
            </StackPanel>
          </Grid>
        </Border>

        <Border Grid.Row="4" Background="{StaticResource DeckRailBrush}" Padding="24,8">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <StackPanel Orientation="Horizontal" Spacing="17">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <ov:GlyphIcon Width="18" Height="18" Button="a" GlyphStyle="{Binding GlyphStyle}"
                              VerticalAlignment="Center" />
                <TextBlock Text="Select" Classes="caption" VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="5">
                <ov:GlyphIcon Width="18" Height="18" Button="b" GlyphStyle="{Binding GlyphStyle}"
                              VerticalAlignment="Center" />
                <TextBlock Text="Back" Classes="caption" VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="5">
                <ov:GlyphIcon Width="18" Height="18" Button="x" GlyphStyle="{Binding GlyphStyle}"
                              VerticalAlignment="Center" />
                <TextBlock Text="Pin to Quick access" Classes="caption" VerticalAlignment="Center" />
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14">
              <TextBlock Text="LT/RT  Destination" Classes="caption" VerticalAlignment="Center" />
              <TextBlock Text="D-pad  Navigate" Classes="caption" VerticalAlignment="Center" />
              <TextBlock Text="B / Esc  Back" Classes="caption" VerticalAlignment="Center" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </LayoutTransformControl>

  <Window.Styles>
    <!-- Header status pills: compact rounded buttons. The local BorderBrush
             wins the equal-specificity tie against Shared.axaml's Button:focus-visible, so
             the accent focus border is restated here (same workaround as
             TabStripTheme) — otherwise a focused pill would have no cue. -->
    <Style Selector="Button.pill">
      <Setter Property="MinWidth" Value="44" />
      <Setter Property="Height" Value="44" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="Background" Value="{StaticResource DeckGroupBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource HcCardBorderBrush}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.pill:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource HcAccentBrush}" />
    </Style>
    <Style Selector="Button.pill:pointerover">
      <Setter Property="Background" Value="{StaticResource DeckHoverBrush}" />
    </Style>
    <Style Selector="Button.pill.tray">
      <Setter Property="MinWidth" Value="44" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.pill.tray:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource HcAccentBrush}" />
    </Style>
    <Style Selector="Button.pill.close">
      <Setter Property="Foreground" Value="{StaticResource HcTextMutedBrush}" />
      <Setter Property="FontSize" Value="16" />
    </Style>
    <Style Selector="Button.pill.close:focus-visible">
      <Setter Property="Foreground" Value="{StaticResource HcTextPrimaryBrush}" />
    </Style>
    <!-- Read-only pills (battery, clock) share the shape without a focus stop. -->
    <Style Selector="Border.pill-static">
      <Setter Property="Height" Value="44" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="Background" Value="{StaticResource DeckGroupBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource HcCardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <!-- Stroke-rendered like the TabStrip icons: the Icons geometries are
             stroke-style, filling them collapses interior detail. -->
    <Style Selector="Path.status-icon">
      <Setter Property="Fill" Value="{x:Null}" />
      <Setter Property="Stroke" Value="{StaticResource HcTextMutedBrush}" />
      <Setter Property="StrokeThickness" Value="1.5" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="StrokeLineCap" Value="Round" />
    </Style>

    <!-- Open apps chips: fixed 40 px height, card background, accent
             underline when the window is foreground, dimmed when minimized. -->
    <Style Selector="Button.app-chip">
      <Setter Property="Height" Value="48" />
      <Setter Property="Padding" Value="10,0,12,0" />
      <Setter Property="Background" Value="{StaticResource DeckGroupBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.app-chip:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource HcAccentBrush}" />
    </Style>
    <Style Selector="Button.app-chip:pointerover">
      <Setter Property="Background" Value="{StaticResource DeckHoverBrush}" />
    </Style>
    <Style Selector="Button.app-chip.minimized Image">
      <Setter Property="Opacity" Value="0.5" />
    </Style>
    <Style Selector="Button.app-chip.minimized TextBlock">
      <Setter Property="Opacity" Value="0.5" />
    </Style>
    <Style Selector="Button.app-chip Border.active-indicator">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.app-chip.active Border.active-indicator">
      <Setter Property="Background" Value="{DynamicResource HcAccentBrush}" />
    </Style>
  </Window.Styles>
</Window>

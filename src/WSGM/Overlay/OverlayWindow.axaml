<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ov="using:WSGM.Overlay"
        xmlns:c="using:WSGM.Controls"
        xmlns:sh="using:WSGM.Shell"
        xmlns:fa="using:FluentAvalonia.UI.Controls"
        xmlns:labs="using:Avalonia.Labs.Panels"
        x:Class="WSGM.Overlay.OverlayWindow"
        x:DataType="ov:OverlayViewModel"
        Title="WSGM Quick Access"
        Width="1280"
        Height="800"
        Classes="command-deck"
        TransparencyLevelHint="Transparent"
        TransparencyBackgroundFallback="{StaticResource DeckCanvasBrush}"
        WindowDecorations="None"
        CanResize="False"
        Topmost="True"
        ShowInTaskbar="False"
        Background="Transparent">

  <!-- Fullscreen live glass. The fixed close control is always reachable. -->
  <LayoutTransformControl x:Name="RootScale">
    <Grid x:Name="SurfaceRoot">
      <Border x:Name="GlassCanvas" Background="{StaticResource DeckCanvasBrush}" />
      <Grid x:Name="DeckContent" RowDefinitions="Auto,Auto,*,Auto,Auto">
        <Border Grid.Row="0" x:Name="Header" Background="{StaticResource DeckRailBrush}"
                BorderBrush="{StaticResource DeckDividerBrush}" BorderThickness="0,0,0,1" Padding="24,0" Height="72">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
              <Button x:Name="BackButton" Classes="pill" IsVisible="False" AutomationProperties.Name="Back"
                      ToolTip.Tip="Back" Click="OnHeaderBack">
                <Path Classes="status-icon" Data="{x:Static c:Icons.ArrowLeft}" Width="18" Stretch="Uniform" />
              </Button>
              <TextBlock Text="WSGM" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
              <Border Width="1" Height="24" Background="{StaticResource DeckDividerBrush}" />
              <StackPanel Spacing="2" Width="176" VerticalAlignment="Center">
                <TextBlock x:Name="ProfileContext" Text="Profile" FontSize="11"
                           Foreground="{StaticResource DeckSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                <ComboBox x:Name="HeaderProfile" SelectedIndex="0" IsEnabled="False"
                          HorizontalAlignment="Stretch" AutomationProperties.Name="Settings profile"
                          ToolTip.Tip="Start or focus an application to give it separate settings.">
                  <ComboBoxItem Content="Global" />
                  <ComboBoxItem Content="Per-application" />
                </ComboBox>
              </StackPanel>
              <Button x:Name="ManageProfiles" Classes="pill" AutomationProperties.Name="Manage application profiles"
                      ToolTip.Tip="Manage application profiles" Click="OnManageProfiles">
                <Path Classes="status-icon" Data="{x:Static c:Icons.ListLines}" Width="18" Stretch="Uniform" />
              </Button>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <StackPanel x:Name="StatusZone" DataContext="{x:Null}" x:DataType="sh:SystemStatus"
                          Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button x:Name="WifiButton"
                        Classes="pill"
                        AutomationProperties.Name="Wi-Fi settings"
                        ToolTip.Tip="Wi-Fi"
                        Click="OnRadioTileClicked"
                        Tag="wifi">
                  <!-- Drawn, not a static path: the pill distinguishes
                                     off / disconnected / connected and shows signal
                                     strength, which one glyph cannot express. -->
                  <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                    <c:RadioIcon Width="18" Height="18"
                                 State="{Binding Radios.WifiIconState}"
                                 Signal="{Binding Radios.Wifi.Signal}"
                                 Accent="{DynamicResource HcAccentBrush}"
                                 Muted="{StaticResource HcTextPrimaryBrush}"
                                 VerticalAlignment="Center" />
                    <Border Classes="header-detail">
                    <TextBlock x:Name="WifiLabel" Text="{Binding Radios.Wifi.ConnectedSsid}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               MaxWidth="90"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               IsVisible="{Binding Radios.Wifi.Connected}" />
                    </Border>
                  </StackPanel>
                </Button>
<Button x:Name="BluetoothButton"
                        Classes="pill"
                        AutomationProperties.Name="Bluetooth settings"
                        ToolTip.Tip="Bluetooth"
                        Click="OnRadioTileClicked"
                        Tag="bluetooth">
                  <c:RadioIcon Width="18" Height="18"
                               Bluetooth="True"
                               State="{Binding Radios.BluetoothIconState}"
                               Accent="{DynamicResource HcAccentBrush}"
                               Muted="{StaticResource HcTextPrimaryBrush}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center" />
                </Button>
                <Border Width="1" Height="24" Background="{StaticResource DeckDividerBrush}" Margin="6,0" />
                <Button x:Name="AudioButton"
                        Classes="pill"
                        AutomationProperties.Name="Audio settings"
                        ToolTip.Tip="{Binding Audio.VolumeText}"
                        Click="OnAudioTileClicked">
                  <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                    <Path Classes="status-icon" Data="{x:Static c:Icons.Volume}" Width="18" Stretch="Uniform"
                          VerticalAlignment="Center" />
                    <Border Classes="header-detail">
                    <TextBlock x:Name="VolumeLabel" Text="{Binding Audio.VolumeText}" FontSize="12" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    </Border>
                  </StackPanel>
                </Button>
                <Button x:Name="BrightnessButton" Classes="pill" AutomationProperties.Name="Display brightness"
                        ToolTip.Tip="Display brightness" Click="OnHeaderBrightness">
                  <Path Classes="status-icon" Data="{x:Static c:Icons.Sun}" Width="20" Stretch="Uniform" />
                </Button>
                <Button x:Name="EjectButton"
                        Classes="pill"
                        AutomationProperties.Name="Safely remove hardware"
                        ToolTip.Tip="Safely remove hardware"
                        IsVisible="{Binding Drives.HasDrives}"
                        Click="OnEjectTileClicked">
                  <Path Classes="status-icon" Data="{x:Static c:Icons.Eject}" Width="16" Stretch="Uniform"
                        VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Button>
                <Border Width="1" Height="24" Background="{StaticResource DeckDividerBrush}" Margin="6,0" />
                <Button x:Name="KeyboardButton" Classes="pill" AutomationProperties.Name="On-screen keyboard"
                        ToolTip.Tip="On-screen keyboard" Click="OnScreenKeyboard">
                  <Path Classes="status-icon" Data="{x:Static c:Icons.Keyboard}" Width="20" Stretch="Uniform" />
                </Button>
                <Border x:Name="BatteryStatus" Classes="pill-static" IsVisible="{Binding HasBattery}">
                  <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Path Classes="status-icon" Data="{x:Static c:Icons.Battery}" Width="20" Stretch="Uniform" VerticalAlignment="Center" />
                    <TextBlock x:Name="BatteryLabel" Text="{Binding BatteryText}" FontSize="13" VerticalAlignment="Center" />
                  </StackPanel>
                </Border>
                <TextBlock x:Name="ClockLabel" Text="{Binding ClockText}" FontSize="15" FontWeight="SemiBold" Margin="8,0"
                           VerticalAlignment="Center" />
              </StackPanel>
              <Border Width="1" Height="28" Background="{StaticResource DeckDividerBrush}" Margin="4,0" />
              <Button x:Name="CloseButton" Classes="pill close" Content="×" Click="OnClose"
                      AutomationProperties.Name="Close quick access" ToolTip.Tip="Close quick access" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- Tab descriptors (labels + Icons geometries) are assigned in
                 code-behind; LB/RB cycle via GamepadNavigation. -->
        <Border Grid.Row="1" Background="{StaticResource DeckRailBrush}"
                BorderBrush="{StaticResource DeckDividerBrush}" BorderThickness="0,0,0,1" Padding="16,0">
          <c:TabStrip x:Name="Tabs" Classes="sheet" />
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="240,*" ColumnSpacing="{StaticResource DeckSectionGap}" Margin="{StaticResource DeckWorkspaceMargin}"
              MaxWidth="{StaticResource DeckContentMaxWidth}" HorizontalAlignment="Stretch">
          <Border Background="{StaticResource DeckRailBrush}" CornerRadius="{StaticResource DeckGroupRadius}" Padding="{StaticResource DeckPanePadding}">
            <Grid RowDefinitions="Auto,*" RowSpacing="{StaticResource DeckSectionGap}">
              <StackPanel Spacing="6" Margin="8,8,8,0">
                <TextBlock x:Name="WorkspaceTitle" Text="Quick access" FontSize="26" FontWeight="SemiBold" />
                <TextBlock x:Name="WorkspaceDescription" Text="Your pinned controls and widgets" Classes="caption" TextWrapping="Wrap" />
              </StackPanel>
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" GotFocus="OnContentGotFocus">
                <StackPanel x:Name="SectionRail" Spacing="4" />
              </ScrollViewer>
            </Grid>
          </Border>
          <Border Grid.Column="1" Background="{StaticResource DeckControlsBrush}" CornerRadius="{StaticResource DeckGroupRadius}">
        <ScrollViewer x:Name="ContentScroller"
                      VerticalScrollBarVisibility="Auto"
                      GotFocus="OnContentGotFocus">
          <StackPanel Margin="{StaticResource DeckPanePadding}" Spacing="{StaticResource DeckSectionGap}">
            <!-- Panel-level warning: sits above the destination roots, so it
                         is visible on every one. -->
            <fa:FAInfoBar IsOpen="{Binding HasWarning}" Title="WSGM" Message="{Binding WarningText}" Severity="Warning"
                          IsClosable="False" Margin="0,0,0,4" />

            <!-- Quick access combines action cards, complete pinned sections and widgets.
                         Section headers own pinning; their controls keep normal editing behavior. -->
            <StackPanel x:Name="PanelQuickAccess" Spacing="12" IsVisible="True">
              <UniformGrid x:Name="PinnedGrid" Columns="2" />
              <StackPanel x:Name="PinnedSectionsGrid" Spacing="12" />
              <StackPanel x:Name="PinnedPluginWidgetsHost" Spacing="8" />
            </StackPanel>

            <ov:SteamLibraryPage x:Name="PanelSteamLibrary" IsVisible="False" HorizontalAlignment="Stretch" />

            <ov:LaunchFixesPage x:Name="PanelSteamLaunch" IsVisible="False" HorizontalAlignment="Stretch" />

            <!-- The format flow, in place so the controller reaches it; hidden from the tab strip. -->
            <ov:StorageFormatView x:Name="StorageFormatHost" IsVisible="False" HorizontalAlignment="Stretch" />

            <!-- Self-drawing gamepad nested pages (see OverlaySubView); hidden
                         from the tab strip like StorageFormatHost, with the same
                         LB/RB-suppress + B-cancels wiring. Width-capped: they were
                         designed as single columns and read badly stretched across
                         the whole sheet. -->
            <ov:LibraryTabsView x:Name="LibraryTabsHost" IsVisible="False" HorizontalAlignment="Stretch" />
            <ov:CardManagerView x:Name="CardManagerHost" IsVisible="False" HorizontalAlignment="Stretch" />
            <ov:GameLibraryView x:Name="GameLibraryHost" IsVisible="False" HorizontalAlignment="Stretch" />
            <ov:ProgramsView x:Name="ProgramsHost" IsVisible="False" HorizontalAlignment="Stretch" />
            <ov:NotesView x:Name="NotesHost" IsVisible="False" HorizontalAlignment="Stretch" />
            <ov:BrowserView x:Name="BrowserHost" IsVisible="False" HorizontalAlignment="Stretch" />
            <ov:ScreensaversView x:Name="ScreensaversHost" IsVisible="False" HorizontalAlignment="Stretch" />
            <ov:EmulatorManagerView x:Name="EmulatorManagerHost" IsVisible="False"
                                HorizontalAlignment="Stretch" />
            <ov:ArtworkView x:Name="ArtworkHost" IsVisible="False" />
            <ov:ThemesView x:Name="ThemesHost" IsVisible="False" HorizontalAlignment="Stretch" />
            <ov:AnimationsView x:Name="AnimationsHost" IsVisible="False" HorizontalAlignment="Stretch" />
            <ov:LaunchWrapperView x:Name="LaunchWrapperHost" IsVisible="False" HorizontalAlignment="Stretch" />
            <ov:GameToolsView x:Name="GameToolsHost" IsVisible="False" HorizontalAlignment="Stretch" />
            <ov:WakeLockHoldersView x:Name="WakeLockHost" IsVisible="False" HorizontalAlignment="Stretch" />

            <!-- Device RGB editor. It stages changes and commits once so persistent
                         firmware lighting is never written continuously while navigating. -->
            <ov:DeviceColorView x:Name="DeviceColorHost" IsVisible="False" HorizontalAlignment="Stretch" />

            <!-- Device destination: the Overview, the section pages and the GPU page, each drawn from its
                         description. Plugin rows come from the closed semantic descriptor vocabulary;
                         packages cannot provide markup, styles, URLs, or arbitrary commands here. -->
            <ov:DevicePageView x:Name="DevicePage" IsVisible="False" />

            <ov:SystemToolsPage x:Name="PanelSystemTools" IsVisible="False" HorizontalAlignment="Stretch" />

            <!-- The shared performance rows live here while there is no Device destination to hold them. -->
            <ov:PerformancePage x:Name="PanelSystemPerformance" Spacing="10" IsVisible="False"
                                HorizontalAlignment="Stretch" />

            <ov:StoragePage x:Name="PanelSystemStorage" IsVisible="False" HorizontalAlignment="Stretch" />

            <ov:DisplayPage x:Name="PanelSystemDisplay" IsVisible="False" HorizontalAlignment="Stretch" />

            <ov:AboutPage x:Name="PanelSystemAbout" IsVisible="False" HorizontalAlignment="Stretch" />

            <ov:PluginsPage x:Name="PanelSystemPlugins" IsVisible="False" HorizontalAlignment="Stretch" />

            <ov:SoundsView x:Name="SoundsHost" IsVisible="False" />

            <ov:KeyboardPage x:Name="PanelSystemController" IsVisible="False" HorizontalAlignment="Stretch" />

            <ov:PowerSessionPage x:Name="PanelPowerSession" IsVisible="False" HorizontalAlignment="Stretch" />

            <ov:PowerWakePage x:Name="PanelPowerWake" IsVisible="False" HorizontalAlignment="Stretch" />

            <ov:PowerTimeoutsPage x:Name="PanelPowerTimeouts" IsVisible="False" HorizontalAlignment="Stretch" />

            <ov:PowerActionsPage x:Name="PanelPowerActions" IsVisible="False" HorizontalAlignment="Stretch" />
          </StackPanel>
        </ScrollViewer>
          </Border>
        </Grid>


        <!-- Pin feedback toast (mock: PinFlow): floats over the content just above
                 the Open apps strip; hit-test transparent so it can never trap focus. -->
        <Border x:Name="PinToast"
                Grid.Row="2"
                IsVisible="False"
                IsHitTestVisible="False"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,10"
                Height="40"
                Padding="16,0"
                CornerRadius="10"
                Background="{StaticResource HcCardHoverBrush}"
                BorderBrush="{StaticResource DeckDividerBrush}"
                BorderThickness="1"
                BoxShadow="0 10 30 0 #73000000">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock x:Name="PinToastText" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock x:Name="PinToastHint" Classes="caption" VerticalAlignment="Center" />
          </StackPanel>
        </Border>

        <!-- Open apps: the former taskbar's tile strip as a chip row pinned to
                 the sheet bottom. Chips keep a fixed height at every count and the
                 strip scrolls sideways once they no longer fit; a chip keeps its
                 place as windows open and close (reconcile-in-place). Controller
                 focus is scrolled into view explicitly (OnStripGotFocus). -->
        <Border Grid.Row="3" x:Name="AppsStrip" DataContext="{x:Null}" x:DataType="ov:AppSwitcherViewModel"
                BorderBrush="{StaticResource DeckDividerBrush}" BorderThickness="0,1,0,0" Padding="24,8" Background="{StaticResource DeckRailBrush}">
          <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
            <TextBlock Text="OPEN APPS" Classes="eyebrow" VerticalAlignment="Center" />
            <ScrollViewer Grid.Column="1"
                          x:Name="TileScroller"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled"
                          AllowAutoHide="True"
                          VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <TextBlock Text="No open apps"
                           Classes="caption"
                           VerticalAlignment="Center"
                           Margin="4,0"
                           IsVisible="{Binding !HasEntries}" />
                <ItemsControl x:Name="AppTiles" ItemsSource="{Binding Entries}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="10" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="ov:AppSwitcherEntry">
                      <Button Classes="app-chip"
                              Classes.active="{Binding IsActive}"
                              Classes.minimized="{Binding IsMinimized}"
                              Click="OnPickWindow"
                              ToolTip.Tip="{Binding Title}">
                        <Panel>
                          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Panel Width="18" Height="18" VerticalAlignment="Center">
                              <Image Source="{Binding Icon}" Width="18" Height="18" />
                              <!-- Fallback glyph when no icon could be resolved. -->
                              <TextBlock Text="▢" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                         IsVisible="{Binding HasNoIcon}" />
                            </Panel>
                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" MaxWidth="150"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                          </StackPanel>
                          <Border Classes="active-indicator" Height="3" CornerRadius="1.5" VerticalAlignment="Bottom"
                                  Margin="0,0,0,-4" />
                        </Panel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
                          <ScrollViewer Grid.Column="2" Margin="12,0,0,0" x:Name="TrayScroller" DataContext="{x:Null}"
                            x:DataType="ov:AppSwitcherViewModel"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollBarVisibility="Disabled"
                            AllowAutoHide="True"
                            VerticalAlignment="Center"
                            IsVisible="{Binding HasTrayIcons}">
                <ItemsControl ItemsSource="{Binding TrayIcons}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="2" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="ov:TrayIconEntry">
                      <Button Classes="pill tray"
                              Click="OnTrayClick"
                              PointerReleased="OnTrayPointerReleased"
                              AutomationProperties.Name="{Binding Tip}"
                              ToolTip.Tip="{Binding Tip}">
                        <Image Source="{Binding Image}" Width="18" Height="18" />
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>

            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center"
                        IsVisible="{Binding HasEntries}">
              <ov:GlyphIcon Width="18" Height="18" Button="y"
                            GlyphStyle="{Binding $parent[Window].((ov:OverlayViewModel)DataContext).GlyphStyle, FallbackValue=Xbox}"
                            VerticalAlignment="Center" />
              <TextBlock Text="Next app" Classes="caption" VerticalAlignment="Center" />
            </StackPanel>
          </Grid>
        </Border>

        <Border Grid.Row="4" Background="{StaticResource DeckRailBrush}" Padding="24,8">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <StackPanel Orientation="Horizontal" Spacing="17">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <ov:GlyphIcon Width="18" Height="18" Button="a" GlyphStyle="{Binding GlyphStyle}"
                              VerticalAlignment="Center" />
                <TextBlock Text="Select" Classes="caption" VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="5">
                <ov:GlyphIcon Width="18" Height="18" Button="b" GlyphStyle="{Binding GlyphStyle}"
                              VerticalAlignment="Center" />
                <TextBlock Text="Back" Classes="caption" VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="5">
                <ov:GlyphIcon Width="18" Height="18" Button="x" GlyphStyle="{Binding GlyphStyle}"
                              VerticalAlignment="Center" />
                <TextBlock Text="Pin to Quick access" Classes="caption" VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="5" IsVisible="{Binding #EmulatorManagerHost.IsVisible}">
                <ov:GlyphIcon Width="18" Height="18" Button="y" GlyphStyle="{Binding GlyphStyle}"
                              VerticalAlignment="Center" />
                <TextBlock Text="Check for updates" Classes="caption" VerticalAlignment="Center" />
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14">
              <TextBlock Text="LT/RT  Destination" Classes="caption" VerticalAlignment="Center" />
              <TextBlock Text="D-pad  Navigate" Classes="caption" VerticalAlignment="Center" />
              <TextBlock Text="B / Esc  Back" Classes="caption" VerticalAlignment="Center" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </LayoutTransformControl>

  <Window.Styles>
    <!-- Header status pills: compact rounded buttons. The local BorderBrush
             wins the equal-specificity tie against Shared.axaml's Button:focus-visible, so
             the accent focus border is restated here (same workaround as
             TabStripTheme) — otherwise a focused pill would have no cue. -->
    <Style Selector="Button.pill">
      <Setter Property="MinWidth" Value="44" />
      <Setter Property="Height" Value="44" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="Background" Value="{StaticResource DeckGroupBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource HcCardBorderBrush}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.pill:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource HcAccentBrush}" />
    </Style>
    <Style Selector="Button.pill:pointerover">
      <Setter Property="Background" Value="{StaticResource DeckHoverBrush}" />
    </Style>
    <Style Selector="Button.pill.tray">
      <Setter Property="MinWidth" Value="44" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.pill.tray:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource HcAccentBrush}" />
    </Style>
    <Style Selector="Button.pill.close">
      <Setter Property="Foreground" Value="{StaticResource HcTextMutedBrush}" />
      <Setter Property="FontSize" Value="16" />
    </Style>
    <Style Selector="Button.pill.close:focus-visible">
      <Setter Property="Foreground" Value="{StaticResource HcTextPrimaryBrush}" />
    </Style>
    <!-- Read-only pills (battery, clock) share the shape without a focus stop. -->
    <Style Selector="Border.pill-static">
      <Setter Property="Height" Value="44" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="Background" Value="{StaticResource DeckGroupBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource HcCardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <!-- Stroke-rendered like the TabStrip icons: the Icons geometries are
             stroke-style, filling them collapses interior detail. -->
    <Style Selector="Path.status-icon">
      <Setter Property="Fill" Value="{x:Null}" />
      <Setter Property="Stroke" Value="{StaticResource HcTextMutedBrush}" />
      <Setter Property="StrokeThickness" Value="1.5" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="StrokeLineCap" Value="Round" />
    </Style>

    <!-- Open apps chips: fixed 40 px height, card background, accent
             underline when the window is foreground, dimmed when minimized. -->
    <Style Selector="Button.app-chip">
      <Setter Property="Height" Value="48" />
      <Setter Property="Padding" Value="10,0,12,0" />
      <Setter Property="Background" Value="{StaticResource DeckGroupBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.app-chip:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource HcAccentBrush}" />
    </Style>
    <Style Selector="Button.app-chip:pointerover">
      <Setter Property="Background" Value="{StaticResource DeckHoverBrush}" />
    </Style>
    <Style Selector="Button.app-chip.minimized Image">
      <Setter Property="Opacity" Value="0.5" />
    </Style>
    <Style Selector="Button.app-chip.minimized TextBlock">
      <Setter Property="Opacity" Value="0.5" />
    </Style>
    <Style Selector="Button.app-chip Border.active-indicator">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.app-chip.active Border.active-indicator">
      <Setter Property="Background" Value="{DynamicResource HcAccentBrush}" />
    </Style>
  </Window.Styles>
</Window>

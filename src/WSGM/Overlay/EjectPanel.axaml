<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:WSGM.Controls"
        xmlns:sh="using:WSGM.Shell"
        x:Class="WSGM.Overlay.EjectPanel"
        x:DataType="sh:RemovableDriveManager"
        Background="{StaticResource DeckSurfaceBrush}">
  <Grid>
    <Border BorderBrush="{StaticResource DeckDividerBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="14">
      <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
          <TextBlock Text="Safely remove"
                     FontSize="19"
                     FontWeight="SemiBold"
                     VerticalAlignment="Center" />
          <Button Grid.Column="1"
                  Content="Refresh"
                  Click="OnRefreshClicked"
                  ToolTip.Tip="Look again for removable drives" />
        </Grid>

        <!-- Named so the code-behind can scroll a controller-focused row into
                 view: directional Focus() does not raise RequestBringIntoView, so
                 a row below the fold would take focus invisibly. -->
        <ScrollViewer x:Name="ListScroller"
                      Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="4">
            <TextBlock Text="No removable drives."
                       Classes="caption"
                       IsVisible="{Binding !HasDrives}" />
            <ItemsControl ItemsSource="{Binding Drives}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="sh:RemovableDriveEntry">
                  <!-- Selecting a row reveals its Eject button
                                     rather than acting immediately: a stray tap
                                     must never rip a game library out from under
                                     a running session. -->
                  <Border Classes="radio-row"
                          Classes.selected="{Binding Expanded}"
                          Margin="0,0,0,3">
                    <StackPanel>
                      <Button Classes="radio-row-header"
                              Click="OnDriveClicked">
                        <Grid ColumnDefinitions="Auto,*"
                              VerticalAlignment="Center">
                          <Path Classes="row-icon"
                                Data="{x:Static c:Icons.Eject}"
                                Width="18"
                                Stretch="Uniform"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center" />
                          <StackPanel Grid.Column="1"
                                      VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" />
                            <TextBlock Text="{Binding StatusLine}"
                                       Classes="caption" />
                          </StackPanel>
                        </Grid>
                      </Button>
                      <StackPanel Classes="radio-row-actions"
                                  IsVisible="{Binding Expanded}">
                        <Button Content="Eject"
                                Click="OnDriveEject"
                                IsEnabled="{Binding ActionEnabled}" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Spacing="8">
          <TextBlock Text="{Binding StatusText}"
                     Classes="caption"
                     TextWrapping="Wrap"
                     IsVisible="{Binding HasStatus}" />
          <Button x:Name="CloseButton"
                  Content="Close"
                  HorizontalAlignment="Right"
                  Click="OnCloseClicked" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>

  <UserControl.Styles>
    <!-- The radio-row / radio-row-header / radio-row-actions family lives in
             Themes\Shared.axaml so this panel and the radio panel cannot drift
             apart. Only the drive glyph below is local to this window. -->
    <!-- Stroke-rendered like the taskbar's status icons: the Icons
             geometries are stroke-style, filling them collapses detail. -->
    <Style Selector="Path.row-icon">
      <Setter Property="Fill" Value="{x:Null}" />
      <Setter Property="Stroke" Value="{StaticResource DeckSecondaryBrush}" />
      <Setter Property="StrokeThickness" Value="1.5" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="StrokeLineCap" Value="Round" />
    </Style>
  </UserControl.Styles>
</UserControl>

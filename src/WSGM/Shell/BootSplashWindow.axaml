<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WSGM.Shell.BootSplashWindow"
        Title="WSGM Boot"
        WindowDecorations="None" CanResize="False" Topmost="True"
        ShowInTaskbar="False" Background="{StaticResource HcHeroCardBrush}">

    <!-- Windows-style sign-in cover, now driven by SplashConfig: background color/
         image, vignette, and freely placed text/spinner/logo elements are all built
         in code-behind (hidden elements are OMITTED from the tree, never
         IsVisible=false — StackPanel Spacing must not gap around ghosts). Shown
         activated on purpose — an activated window receives Steam Input's arrow-key
         mirror, the controller fallback if SDL input is ever swallowed while it is
         up. (No-activate was tried and did not change the black-BP symptom.)
         The desktop button stays the last child so it is always topmost. -->
    <Panel x:Name="RootPanel">
        <Button x:Name="DesktopButton" Content="Switch to desktop" Click="OnDesktop" Classes="on-black"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,28,24" MinHeight="44" MinWidth="160" Padding="14,8" />
    </Panel>

    <Window.Styles>
        <!-- Shared.axaml's on-black button style carries the splash button's
             surface colors and the unified accent focus border; only the muted
             resting foreground (white on focus) is splash-specific. -->
        <Style Selector="Button#DesktopButton">
            <Setter Property="Foreground" Value="{StaticResource HcTextMutedBrush}" />
        </Style>
        <Style Selector="Button#DesktopButton:focus-visible">
            <Setter Property="Foreground" Value="{StaticResource HcTextPrimaryBrush}" />
        </Style>
    </Window.Styles>
</Window>

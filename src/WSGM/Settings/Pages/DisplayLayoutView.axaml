<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="using:WSGM.Settings"
             x:Class="WSGM.Settings.Pages.DisplayLayoutView"
             x:DataType="s:DisplayLayoutEditor">
  <Grid ColumnDefinitions="*,310" ColumnSpacing="18">
    <StackPanel Spacing="10">
      <Border Classes="layout-surface" Padding="8" IsVisible="{Binding HasDisplays}">
        <StackPanel>
          <s:DisplayArrangementView Editor="{Binding}" Height="170" />
          <TextBlock Text="Drag to arrange · Use Position for precise placement" Classes="caption"
                     HorizontalAlignment="Center" TextWrapping="Wrap" Margin="4,4,4,6" />
        </StackPanel>
      </Border>
      <ListBox x:Name="DisplayList" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}"
               Classes="display-list" IsVisible="{Binding HasDisplays}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="s:DisplayLayoutEditorRow">
            <Grid ColumnDefinitions="24,*,Auto" ColumnSpacing="10">
              <TextBlock Text="{Binding Number}" Classes="display-number" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ConnectionText}" Classes="caption" TextWrapping="Wrap" />
              </StackPanel>
              <TextBlock Grid.Column="2" Text="{Binding LayoutState}" Classes="caption" VerticalAlignment="Center" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <Border Classes="layout-surface" Padding="20" IsVisible="{Binding !HasDisplays}">
        <StackPanel Spacing="8">
          <TextBlock Text="No displays to configure" FontWeight="SemiBold" />
          <TextBlock
            Text="Connect a display and refresh the display list. Saved displays will remain available while disconnected."
            Classes="caption" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
      <TextBlock Text="{Binding ValidationText}" Classes="layout-warning" TextWrapping="Wrap"
                 IsVisible="{Binding HasValidationError}" />
      <TextBlock Text="Enable at least one display for this layout." Classes="layout-warning" TextWrapping="Wrap"
                 IsVisible="{Binding !HasActiveDisplays}" />
      <TextBlock
        Text="A display is disconnected. You can edit and save its layout now; it must be available when the layout is applied."
        Classes="layout-warning" TextWrapping="Wrap" IsVisible="{Binding HasDisconnectedDisplay}" />
      <Button Content="Undo last edit" Click="OnUndo" IsEnabled="{Binding CanUndo}" HorizontalAlignment="Left" />
    </StackPanel>
    <Border Grid.Column="1" Classes="layout-surface" Padding="16" VerticalAlignment="Top"
            IsVisible="{Binding HasSelection}">
      <Panel DataContext="{Binding Selected}">
        <StackPanel Spacing="12" x:DataType="s:DisplayLayoutEditorRow">
          <StackPanel Spacing="3">
            <TextBlock Text="{Binding InspectorTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ConnectionText}" Classes="caption" TextWrapping="Wrap" />
          </StackPanel>
          <CheckBox Content="Use in this layout" IsChecked="{Binding Active}" />
          <CheckBox Content="Make this the primary display" IsChecked="{Binding IsPrimary}"
                    IsEnabled="{Binding Active}" />
          <StackPanel Spacing="4">
            <TextBlock Text="Resolution" Classes="caption" />
            <ComboBox x:Name="ResolutionChoice" ItemsSource="{Binding Resolutions}" SelectedItem="{Binding Resolution}"
                      HorizontalAlignment="Stretch" IsEnabled="{Binding HasModes}" />
            <TextBlock Text="No modes remembered. Connect this display and refresh the display list." Classes="caption"
                       TextWrapping="Wrap" IsVisible="{Binding !HasModes}" />
          </StackPanel>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
            <StackPanel Spacing="4">
              <TextBlock Text="Refresh rate (Hz)" Classes="caption" />
              <ComboBox x:Name="RefreshChoice" ItemsSource="{Binding RefreshRates}" SelectedItem="{Binding RefreshHz}"
                        HorizontalAlignment="Stretch" IsEnabled="{Binding HasModes}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="4">
              <TextBlock Text="Scale (%)" Classes="caption" />
              <ComboBox x:Name="ScaleChoice" ItemsSource="{Binding Scales}" SelectedItem="{Binding DpiPercent}"
                        HorizontalAlignment="Stretch" />
            </StackPanel>
          </Grid>
          <StackPanel Spacing="4">
            <TextBlock Text="HDR" Classes="caption" />
            <ComboBox SelectedIndex="{Binding HdrIndex}" IsEnabled="{Binding HdrSupported}"
                      HorizontalAlignment="Stretch">
              <ComboBoxItem Content="Off" />
              <ComboBoxItem Content="On" />
            </ComboBox>
            <TextBlock Text="{Binding HdrHint}" Classes="caption" TextWrapping="Wrap"
                       IsVisible="{Binding !HdrSupported}" />
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Text="Position" Classes="caption" />
            <ComboBox x:Name="PositionChoice" SelectedIndex="0" SelectionChanged="OnPositionChanged"
                      IsEnabled="{Binding !IsPrimary}" HorizontalAlignment="Stretch">
              <ComboBoxItem Content="Custom position" />
              <ComboBoxItem Content="Right of primary display" />
              <ComboBoxItem Content="Left of primary display" />
              <ComboBoxItem Content="Above primary display" />
              <ComboBoxItem Content="Below primary display" />
            </ComboBox>
            <TextBlock Text="Primary display · origin" Classes="caption" IsVisible="{Binding IsPrimary}" />
          </StackPanel>
          <Expander Header="Exact position" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" IsEnabled="{Binding !IsPrimary}">
              <StackPanel Spacing="4">
                <TextBlock Text="Horizontal (px)" Classes="caption" />
                <NumericUpDown Value="{Binding X}" Minimum="-32768" Maximum="32768" Increment="10" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="Vertical (px)" Classes="caption" />
                <NumericUpDown Value="{Binding Y}" Minimum="-32768" Maximum="32768" Increment="10" />
              </StackPanel>
            </Grid>
          </Expander>
          <TextBlock Text="These draft settings are kept while this display is disabled." Classes="caption"
                     TextWrapping="Wrap" IsVisible="{Binding !Active}" />
        </StackPanel>
      </Panel>
    </Border>
  </Grid>
</UserControl>

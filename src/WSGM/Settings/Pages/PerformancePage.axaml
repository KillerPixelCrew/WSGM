<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="using:WSGM.Settings"
             x:Class="WSGM.Settings.Pages.PerformancePage"
             x:DataType="s:SettingsViewModel">
  <!-- Frame limiting, the performance overlay and the graphics drivers WSGM manages. -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Classes="settings-page">
        <Border Classes="section-header">
          <TextBlock Text="Frame limit" />
        </Border>
        <Border Classes="setting-row">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel VerticalAlignment="Center" Spacing="1">
              <TextBlock Text="RTSS controls" Classes="setting-title" />
              <TextBlock Text="What the frame limit rows in the Overlay and Steam offer. Setup installs RTSS when you choose Full."
                         Classes="caption" TextWrapping="Wrap" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding PerformanceEnabled}" VerticalAlignment="Center" />
          </Grid>
        </Border>

        <Border Classes="section-header" IsVisible="{Binding PerformanceEnabled}">
          <StackPanel Spacing="2">
            <TextBlock Text="Performance overlay widgets" />
            <TextBlock Text="The custom overlay level. Drag or use Y to reorder." Classes="caption" />
          </StackPanel>
        </Border>
        <Border Classes="settings-card settings-table" IsVisible="{Binding PerformanceEnabled}">
          <StackPanel>
            <Grid ColumnDefinitions="28,*,80,80,80" Margin="14,0,14,4">
              <TextBlock Grid.Column="2" Text="Hidden" Classes="settings-column" />
              <TextBlock Grid.Column="3" Text="Minimal" Classes="settings-column" />
              <TextBlock Grid.Column="4" Text="Full" Classes="settings-column" />
            </Grid>
            <ItemsControl x:Name="WidgetList" ItemsSource="{Binding OsdWidgets}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="s:OsdWidgetRow">
                  <Border Classes="setting-row settings-table-row" Classes.moving="{Binding IsMoving}">
                    <Grid ColumnDefinitions="28,*,80,80,80">
                      <Button Classes="settings-grip" Click="OnGripClick" VerticalAlignment="Center"
                              AutomationProperties.Name="{Binding Name, StringFormat='Move {0}'}">
                        <Path Data="M0,0 H12 M0,4 H12 M0,8 H12" Stroke="{StaticResource HcTextSecondaryBrush}"
                              StrokeThickness="1.5" StrokeLineCap="Round" />
                      </Button>
                      <TextBlock Grid.Column="1" Text="{Binding Name}" Classes="setting-title" VerticalAlignment="Center"
                                 Margin="6,0,0,0" />
                      <RadioButton Grid.Column="2" HorizontalAlignment="Center" IsChecked="{Binding IsHidden}"
                                   AutomationProperties.Name="{Binding Name, StringFormat='{}{0}: Hidden'}" />
                      <RadioButton Grid.Column="3" HorizontalAlignment="Center" IsChecked="{Binding IsMinimal}"
                                   AutomationProperties.Name="{Binding Name, StringFormat='{}{0}: Minimal'}" />
                      <RadioButton Grid.Column="4" HorizontalAlignment="Center" IsChecked="{Binding IsFull}"
                                   AutomationProperties.Name="{Binding Name, StringFormat='{}{0}: Full'}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Classes="section-header">
          <TextBlock Text="Graphics drivers" />
        </Border>
        <TextBlock
          Text="Let WSGM manage graphics settings for matching adapters. Changes apply after Save without restarting WSGM."
          Classes="caption" TextWrapping="Wrap" Margin="12,4,12,8" />
        <ItemsControl ItemsSource="{Binding GraphicsDrivers}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="s:CommonPluginInstanceRow">
              <Border Classes="setting-row">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <StackPanel VerticalAlignment="Center" Spacing="1">
                    <TextBlock Text="{Binding Name}" Classes="setting-title" />
                    <TextBlock Text="{Binding Detail}" Classes="caption" TextWrapping="Wrap" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding Enabled}" VerticalAlignment="Center" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>

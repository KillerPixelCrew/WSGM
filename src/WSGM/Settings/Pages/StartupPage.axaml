<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="using:WSGM.Settings"
             x:Class="WSGM.Settings.Pages.StartupPage"
             x:DataType="s:SettingsViewModel">
  <!-- Programs that run at sign-in, in order, then the timing and the boot splash. Each app is a card; its
       More button (X) shows Edit, Move up, Move down and Remove in the card. Add app and Edit open nested pages. -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Classes="settings-page">
      <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
        <Border Classes="section-header">
          <TextBlock Text="Startup apps" />
        </Border>
        <Button x:Name="AddApp" Grid.Column="1" Content="Add app…" Tag="open:Add app" VerticalAlignment="Bottom"
                Margin="0,0,0,6" />
      </Grid>
      <Border Classes="settings-card" IsVisible="{Binding NoStartupApps}">
        <TextBlock Text="No startup apps. Add one to run it at sign-in, before Steam starts." Classes="caption"
                   TextWrapping="Wrap" />
      </Border>
      <ItemsControl x:Name="AppList" ItemsSource="{Binding StartupApps}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="s:StartupAppRow">
            <Border Classes="setting-row">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                  <Border Classes="settings-step" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Number}" Classes="settings-row-state" />
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                    <TextBlock Text="{Binding Name}" Classes="setting-title settings-row-state"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Detail}" Classes="caption settings-row-state"
                               Classes.problem="{Binding Missing}" TextTrimming="PathSegmentEllipsis" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Border Classes="settings-chip" IsVisible="{Binding !Enabled}">
                      <TextBlock Text="Off" Classes="settings-row-state" />
                    </Border>
                    <Border Classes="settings-chip" IsVisible="{Binding Elevated}">
                      <TextBlock Text="Admin" Classes="settings-row-state" />
                    </Border>
                    <Border Classes="settings-chip" IsVisible="{Binding AutoRelaunch}">
                      <TextBlock Text="Restart if it exits" Classes="settings-row-state" />
                    </Border>
                    <Border Classes="settings-chip attention" IsVisible="{Binding Missing}">
                      <TextBlock Text="Skipped" />
                    </Border>
                  </StackPanel>
                  <Button Grid.Column="3" Classes="settings-more" Click="OnMore" VerticalAlignment="Center"
                          AutomationProperties.Name="{Binding Name, StringFormat='More for {0}'}">
                    <TextBlock Text="•••" FontSize="11" />
                  </Button>
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="42,0,0,0" IsVisible="{Binding ShowActions}">
                  <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !ConfirmRemove}">
                    <Button Content="Edit" Tag="edit" Click="OnEdit" />
                    <Button Content="Move up" Tag="up" Click="OnMove"
                            Command="{Binding $parent[ItemsControl].((s:SettingsViewModel)DataContext).MoveUpCommand, FallbackValue={x:Null}}"
                            CommandParameter="{Binding}" />
                    <Button Content="Move down" Tag="down" Click="OnMove"
                            Command="{Binding $parent[ItemsControl].((s:SettingsViewModel)DataContext).MoveDownCommand, FallbackValue={x:Null}}"
                            CommandParameter="{Binding}" />
                    <Button Classes="danger" Content="Remove" Tag="remove" Click="OnRemove" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ConfirmRemove}">
                    <TextBlock Text="{Binding Name, StringFormat='Remove {0} from startup?'}" Classes="caption"
                               VerticalAlignment="Center" />
                    <Button Classes="danger" Content="Remove" Tag="confirm"
                            Command="{Binding $parent[ItemsControl].((s:SettingsViewModel)DataContext).RemoveAppCommand, FallbackValue={x:Null}}"
                            CommandParameter="{Binding}" />
                    <Button Content="Keep" Tag="keep" Click="OnKeep" />
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border Classes="section-header">
        <TextBlock Text="Timing" />
      </Border>
      <Border Classes="setting-row">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
          <StackPanel VerticalAlignment="Center" Spacing="1">
            <TextBlock Text="Before the first app" Classes="setting-title" />
            <TextBlock Text="Gives Windows time to settle after sign-in." Classes="caption" TextWrapping="Wrap" />
          </StackPanel>
          <NumericUpDown Grid.Column="1" Value="{Binding StartupDelayMs}" Minimum="0" Maximum="30000" Increment="250"
                         Width="130" FormatString="0" VerticalAlignment="Center"
                         AutomationProperties.Name="Wait before the first app, in milliseconds" />
          <TextBlock Grid.Column="2" Text="ms" Classes="caption" VerticalAlignment="Center" />
        </Grid>
      </Border>
      <Border Classes="setting-row">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
          <StackPanel VerticalAlignment="Center" Spacing="1">
            <TextBlock Text="Between apps" Classes="setting-title" />
            <TextBlock Text="Wait after each app before the next one starts." Classes="caption" TextWrapping="Wrap" />
          </StackPanel>
          <NumericUpDown Grid.Column="1" Value="{Binding StaggerDelayMs}" Minimum="0" Maximum="30000" Increment="250"
                         Width="130" FormatString="0" VerticalAlignment="Center"
                         AutomationProperties.Name="Wait between apps, in milliseconds" />
          <TextBlock Grid.Column="2" Text="ms" Classes="caption" VerticalAlignment="Center" />
        </Grid>
      </Border>

      <Border Classes="section-header">
        <TextBlock Text="Boot splash" />
      </Border>
      <Border Classes="setting-row">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <StackPanel VerticalAlignment="Center" Spacing="1">
            <TextBlock Text="Boot splash" Classes="setting-title" />
            <TextBlock Text="Hides startup app windows until Big Picture is on screen. Its look is under Appearance."
                       Classes="caption" TextWrapping="Wrap" />
          </StackPanel>
          <ToggleSwitch Grid.Column="1" IsChecked="{Binding BootSplashEnabled}" VerticalAlignment="Center" />
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>

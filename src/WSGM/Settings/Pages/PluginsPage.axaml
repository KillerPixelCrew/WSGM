<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="using:WSGM.Settings"
             xmlns:c="using:WSGM.Controls"
             x:Class="WSGM.Settings.Pages.PluginsPage"
             x:DataType="s:SettingsViewModel">
  <!--
        Common plugin activation and package management use installed common metadata.
    -->
  <UserControl.Styles>
    <!-- Plugin cards: an icon tile, the name, a row of tinted badges (status, version, kind, origin,
         validation) and the one action. Badge tones: green for installed and hardware-tested, amber for
         blind and removing, red for refused and outdated, the accent for first-party, violet for
         community, blue for available, grey for plain facts. -->
    <Style Selector="Border.plugin-card">
      <Setter Property="Background" Value="{StaticResource HcCardBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource HcCardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14,12" />
    </Style>
    <Style Selector="Border.plugin-icon">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="44" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="{StaticResource HcPluginIconBrush}" />
    </Style>
    <Style Selector="Border.plugin-icon > Path">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.plugin-name">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
  </UserControl.Styles>
  <!-- One scrolling page: plugins first, then the device plugin's own settings. The two short fixed-height
       lists this replaces hid most of each card. -->
  <ScrollViewer Padding="28,0,28,20">
    <StackPanel Spacing="4">
        <!--
            Installed package files and what the installed release bundles. Installing copies a bundled
            file into the Plugins folder and removing deletes one; both apply at the next start, because
            a loaded package is held open. A device plugin is offered only when its hardware rules match.
        -->
        <Button Content="Repair…" Command="{Binding RepairCommand}" IsVisible="{Binding CanRepair}"
                HorizontalAlignment="Right" ToolTip.Tip="Run setup's repair for missing components"
                AutomationProperties.Name="Repair installation" />
          <Border Classes="section-header" IsVisible="{Binding HasInstalledPackages}">
            <TextBlock Text="Installed" />
          </Border>
          <ItemsControl ItemsSource="{Binding InstalledPackages}" IsVisible="{Binding HasInstalledPackages}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="8" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="s:PluginPackageRow">
                <Border Classes="plugin-card">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                    <Border Classes="plugin-icon" VerticalAlignment="Top">
                      <Path Data="{Binding Icon}" Stroke="{StaticResource HcTextPrimaryBrush}" StrokeThickness="1.6"
                            Width="22" Height="22" Stretch="Uniform" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="7" VerticalAlignment="Center">
                      <TextBlock Classes="plugin-name" Text="{Binding Name}" />
                      <ItemsControl ItemsSource="{Binding Badges}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel ItemSpacing="6" LineSpacing="6" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="s:PluginBadgeView">
                            <Border Classes="badge" Classes.accent="{Binding IsAccent}"
                                    Classes.community="{Binding IsCommunity}" Classes.info="{Binding IsInfo}"
                                    Classes.good="{Binding IsGood}" Classes.warn="{Binding IsWarn}"
                                    Classes.bad="{Binding IsBad}">
                              <TextBlock Text="{Binding Text}" />
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Classes="caption" Classes.problem="{Binding NoticeIsProblem}" Text="{Binding Notice}"
                                 TextWrapping="Wrap" IsVisible="{Binding HasNotice}" />
                    </StackPanel>
                    <Button Grid.Column="2" Classes.primary="{Binding IsInstall}" Content="{Binding ActionLabel}"
                            Command="{Binding ActCommand}" IsVisible="{Binding HasAction}" VerticalAlignment="Center"
                            MinWidth="96" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Border Classes="section-header" IsVisible="{Binding HasAvailablePackages}">
            <TextBlock Text="Available" />
          </Border>
          <ItemsControl ItemsSource="{Binding AvailablePackages}" IsVisible="{Binding HasAvailablePackages}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="8" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="s:PluginPackageRow">
                <Border Classes="plugin-card">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                    <Border Classes="plugin-icon" VerticalAlignment="Top">
                      <Path Data="{Binding Icon}" Stroke="{StaticResource HcTextPrimaryBrush}" StrokeThickness="1.6"
                            Width="22" Height="22" Stretch="Uniform" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="7" VerticalAlignment="Center">
                      <TextBlock Classes="plugin-name" Text="{Binding Name}" />
                      <ItemsControl ItemsSource="{Binding Badges}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel ItemSpacing="6" LineSpacing="6" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="s:PluginBadgeView">
                            <Border Classes="badge" Classes.accent="{Binding IsAccent}"
                                    Classes.community="{Binding IsCommunity}" Classes.info="{Binding IsInfo}"
                                    Classes.good="{Binding IsGood}" Classes.warn="{Binding IsWarn}"
                                    Classes.bad="{Binding IsBad}">
                              <TextBlock Text="{Binding Text}" />
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Classes="caption" Classes.problem="{Binding NoticeIsProblem}" Text="{Binding Notice}"
                                 TextWrapping="Wrap" IsVisible="{Binding HasNotice}" />
                    </StackPanel>
                    <Button Grid.Column="2" Classes.primary="{Binding IsInstall}" Content="{Binding ActionLabel}"
                            Command="{Binding ActCommand}" IsVisible="{Binding HasAction}" VerticalAlignment="Center"
                            MinWidth="96" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <!-- Collapsed: these do not apply here, so they wait behind Show. -->
          <Border Classes="setting-row" IsVisible="{Binding HasUnavailablePackages}" Margin="0,12,0,4">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <StackPanel VerticalAlignment="Center" Spacing="1">
                <TextBlock Text="Not for this device" Classes="setting-title" />
                <TextBlock Text="{Binding UnavailablePackagesSummary}" Classes="caption" TextWrapping="Wrap" />
              </StackPanel>
              <Button x:Name="ShowUnavailable" Grid.Column="1" Content="Show" Click="OnShowUnavailable"
                      VerticalAlignment="Center" />
            </Grid>
          </Border>
          <ItemsControl x:Name="UnavailableList" ItemsSource="{Binding UnavailablePackages}" IsVisible="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="8" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="s:PluginPackageRow">
                <Border Classes="plugin-card">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                    <Border Classes="plugin-icon" VerticalAlignment="Top">
                      <Path Data="{Binding Icon}" Stroke="{StaticResource HcTextPrimaryBrush}" StrokeThickness="1.6"
                            Width="22" Height="22" Stretch="Uniform" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="7" VerticalAlignment="Center">
                      <TextBlock Classes="plugin-name" Text="{Binding Name}" />
                      <ItemsControl ItemsSource="{Binding Badges}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel ItemSpacing="6" LineSpacing="6" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="s:PluginBadgeView">
                            <Border Classes="badge" Classes.accent="{Binding IsAccent}"
                                    Classes.community="{Binding IsCommunity}" Classes.info="{Binding IsInfo}"
                                    Classes.good="{Binding IsGood}" Classes.warn="{Binding IsWarn}"
                                    Classes.bad="{Binding IsBad}">
                              <TextBlock Text="{Binding Text}" />
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Classes="caption" Classes.problem="{Binding NoticeIsProblem}" Text="{Binding Notice}"
                                 TextWrapping="Wrap" IsVisible="{Binding HasNotice}" />
                    </StackPanel>
                    <Button Grid.Column="2" Classes.primary="{Binding IsInstall}" Content="{Binding ActionLabel}"
                            Command="{Binding ActCommand}" IsVisible="{Binding HasAction}" VerticalAlignment="Center"
                            MinWidth="96" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        <Border Classes="section-header">
          <StackPanel Spacing="2">
            <TextBlock Text="Steam CEF plugins" />
            <TextBlock Text="Plugins that run inside Steam" Classes="caption" />
          </StackPanel>
        </Border>
        <Border Classes="setting-row">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel VerticalAlignment="Center" Spacing="1">
              <TextBlock Text="Allow trusted Steam CEF plugins" Classes="setting-title" />
              <TextBlock Text="{Binding SteamCefPluginWarning}" Classes="caption" TextWrapping="Wrap" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding SteamCefPluginWarningAccepted, Mode=TwoWay}"
                          VerticalAlignment="Center" />
          </Grid>
        </Border>

        <Border Classes="section-header">
          <StackPanel Spacing="2">
            <TextBlock Text="Independent plugins" />
            <TextBlock Text="They run without Device integration. Their controls are in the Overlay." Classes="caption"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <TextBlock Classes="caption problem" TextWrapping="Wrap" Text="{Binding CommonPluginDiscoveryError}"
                   IsVisible="{Binding CommonPluginDiscoveryError.Length}" />
        <ItemsControl ItemsSource="{Binding CommonPlugins}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="8" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="s:CommonPluginInstanceRow">
              <Border Classes="plugin-card">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <StackPanel Spacing="3" VerticalAlignment="Center">
                    <TextBlock Classes="plugin-name" Text="{Binding Name}" />
                    <TextBlock Classes="caption" Text="{Binding Detail}" TextWrapping="Wrap" />
                    <CheckBox Content="Allow this plugin to access Steam CEF" IsVisible="{Binding SteamCef}"
                              IsEnabled="{Binding CanEnableSteamCef}"
                              IsChecked="{Binding SteamCefEnabled, Mode=TwoWay}" />
                    <TextBlock Classes="caption problem" Text="{Binding CefFailure}" TextWrapping="Wrap"
                               IsVisible="{Binding HasCefFailure}" />
                    <Button Content="Reload plugin after Save" Command="{Binding ReloadCefCommand}"
                            IsVisible="{Binding HasCefFailure}" IsEnabled="{Binding CanEnableSteamCef}" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding Enabled, Mode=TwoWay}"
                                VerticalAlignment="Center" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      
    </StackPanel>
  </ScrollViewer>
</UserControl>


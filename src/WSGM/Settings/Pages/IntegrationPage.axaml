<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="using:WSGM.Settings"
             xmlns:c="using:WSGM.Controls"
             x:Class="WSGM.Settings.Pages.IntegrationPage"
             x:DataType="s:SettingsViewModel">
    <!-- Everything WSGM injects into the running Steam client over its debug
         port. Split off the Steam page in the review round after the seventh
         toggle: two sections on that page no longer fit the 1024x640 layout
         floor, and a page that stops fitting earns its own tab. Keep new CEF
         features here rather than growing another page's column. -->
    <Border Padding="16,10,16,10">
        <Grid ColumnDefinitions="*,24,*">
            <StackPanel Grid.Column="0">
                <Border Classes="section-header">
                    <TextBlock Text="STEAM INTEGRATION (CEF)" />
                </Border>
                <Border Classes="setting-row alt">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="Steam CEF integration" Classes="setting-title" />
                            <TextBlock Text="Master switch for everything WSGM injects into Steam over its debug port. Off leaves the debug port closed and hides every feature below." Classes="caption" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding CefEnabled}" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Border Classes="section-header" IsVisible="{Binding CefEnabled}">
                    <TextBlock Text="LIBRARY" />
                </Border>
                <Border Classes="setting-row" IsVisible="{Binding CefEnabled}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="Library &amp; tabs" Classes="setting-title" />
                            <TextBlock Text="Custom filter tabs, tab order, and hiding native Steam tabs." Classes="caption" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding CefLibraryTabs}" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <Border Classes="setting-row alt" IsVisible="{Binding CefEnabled}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="SD-card library manager" Classes="setting-title" />
                            <TextBlock Text="Per-card library tabs, the &quot;On: card&quot; game-page badges, and live library labels." Classes="caption" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding CefCardManager}" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <Border Classes="setting-row" IsVisible="{Binding CefEnabled}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="Format SD Card + add library" Classes="setting-title" />
                            <TextBlock Text="Format a card as a Steam library and register it into the running Steam." Classes="caption" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding CefSdFormat}" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="2" IsVisible="{Binding CefEnabled}">
                <Border Classes="section-header">
                    <TextBlock Text="CLIENT" />
                </Border>
                <Border Classes="setting-row alt">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="Shortcut artwork" Classes="setting-title" />
                            <TextBlock Text="Swap game art from SteamGridDB via the overlay." Classes="caption" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding CefArtwork}" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <Border Classes="setting-row">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="Big Picture Wi-Fi indicator" Classes="setting-title" />
                            <TextBlock Text="Make Big Picture's header Wi-Fi icon reflect the real connection." Classes="caption" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding CefWifiIndicator}" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <Border Classes="setting-row alt">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="Keep awake during downloads" Classes="setting-title" />
                            <TextBlock Text="Hold a wake lock while Steam downloads, so standby cannot interrupt them." Classes="caption" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding CefDownloadKeepAwake}" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>

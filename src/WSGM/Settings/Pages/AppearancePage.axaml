<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="using:WSGM.Settings"
             xmlns:c="using:WSGM.Controls"
             x:Class="WSGM.Settings.Pages.AppearancePage"
             x:DataType="s:SettingsViewModel">
  <!-- The accent colour, then the splash: its preset, preview and file actions first, then its look in three
       tabs (Text, Colours, Images). Tab panels stay searchable; choosing a result selects its tab. -->
  <UserControl.Resources>
    <DataTemplate x:Key="SplashChoice" x:DataType="x:Object">
      <TextBlock Text="{Binding Converter={x:Static s:SplashChoiceNames.Instance}}" />
    </DataTemplate>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Classes="settings-page">
      <Border Classes="section-header">
        <TextBlock Text="Accent" />
      </Border>
      <Border Classes="setting-row">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <!-- Swatch buttons (44x44, check overlay on the active colour) are built in code-behind. -->
          <StackPanel x:Name="SwatchPanel" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" />
          <Button x:Name="CustomAccentButton" Grid.Column="1" Content="Custom…" Click="OnCustomAccent"
                  VerticalAlignment="Center" />
        </Grid>
      </Border>
      <Border x:Name="CustomAccentRow" Classes="setting-row" IsVisible="False">
        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
          <TextBlock Text="Custom colour" Classes="setting-title" VerticalAlignment="Center" />
          <TextBox Grid.Column="1" x:Name="AccentHexBox" Width="110" Text="{Binding AccentColorHex}"
                   VerticalAlignment="Center" ToolTip.Tip="Hex colour, e.g. #FF9D3D" />
          <ColorPicker Grid.Column="2" x:Name="AccentPicker" VerticalAlignment="Center"
                       ColorChanged="OnAccentPickerColorChanged" />
          <Button Grid.Column="3" Content="Type" Tag="Accent" Click="OnEditTextWithController"
                  AutomationProperties.Name="Type the accent colour with the on-screen keyboard" />
        </Grid>
      </Border>

      <Border Classes="section-header">
        <StackPanel Spacing="2">
          <TextBlock Text="Splash" />
          <TextBlock Text="Shown at sign-in until Big Picture is on screen" Classes="caption" />
        </StackPanel>
      </Border>
      <Border Classes="setting-row">
        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
          <TextBlock Text="Preset" Classes="setting-title" VerticalAlignment="Center" />
          <ComboBox Grid.Column="1" x:Name="PresetCombo" Width="150" VerticalAlignment="Center"
                    AutomationProperties.Name="Splash preset" />
          <Button Grid.Column="2" Content="Apply" Click="OnApplyPreset" VerticalAlignment="Center"
                  ToolTip.Tip="Fills the splash fields with the starting values of the preset" />
          <Button Grid.Column="3" Classes="primary" Content="Preview full screen" Click="OnPreviewSplash"
                  VerticalAlignment="Center" ToolTip.Tip="B, Escape or a tap closes it" />
          <Button x:Name="SplashMoreButton" Grid.Column="4" Content="More" Click="OnSplashMore"
                  VerticalAlignment="Center" />
        </Grid>
      </Border>
      <Border x:Name="SplashFileRow" Classes="setting-row" IsVisible="False">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
          <StackPanel VerticalAlignment="Center" Spacing="1">
            <TextBlock Text="Splash file" Classes="setting-title" />
            <TextBlock Text="Share the look as a .wsgmsplash file, images included." Classes="caption"
                       TextWrapping="Wrap" />
          </StackPanel>
          <Button Grid.Column="1" Content="Export…" Click="OnExportSplash" VerticalAlignment="Center" />
          <Button Grid.Column="2" Content="Import…" Click="OnImportSplash" VerticalAlignment="Center" />
        </Grid>
      </Border>

      <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,8,0,6">
        <RadioButton Classes="settings-tab" GroupName="SplashTab" Content="Text" Tag="SplashTextTab"
                     IsChecked="True" IsCheckedChanged="OnSplashTab" />
        <RadioButton Classes="settings-tab" GroupName="SplashTab" Content="Colours" Tag="SplashColoursTab"
                     IsCheckedChanged="OnSplashTab" />
        <RadioButton Classes="settings-tab" GroupName="SplashTab" Content="Images" Tag="SplashImagesTab"
                     IsCheckedChanged="OnSplashTab" />
      </StackPanel>

      <StackPanel x:Name="SplashTextTab" Classes="settings-tab-panel">
        <Border Classes="setting-row">
          <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
            <StackPanel VerticalAlignment="Center" Spacing="1">
              <TextBlock Text="Title" Classes="setting-title" />
              <TextBlock Text="Off hides the title and the caption." Classes="caption" />
            </StackPanel>
            <TextBox Grid.Column="1" x:Name="SplashTitleBox" Width="200" Text="{Binding Splash.Text}"
                     VerticalAlignment="Center" AutomationProperties.Name="Splash title" />
            <Button Grid.Column="2" Content="Type" Tag="Title" Click="OnEditTextWithController"
                    AutomationProperties.Name="Type the splash title with the on-screen keyboard" />
            <ToggleSwitch Grid.Column="3" IsChecked="{Binding Splash.TextEnabled}" VerticalAlignment="Center"
                          AutomationProperties.Name="Show the title and caption" />
          </Grid>
        </Border>
        <Border Classes="setting-row">
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBlock Text="Caption" Classes="setting-title" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" x:Name="SplashCaptionBox" Width="200" Text="{Binding Splash.Caption}"
                     VerticalAlignment="Center" PlaceholderText="No caption" AutomationProperties.Name="Splash caption" />
            <Button Grid.Column="2" Content="Type" Tag="Caption" Click="OnEditTextWithController"
                    AutomationProperties.Name="Type the splash caption with the on-screen keyboard" />
          </Grid>
        </Border>
        <Border Classes="setting-row">
          <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
            <TextBlock Text="Title and caption size" Classes="setting-title" VerticalAlignment="Center" />
            <NumericUpDown Grid.Column="1" Width="120" Value="{Binding Splash.TitleFontSize}" Minimum="1"
                           Maximum="400" Increment="1" FormatString="0" VerticalAlignment="Center"
                           AutomationProperties.Name="Title size in pixels" />
            <TextBlock Grid.Column="2" Text="px" Classes="caption" VerticalAlignment="Center" />
            <NumericUpDown Grid.Column="3" Width="120" Value="{Binding Splash.CaptionFontSize}" Minimum="1"
                           Maximum="200" Increment="1" FormatString="0" VerticalAlignment="Center"
                           AutomationProperties.Name="Caption size in pixels" />
            <TextBlock Grid.Column="4" Text="px" Classes="caption" VerticalAlignment="Center" />
          </Grid>
        </Border>
        <Border Classes="setting-row">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBlock Text="Text position" Classes="setting-title" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" Width="170" ItemsSource="{x:Static s:SettingsViewModel.TextPlacementModeValues}"
                        ItemTemplate="{StaticResource SplashChoice}" SelectedItem="{Binding TextPlacement.Mode}"
                        VerticalAlignment="Center" AutomationProperties.Name="Text position" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right"
                        IsVisible="{Binding TextPlacement.IsAnchor}">
              <ComboBox Width="150" ItemsSource="{x:Static s:SettingsViewModel.PlacementAnchorValues}"
                        ItemTemplate="{StaticResource SplashChoice}" SelectedItem="{Binding TextPlacement.Anchor}"
                        VerticalAlignment="Center" AutomationProperties.Name="Text position: anchor" />
              <TextBlock Text="Inset" Classes="caption" VerticalAlignment="Center" />
              <NumericUpDown Width="110" Value="{Binding TextPlacement.PaddingX}" Minimum="0" Maximum="4096"
                             FormatString="0" VerticalAlignment="Center"
                             AutomationProperties.Name="Text position: horizontal inset in pixels" />
              <NumericUpDown Width="110" Value="{Binding TextPlacement.PaddingY}" Minimum="0" Maximum="4096"
                             FormatString="0" VerticalAlignment="Center"
                             AutomationProperties.Name="Text position: vertical inset in pixels" />
              <TextBlock Text="px" Classes="caption" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right"
                        IsVisible="{Binding TextPlacement.IsAbsolute}">
              <TextBlock Text="X" Classes="caption" VerticalAlignment="Center" />
              <NumericUpDown Width="120" Value="{Binding TextPlacement.X}" Minimum="0" Maximum="16384" FormatString="0"
                             VerticalAlignment="Center" AutomationProperties.Name="Text position: X in pixels" />
              <TextBlock Text="Y" Classes="caption" VerticalAlignment="Center" />
              <NumericUpDown Width="120" Value="{Binding TextPlacement.Y}" Minimum="0" Maximum="16384" FormatString="0"
                             VerticalAlignment="Center" AutomationProperties.Name="Text position: Y in pixels" />
              <TextBlock Text="px on this screen" Classes="caption" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
        </Border>
        <Border Classes="setting-row">
          <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
            <TextBlock Text="Spinner" Classes="setting-title" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" Width="160" ItemsSource="{x:Static s:SettingsViewModel.SpinnerStyleValues}"
                      ItemTemplate="{StaticResource SplashChoice}" SelectedItem="{Binding Splash.SpinnerStyle}"
                      VerticalAlignment="Center" AutomationProperties.Name="Spinner style" />
            <ComboBox Grid.Column="2" Width="160" ItemsSource="{x:Static s:SettingsViewModel.SweepEdgeValues}"
                      ItemTemplate="{StaticResource SplashChoice}" SelectedItem="{Binding Splash.SweepEdge}"
                      VerticalAlignment="Center" AutomationProperties.Name="Sweep edge"
                      ToolTip.Tip="Where the Sweep spinner runs" />
            <NumericUpDown Grid.Column="3" Width="120" Value="{Binding Splash.SpinnerSize}" Minimum="1"
                           Maximum="1024" Increment="2" FormatString="0" VerticalAlignment="Center"
                           AutomationProperties.Name="Spinner size in pixels" />
            <TextBlock Grid.Column="4" Text="px" Classes="caption" VerticalAlignment="Center" />
          </Grid>
        </Border>
        <Border Classes="setting-row">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBlock Text="Spinner position" Classes="setting-title" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" Width="170" ItemsSource="{x:Static s:SettingsViewModel.PlacementModeValues}"
                        ItemTemplate="{StaticResource SplashChoice}" SelectedItem="{Binding SpinnerPlacement.Mode}"
                        VerticalAlignment="Center" AutomationProperties.Name="Spinner position" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right"
                        IsVisible="{Binding SpinnerPlacement.IsAnchor}">
              <ComboBox Width="150" ItemsSource="{x:Static s:SettingsViewModel.PlacementAnchorValues}"
                        ItemTemplate="{StaticResource SplashChoice}" SelectedItem="{Binding SpinnerPlacement.Anchor}"
                        VerticalAlignment="Center" AutomationProperties.Name="Spinner position: anchor" />
              <TextBlock Text="Inset" Classes="caption" VerticalAlignment="Center" />
              <NumericUpDown Width="110" Value="{Binding SpinnerPlacement.PaddingX}" Minimum="0" Maximum="4096"
                             FormatString="0" VerticalAlignment="Center"
                             AutomationProperties.Name="Spinner position: horizontal inset in pixels" />
              <NumericUpDown Width="110" Value="{Binding SpinnerPlacement.PaddingY}" Minimum="0" Maximum="4096"
                             FormatString="0" VerticalAlignment="Center"
                             AutomationProperties.Name="Spinner position: vertical inset in pixels" />
              <TextBlock Text="px" Classes="caption" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right"
                        IsVisible="{Binding SpinnerPlacement.IsAbsolute}">
              <TextBlock Text="X" Classes="caption" VerticalAlignment="Center" />
              <NumericUpDown Width="120" Value="{Binding SpinnerPlacement.X}" Minimum="0" Maximum="16384" FormatString="0"
                             VerticalAlignment="Center" AutomationProperties.Name="Spinner position: X in pixels" />
              <TextBlock Text="Y" Classes="caption" VerticalAlignment="Center" />
              <NumericUpDown Width="120" Value="{Binding SpinnerPlacement.Y}" Minimum="0" Maximum="16384" FormatString="0"
                             VerticalAlignment="Center" AutomationProperties.Name="Spinner position: Y in pixels" />
              <TextBlock Text="px on this screen" Classes="caption" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>

      <StackPanel x:Name="SplashColoursTab" Classes="settings-tab-panel" IsVisible="False">
        <Border Classes="setting-row">
          <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
            <TextBlock Text="Background" Classes="setting-title" VerticalAlignment="Center" />
            <!-- The swatch is the touch path; the adjacent Edit action opens
                             the controller keyboard because navigation skips TextBoxes
                             and cannot enter a color-picker flyout's popup root. -->
            <Button Grid.Column="1" Width="44" Height="44" MinWidth="44" MinHeight="44" Padding="0"
                    CornerRadius="4" VerticalAlignment="Center"
                    BorderBrush="{StaticResource HcControlBorderBrush}" BorderThickness="1"
                    Background="{Binding SplashBackgroundColorHex, Converter={x:Static c:HexBrushConverter.Instance}}"
                    Tag="Background" Click="OnSplashColorSwatchClick" ToolTip.Tip="Pick a colour"
                    AutomationProperties.Name="Pick splash background color" />
            <!-- 32 = the same cap NormalizeSplash puts on the persisted
                             color strings; the longest value that can ever parse is
                             "#AARRGGBB" or a known-color name. -->
            <TextBox Grid.Column="2" x:Name="SplashBackgroundColorBox" Width="100"
                     Text="{Binding SplashBackgroundColorHex}"
                     VerticalAlignment="Center" />
            <Button Grid.Column="3" Content="Type" Tag="BackgroundColor" Click="OnEditTextWithController"
                    AutomationProperties.Name="Edit splash background color with the on-screen keyboard" />
          </Grid>
        </Border>
        <Border Classes="setting-row">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <StackPanel VerticalAlignment="Center" Spacing="1">
              <TextBlock Text="Vignette" Classes="setting-title" />
              <TextBlock Text="Darkens the screen edges." Classes="caption" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding Splash.VignetteEnabled}" VerticalAlignment="Center" />
          </Grid>
        </Border>
        <Border Classes="setting-row">
          <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
            <TextBlock Text="Title" Classes="setting-title" VerticalAlignment="Center" />
            <Button Grid.Column="1" Width="44" Height="44" MinWidth="44" MinHeight="44" Padding="0"
                    CornerRadius="4" VerticalAlignment="Center"
                    BorderBrush="{StaticResource HcControlBorderBrush}" BorderThickness="1"
                    Background="{Binding SplashTextColorHex, Converter={x:Static c:HexBrushConverter.Instance}}"
                    Tag="Text" Click="OnSplashColorSwatchClick" ToolTip.Tip="Pick a colour"
                    AutomationProperties.Name="Pick splash text color" />
            <TextBox Grid.Column="2" x:Name="SplashTextColorBox" Width="100" Text="{Binding SplashTextColorHex}"

                     VerticalAlignment="Center" />
            <Button Grid.Column="3" Content="Type" Tag="TextColor" Click="OnEditTextWithController"
                    AutomationProperties.Name="Edit splash text color with the on-screen keyboard" />
          </Grid>
        </Border>
        <Border Classes="setting-row">
          <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
            <TextBlock Text="Caption" Classes="setting-title" VerticalAlignment="Center" />
            <Button Grid.Column="1" Width="44" Height="44" MinWidth="44" MinHeight="44" Padding="0"
                    CornerRadius="4" VerticalAlignment="Center"
                    BorderBrush="{StaticResource HcControlBorderBrush}" BorderThickness="1"
                    Background="{Binding SplashCaptionColorHex, Converter={x:Static c:HexBrushConverter.Instance}}"
                    Tag="Caption" Click="OnSplashColorSwatchClick" ToolTip.Tip="Pick a colour"
                    AutomationProperties.Name="Pick splash caption color" />
            <TextBox Grid.Column="2" x:Name="SplashCaptionColorBox" Width="100" Text="{Binding SplashCaptionColorHex}"

                     VerticalAlignment="Center" />
            <Button Grid.Column="3" Content="Type" Tag="CaptionColor" Click="OnEditTextWithController"
                    AutomationProperties.Name="Edit splash caption color with the on-screen keyboard" />
          </Grid>
        </Border>
        <Border Classes="setting-row">
          <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
            <TextBlock Text="Spinner" Classes="setting-title" VerticalAlignment="Center" />
            <Button Grid.Column="1" Width="44" Height="44" MinWidth="44" MinHeight="44" Padding="0"
                    CornerRadius="4" VerticalAlignment="Center"
                    BorderBrush="{StaticResource HcControlBorderBrush}" BorderThickness="1"
                    Background="{Binding SplashSpinnerColorHex, Converter={x:Static c:HexBrushConverter.Instance}}"
                    Tag="Spinner" Click="OnSplashColorSwatchClick" ToolTip.Tip="Pick a colour"
                    AutomationProperties.Name="Pick splash spinner color" />
            <TextBox Grid.Column="2" x:Name="SplashSpinnerColorBox" Width="100" Text="{Binding SplashSpinnerColorHex}"

                     VerticalAlignment="Center" />
            <Button Grid.Column="3" Content="Type" Tag="SpinnerColor" Click="OnEditTextWithController"
                    AutomationProperties.Name="Edit splash spinner color with the on-screen keyboard" />
          </Grid>
        </Border>
      </StackPanel>

      <StackPanel x:Name="SplashImagesTab" Classes="settings-tab-panel" IsVisible="False">
        <Border Classes="setting-row">
          <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
            <TextBlock Text="Logo image" Classes="setting-title" VerticalAlignment="Center" />
            <Panel Grid.Column="1" Width="44" Height="28" VerticalAlignment="Center">
              <Border Background="{StaticResource HcControlBrush}" CornerRadius="3" />
              <TextBlock x:Name="LogoNone" Text="NONE" FontSize="9" Classes="caption"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
              <Image x:Name="LogoThumb" Stretch="Uniform" Margin="2" IsVisible="False" />
            </Panel>
            <Button Grid.Column="2" Content="Browse" Tag="Logo" Click="OnBrowseImage" VerticalAlignment="Center" />
            <Button Grid.Column="3" Content="Clear" Tag="Logo" Click="OnClearImage" VerticalAlignment="Center" />
          </Grid>
        </Border>
        <Border Classes="setting-row">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBlock Text="Logo max size" Classes="setting-title" VerticalAlignment="Center" />
            <NumericUpDown Grid.Column="1" Width="110" Value="{Binding Splash.LogoMaxSize}"
                           Minimum="1" Maximum="4096" Increment="10" FormatString="0"
                           VerticalAlignment="Center" ToolTip.Tip="Longest edge in logical px" />
          </Grid>
        </Border>
        <Border Classes="setting-row">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBlock Text="Logo position" Classes="setting-title" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" Width="170" ItemsSource="{x:Static s:SettingsViewModel.PlacementModeValues}"
                        ItemTemplate="{StaticResource SplashChoice}" SelectedItem="{Binding LogoPlacement.Mode}"
                        VerticalAlignment="Center" AutomationProperties.Name="Logo position" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right"
                        IsVisible="{Binding LogoPlacement.IsAnchor}">
              <ComboBox Width="150" ItemsSource="{x:Static s:SettingsViewModel.PlacementAnchorValues}"
                        ItemTemplate="{StaticResource SplashChoice}" SelectedItem="{Binding LogoPlacement.Anchor}"
                        VerticalAlignment="Center" AutomationProperties.Name="Logo position: anchor" />
              <TextBlock Text="Inset" Classes="caption" VerticalAlignment="Center" />
              <NumericUpDown Width="110" Value="{Binding LogoPlacement.PaddingX}" Minimum="0" Maximum="4096"
                             FormatString="0" VerticalAlignment="Center"
                             AutomationProperties.Name="Logo position: horizontal inset in pixels" />
              <NumericUpDown Width="110" Value="{Binding LogoPlacement.PaddingY}" Minimum="0" Maximum="4096"
                             FormatString="0" VerticalAlignment="Center"
                             AutomationProperties.Name="Logo position: vertical inset in pixels" />
              <TextBlock Text="px" Classes="caption" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right"
                        IsVisible="{Binding LogoPlacement.IsAbsolute}">
              <TextBlock Text="X" Classes="caption" VerticalAlignment="Center" />
              <NumericUpDown Width="120" Value="{Binding LogoPlacement.X}" Minimum="0" Maximum="16384" FormatString="0"
                             VerticalAlignment="Center" AutomationProperties.Name="Logo position: X in pixels" />
              <TextBlock Text="Y" Classes="caption" VerticalAlignment="Center" />
              <NumericUpDown Width="120" Value="{Binding LogoPlacement.Y}" Minimum="0" Maximum="16384" FormatString="0"
                             VerticalAlignment="Center" AutomationProperties.Name="Logo position: Y in pixels" />
              <TextBlock Text="px on this screen" Classes="caption" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
        </Border>
        <Border Classes="setting-row">
          <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
            <TextBlock Text="Background image" Classes="setting-title" VerticalAlignment="Center" />
            <Panel Grid.Column="1" Width="44" Height="28" VerticalAlignment="Center">
              <Border Background="{StaticResource HcControlBrush}" CornerRadius="3" />
              <TextBlock x:Name="BackgroundNone" Text="NONE" FontSize="9" Classes="caption"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
              <Image x:Name="BackgroundThumb" Stretch="Uniform" Margin="2" IsVisible="False" />
            </Panel>
            <Button Grid.Column="2" Content="Browse" Tag="Background" Click="OnBrowseImage" VerticalAlignment="Center" />
            <Button Grid.Column="3" Content="Clear" Tag="Background" Click="OnClearImage" VerticalAlignment="Center" />
          </Grid>
        </Border>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>

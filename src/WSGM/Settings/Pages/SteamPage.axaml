<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="using:WSGM.Settings"
             xmlns:c="using:WSGM.Controls"
             x:Class="WSGM.Settings.Pages.SteamPage"
             x:DataType="s:SettingsViewModel">
    <!-- The old "Home" page. Element order preserved (controller tab order):
         Big Picture info → Steam status → auto-relaunch → UAC → lock-on-wake. -->
    <Border Padding="16,10,16,10">
        <Grid ColumnDefinitions="*,24,*">
            <StackPanel Grid.Column="0">
                <Border Classes="section-header">
                    <TextBlock Text="STEAM" />
                </Border>
                <Border Classes="setting-row alt">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Path Data="{x:Static c:Icons.SteamLike}"
                              Stroke="{StaticResource HcTextPrimaryBrush}" StrokeThickness="1.8"
                              Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="Steam Big Picture" Classes="setting-title" />
                            <TextBlock Text="WSGM starts Steam Big Picture at logon and returns to it when you leave the desktop. Steam is found automatically." Classes="caption" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Classes="setting-row">
                    <TextBlock Text="{Binding SteamStatusText}" Classes="caption" VerticalAlignment="Center" />
                </Border>

                <Border Classes="section-header">
                    <TextBlock Text="SESSION" />
                </Border>
                <Border Classes="setting-row alt">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="Restart Steam when it exits" Classes="setting-title" />
                            <TextBlock Text="Automatically bring Big Picture back after Steam closes." Classes="caption" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding SteamAutoRelaunch}" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Border Classes="section-header">
                    <TextBlock Text="STEAMGRIDDB" />
                </Border>
                <Border Classes="setting-row alt">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Change Artwork API key" Classes="setting-title" />
                        <TextBlock Text="Paste your free SteamGridDB key to enable swapping game art from the overlay (Tools → Change Artwork)."
                                   Classes="caption" TextWrapping="Wrap" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                            <TextBox x:Name="SteamGridDbKeyBox" Text="{Binding SteamGridDbApiKey}"
                                     PlaceholderText="SteamGridDB API key" />
                            <Button Grid.Column="1" Content="Type with controller"
                                    Click="OnOpenApiKeyKeyboard" />
                        </Grid>
                        <TextBlock Text="Get one free at steamgriddb.com/profile/preferences/api"
                                   Classes="caption" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <Border Classes="section-header">
                    <TextBlock Text="STEAM INTEGRATION (CEF)" />
                </Border>
                <Border Classes="setting-row alt">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="Steam CEF integration" Classes="setting-title" />
                            <TextBlock Text="Master switch for everything WSGM injects into Steam over its debug port. Off leaves the debug port closed and hides every feature below." Classes="caption" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding CefEnabled}" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <Border Classes="setting-row" IsVisible="{Binding CefEnabled}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="Library &amp; tabs" Classes="setting-title" />
                            <TextBlock Text="Custom filter tabs, tab order, and hiding native Steam tabs." Classes="caption" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding CefLibraryTabs}" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <Border Classes="setting-row alt" IsVisible="{Binding CefEnabled}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="SD-card library manager" Classes="setting-title" />
                            <TextBlock Text="Per-card library tabs, the &quot;On: card&quot; game-page badges, and live library labels." Classes="caption" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding CefCardManager}" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <Border Classes="setting-row" IsVisible="{Binding CefEnabled}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="Format SD Card + add library" Classes="setting-title" />
                            <TextBlock Text="Format a card as a Steam library and register it into the running Steam." Classes="caption" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding CefSdFormat}" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <Border Classes="setting-row alt" IsVisible="{Binding CefEnabled}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="Shortcut artwork" Classes="setting-title" />
                            <TextBlock Text="Swap game art from SteamGridDB via the overlay." Classes="caption" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding CefArtwork}" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <Border Classes="setting-row" IsVisible="{Binding CefEnabled}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="Big Picture Wi-Fi indicator" Classes="setting-title" />
                            <TextBlock Text="Make Big Picture's header Wi-Fi icon reflect the real connection." Classes="caption" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding CefWifiIndicator}" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Border Classes="section-header">
                    <TextBlock Text="WINDOWS POLICIES" />
                </Border>
                <Border Classes="setting-row alt">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="Never show UAC prompts on this PC" Classes="setting-title" />
                            <TextBlock Text="Applies to every administrator account. Enable only on a personal device you trust." Classes="caption" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" x:Name="UacCheckBox" IsChecked="{Binding UacPromptsDisabled, Mode=OneWay}" Click="OnToggleUac" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <Border Classes="setting-row">
                    <TextBlock Text="{Binding UacStatusText}" Classes="caption" VerticalAlignment="Center" />
                </Border>
                <Border Classes="setting-row alt">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="No lock screen after standby" Classes="setting-title" />
                            <TextBlock Text="Keep a personal handheld ready after it wakes. Anyone with the device can use the current session." Classes="caption" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" x:Name="LockOnWakeCheckBox" IsChecked="{Binding LockOnWakeDisabled, Mode=OneWay}" Click="OnToggleLockOnWake" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <Border Classes="setting-row">
                    <TextBlock Text="{Binding LockOnWakeStatusText}" Classes="caption" VerticalAlignment="Center" />
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>

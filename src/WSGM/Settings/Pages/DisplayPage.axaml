<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="using:WSGM.Settings"
             xmlns:p="using:WSGM.Settings.Pages"
             x:Class="WSGM.Settings.Pages.DisplayPage"
             x:DataType="s:SettingsViewModel">
  <UserControl.Resources>
    <DataTemplate x:Key="PluginArgumentRow" x:DataType="s:PluginArgumentRow">
      <Grid ColumnDefinitions="160,*" ColumnSpacing="8" Margin="0,2">
        <TextBlock Text="{Binding Label}" Classes="caption" VerticalAlignment="Center" />
        <CheckBox Grid.Column="1" IsChecked="{Binding BooleanValue}" IsVisible="{Binding IsBoolean}" />
        <ComboBox Grid.Column="1" ItemsSource="{Binding Choices}" SelectedItem="{Binding TextValue}"
                  HorizontalAlignment="Stretch" IsVisible="{Binding IsChoice}" />
        <StackPanel Grid.Column="1" Spacing="2" IsVisible="{Binding IsText}">
          <TextBox Text="{Binding TextValue}" />
          <TextBlock Text="{Binding ValidationText}" Classes="caption" TextWrapping="Wrap"
                     IsVisible="{Binding HasValidationError}" />
        </StackPanel>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="PluginActionStepRow" x:DataType="s:PluginActionStepEditorRow">
      <Border Classes="setting-row alt">
        <StackPanel Spacing="4">
          <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
            <TextBlock Text="{Binding Title}" Classes="setting-title" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Up"
                    Command="{Binding $parent[UserControl].((s:SettingsViewModel)DataContext).MoveActionStepUpCommand, FallbackValue={x:Null}}"
                    CommandParameter="{Binding}" />
            <Button Grid.Column="2" Content="Down"
                    Command="{Binding $parent[UserControl].((s:SettingsViewModel)DataContext).MoveActionStepDownCommand, FallbackValue={x:Null}}"
                    CommandParameter="{Binding}" />
            <Button Grid.Column="3" Content="Remove"
                    Command="{Binding $parent[UserControl].((s:SettingsViewModel)DataContext).RemoveActionStepCommand, FallbackValue={x:Null}}"
                    CommandParameter="{Binding}" />
          </Grid>
          <TextBlock Text="{Binding UnavailableText}" Classes="caption" TextWrapping="Wrap"
                     IsVisible="{Binding !Available}" />
          <TextBlock Text="{Binding SavedArguments}" Classes="caption" TextWrapping="Wrap"
                     IsVisible="{Binding !Available}" />
          <ItemsControl ItemsSource="{Binding Arguments}" ItemTemplate="{StaticResource PluginArgumentRow}"
                        IsVisible="{Binding Available}" />
          <Grid ColumnDefinitions="160,120" ColumnSpacing="8">
            <TextBlock Text="Deadline (seconds)" Classes="caption" VerticalAlignment="Center" />
            <NumericUpDown Grid.Column="1" Value="{Binding TimeoutSeconds}" Minimum="1" Maximum="120" />
          </Grid>
        </StackPanel>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="PluginActionList" x:DataType="s:PluginActionListEditor">
      <StackPanel IsVisible="{Binding HasEditor}">
        <Border Classes="setting-row">
          <Grid ColumnDefinitions="*,260,Auto" ColumnSpacing="8">
            <TextBlock Text="{Binding Title}" Classes="setting-title" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Choices}" SelectedIndex="{Binding ChoiceIndex}"
                      HorizontalAlignment="Stretch" IsVisible="{Binding CanAdd}" />
            <Button Grid.Column="2" Content="Add step" IsVisible="{Binding CanAdd}"
                    Command="{Binding $parent[UserControl].((s:SettingsViewModel)DataContext).AddActionStepCommand, FallbackValue={x:Null}}"
                    CommandParameter="{Binding}" />
          </Grid>
        </Border>
        <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource PluginActionStepRow}" />
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>
  <ScrollViewer>
    <StackPanel Margin="20,16" Spacing="16">
      <Expander Header="GPU-scaled resolutions" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
        <StackPanel DataContext="{Binding ScaledResolutions}" x:DataType="s:ScaledResolutionEditor" Spacing="10">
          <TextBlock Text="Add source sizes without changing your active resolution, refresh rate or panel timing. This catalog is global, independent of game profiles. Edits are saved immediately." Classes="caption" TextWrapping="Wrap" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <ComboBox ItemsSource="{Binding Displays}" SelectedItem="{Binding Display}" HorizontalAlignment="Stretch" PlaceholderText="Choose a display" IsEnabled="{Binding !Busy}" />
            <Button Grid.Column="1" Content="Refresh displays" Command="{Binding RefreshCommand}" IsEnabled="{Binding !Busy}" />
          </Grid>
          <TextBlock Text="{Binding AdapterText}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding NativeText}" Classes="caption" />
          <TextBlock Text="{Binding CatalogText}" Classes="caption" TextWrapping="Wrap" />
          <StackPanel Spacing="8" IsEnabled="{Binding CanEdit}">
            <Grid ColumnDefinitions="*,Auto,*,Auto,Auto" ColumnSpacing="8">
              <TextBox x:Name="ScaledWidthBox" Text="{Binding Width}" PlaceholderText="Width in pixels" MaxLength="5" />
              <Button Grid.Column="1" Content="Edit width" Click="OnEditScaledDimension" Tag="Width" />
              <TextBox Grid.Column="2" x:Name="ScaledHeightBox" Text="{Binding Height}" PlaceholderText="Height in pixels" MaxLength="5" />
              <Button Grid.Column="3" Content="Edit height" Click="OnEditScaledDimension" Tag="Height" />
              <Button Grid.Column="4" Content="Add resolution" Command="{Binding AddCommand}" IsEnabled="{Binding !Busy}" />
            </Grid>
            <Button Content="Preview 100% to 50% in 5% steps" Command="{Binding PreviewCommand}" HorizontalAlignment="Left" />
            <TextBlock Text="{Binding PreviewText}" TextWrapping="Wrap" />
            <Button Content="Add previewed resolutions" Command="{Binding ApplyPreviewCommand}" IsEnabled="{Binding !Busy}" HorizontalAlignment="Left" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <ComboBox ItemsSource="{Binding Additions}" SelectedItem="{Binding Addition}" PlaceholderText="WSGM additions" HorizontalAlignment="Stretch" />
              <Button Grid.Column="1" Content="Remove addition" Command="{Binding RemoveCommand}" IsEnabled="{Binding !Busy}" />
            </Grid>
            <Button Content="Reapply missing additions" Command="{Binding ReapplyCommand}" IsVisible="{Binding HasMissing}" IsEnabled="{Binding !Busy}" HorizontalAlignment="Left" />
            <TextBlock Text="Restarting the graphics driver can blank every display on this GPU and interrupt games. Restart only when you are ready." TextWrapping="Wrap" Classes="caption" IsVisible="{Binding NeedsRestart}" />
            <Button Content="Restart this graphics driver now" Command="{Binding RestartCommand}" IsVisible="{Binding NeedsRestart}" IsEnabled="{Binding !Busy}" HorizontalAlignment="Left" />
          </StackPanel>
          <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
        </StackPanel>
      </Expander>
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <StackPanel Spacing="4">
          <TextBlock Text="Display layouts" FontSize="22" FontWeight="SemiBold" />
          <TextBlock Text="Choose how your screens work when you switch modes." Classes="caption" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Button Content="Game Mode" Command="{Binding EditGameLayoutCommand}"
                  Classes.primary="{Binding !EditingDesktopLayout}" Padding="16,8" />
          <Button Content="Desktop" Command="{Binding EditDesktopLayoutCommand}"
                  Classes.primary="{Binding EditingDesktopLayout}" Padding="16,8" />
        </StackPanel>
      </Grid>
      <Border BorderBrush="{StaticResource HcControlBorderBrush}" BorderThickness="0,1" Padding="0,12">
        <Grid ColumnDefinitions="*,270" ColumnSpacing="16">
          <StackPanel Spacing="3" IsVisible="{Binding !EditingDesktopLayout}">
            <TextBlock Text="When entering Game Mode" Classes="setting-title" />
            <TextBlock Text="Apply this layout before opening Big Picture." Classes="caption" />
          </StackPanel>
          <StackPanel Grid.Column="0" Spacing="3" IsVisible="{Binding EditingDesktopLayout}">
            <TextBlock Text="When returning to Desktop" Classes="setting-title" />
            <TextBlock Text="Restore the previous arrangement or use your saved Desktop layout." Classes="caption" />
          </StackPanel>
          <ComboBox Grid.Column="1" SelectedIndex="{Binding GameModeLaunchKindIndex}"
                    IsVisible="{Binding !EditingDesktopLayout}" HorizontalAlignment="Stretch"
                    VerticalAlignment="Center">
            <ComboBoxItem Content="Keep layout, use 100% scaling" />
            <ComboBoxItem Content="Use a custom layout" />
          </ComboBox>
          <ComboBox Grid.Column="1" SelectedIndex="{Binding GameModeReturnIndex}"
                    IsVisible="{Binding EditingDesktopLayout}" HorizontalAlignment="Stretch" VerticalAlignment="Center">
            <ComboBoxItem Content="Restore the previous layout" />
            <ComboBoxItem Content="Use a saved Desktop layout" />
          </ComboBox>
        </Grid>
      </Border>
      <TextBlock Text="{Binding DisplayPolicySummary}" Classes="caption" IsVisible="{Binding !ShowLayoutEditor}" />
      <StackPanel Spacing="12" IsVisible="{Binding ShowLayoutEditor}" IsEnabled="{Binding !ReadingDisplays}">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
          <TextBlock Text="Display arrangement" Classes="setting-title" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="Refresh display list" Command="{Binding RefreshDisplaysCommand}"
                  IsEnabled="{Binding !ReadingDisplays}" />
          <Button Grid.Column="2" Content="Copy current desktop" Command="{Binding CopyCurrentLayoutCommand}"
                  IsEnabled="{Binding !ReadingDisplays}" />
        </Grid>
        <TextBlock Text="{Binding DisplayDiscoveryText}" Classes="layout-warning" TextWrapping="Wrap"
                   IsVisible="{Binding HasDisplayDiscoveryMessage}" />
        <p:DisplayLayoutView DataContext="{Binding CurrentDisplayLayout}" />
        <Expander Header="Audio configuration" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Stretch">
          <StackPanel DataContext="{Binding CurrentAudioProfile}" Spacing="10">
            <TextBlock
              Text="Saved here only. Windows audio changes when this display profile is applied, not when you save Settings."
              Classes="caption" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
              <StackPanel Spacing="3">
                <TextBlock Text="Playback device" Classes="caption" />
                <ComboBox ItemsSource="{Binding OutputChoices}" SelectedItem="{Binding Output}"
                          PlaceholderText="Leave unchanged" HorizontalAlignment="Stretch" />
              </StackPanel>
              <Button Grid.Column="1" Content="Refresh audio" Click="OnRefreshAudio"
                      VerticalAlignment="Bottom" />
            </Grid>
            <StackPanel Spacing="3">
              <TextBlock Text="Recording device" Classes="caption" />
              <ComboBox ItemsSource="{Binding InputChoices}" SelectedItem="{Binding Input}"
                        PlaceholderText="Leave unchanged" HorizontalAlignment="Stretch" />
            </StackPanel>
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
              <CheckBox Content="Set volume" IsChecked="{Binding ApplyVolume}" VerticalAlignment="Center" />
              <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding VolumePercent}"
                      IsEnabled="{Binding ApplyVolume}" />
              <TextBlock Grid.Column="2" Text="{Binding VolumePercent}" VerticalAlignment="Center" />
            </Grid>
            <CheckBox Content="Set muted state" IsChecked="{Binding ApplyMute}" />
            <CheckBox Content="Mute playback" IsChecked="{Binding Muted}" IsEnabled="{Binding ApplyMute}" />
            <StackPanel Spacing="3">
              <TextBlock Text="Channel layout and default format" Classes="caption" />
              <ComboBox ItemsSource="{Binding FormatChoices}" SelectedItem="{Binding PlaybackFormat}"
                        PlaceholderText="Leave unchanged" HorizontalAlignment="Stretch" />
            </StackPanel>
            <StackPanel Spacing="3">
              <TextBlock Text="Spatial sound" Classes="caption" />
              <ComboBox ItemsSource="{Binding SpatialChoices}" SelectedItem="{Binding SpatialFormat}"
                        PlaceholderText="Leave unchanged" HorizontalAlignment="Stretch" />
            </StackPanel>
          </StackPanel>
        </Expander>
        <Expander Header="Manage remembered displays" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Stretch">
          <StackPanel Spacing="8">
            <TextBlock Text="Forgetting a display removes it from both saved layouts." Classes="caption" />
            <Button Content="Forget selected display" Command="{Binding ForgetDisplayCommand}"
                    CommandParameter="{Binding CurrentDisplayLayout.Selected}" HorizontalAlignment="Left"
                    IsEnabled="{Binding CurrentDisplayLayout.HasSelection}" />
          </StackPanel>
        </Expander>
        <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource HcControlBorderBrush}" Padding="0,12,0,0"
                IsVisible="{Binding !EditingDesktopLayout}">
          <Grid ColumnDefinitions="*,270" ColumnSpacing="16">
            <StackPanel Spacing="3">
              <TextBlock Text="Wait for a display" Classes="setting-title" />
              <TextBlock Text="If disconnected, wait on the switch screen with Cancel available." Classes="caption" />
            </StackPanel>
            <ComboBox Grid.Column="1" ItemsSource="{Binding WaitForDisplayChoices}"
                      SelectedIndex="{Binding WaitForDisplayIndex}" HorizontalAlignment="Stretch" />
          </Grid>
        </Border>
      </StackPanel>
      <Expander Header="Session actions" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
        <StackPanel Spacing="8">
          <TextBlock Text="Optional plugin actions for entering or leaving Game Mode, desktop startup and wake."
                     Classes="caption" />
          <TextBlock Text="{Binding ActionLists[0].AddHintText}" IsVisible="{Binding !ActionLists[0].CanAdd}"
                     Classes="caption" />
          <ItemsControl ItemsSource="{Binding ActionLists}" ItemTemplate="{StaticResource PluginActionList}" />
        </StackPanel>
      </Expander>
      <TextBlock Text="Save changes to apply these layouts on the next switch. Your current desktop stays as it is."
                 Classes="caption" />
    </StackPanel>
  </ScrollViewer>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="using:WSGM.Settings"
             x:Class="WSGM.Settings.Pages.DisplayPage"
             x:DataType="s:SettingsViewModel">
    <UserControl.Resources>
        <DataTemplate x:Key="DisplayRow" x:DataType="s:DisplayLayoutEditorRow">
            <Border Classes="setting-row">
                <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <StackPanel Spacing="1">
                            <TextBlock Text="{Binding DisplayName}" Classes="setting-title" />
                            <TextBlock Text="{Binding PresenceText}" Classes="caption"
                                       IsVisible="{Binding !Present}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Content="Active" IsChecked="{Binding Active}" />
                        <Button Grid.Column="2" Content="Forget"
                                Command="{Binding $parent[UserControl].((s:SettingsViewModel)DataContext).ForgetDisplayCommand}"
                                CommandParameter="{Binding}" />
                    </Grid>
                    <StackPanel Spacing="6" IsVisible="{Binding Active}">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                            <CheckBox Content="Primary" IsChecked="{Binding IsPrimary}" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}"
                                      HorizontalAlignment="Stretch" IsVisible="{Binding HasModes}" />
                            <TextBlock Grid.Column="1" Classes="caption" VerticalAlignment="Center"
                                       IsVisible="{Binding !HasModes}"
                                       Text="No modes are remembered for this display yet. Connect it and press Snapshot." />
                            <NumericUpDown Grid.Column="2" Value="{Binding DpiPercent}" Minimum="100" Maximum="500"
                                           Increment="25" Width="120" />
                            <CheckBox Grid.Column="3" Content="HDR" IsChecked="{Binding HdrEnabled}"
                                      IsVisible="{Binding HdrSupported}" VerticalAlignment="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="8" IsVisible="{Binding !IsPrimary}">
                            <TextBlock Text="X" VerticalAlignment="Center" Classes="caption" />
                            <NumericUpDown Grid.Column="1" Value="{Binding X}" Minimum="-32768" Maximum="32768"
                                           Increment="10" />
                            <TextBlock Grid.Column="2" Text="Y" VerticalAlignment="Center" Classes="caption" />
                            <NumericUpDown Grid.Column="3" Value="{Binding Y}" Minimum="-32768" Maximum="32768"
                                           Increment="10" />
                        </Grid>
                        <Grid ColumnDefinitions="*,220,Auto" ColumnSpacing="8" IsVisible="{Binding NeedsRebind}">
                            <TextBlock Text="{Binding RebindText}" TextWrapping="Wrap" Classes="caption"
                                       VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding $parent[UserControl].((s:SettingsViewModel)DataContext).RebindChoices}"
                                      SelectedIndex="{Binding $parent[UserControl].((s:SettingsViewModel)DataContext).RebindChoiceIndex}" />
                            <Button Grid.Column="2" Content="Use this display"
                                    Command="{Binding $parent[UserControl].((s:SettingsViewModel)DataContext).RebindDisplayCommand}"
                                    CommandParameter="{Binding}" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="PluginArgumentRow" x:DataType="s:PluginArgumentRow">
            <Grid ColumnDefinitions="160,*" ColumnSpacing="8" Margin="0,2">
                <TextBlock Text="{Binding Label}" Classes="caption" VerticalAlignment="Center" />
                <CheckBox Grid.Column="1" IsChecked="{Binding BooleanValue}" IsVisible="{Binding IsBoolean}" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding Choices}" SelectedItem="{Binding TextValue}"
                          HorizontalAlignment="Stretch" IsVisible="{Binding IsChoice}" />
                <StackPanel Grid.Column="1" Spacing="2" IsVisible="{Binding IsText}">
                    <TextBox Text="{Binding TextValue}" />
                    <TextBlock Text="{Binding ValidationText}" Classes="caption" TextWrapping="Wrap"
                               IsVisible="{Binding HasValidationError}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="PluginActionStepRow" x:DataType="s:PluginActionStepEditorRow">
            <Border Classes="setting-row alt">
                <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                        <TextBlock Text="{Binding Title}" Classes="setting-title" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Up"
                                Command="{Binding $parent[UserControl].((s:SettingsViewModel)DataContext).MoveActionStepUpCommand}"
                                CommandParameter="{Binding}" />
                        <Button Grid.Column="2" Content="Down"
                                Command="{Binding $parent[UserControl].((s:SettingsViewModel)DataContext).MoveActionStepDownCommand}"
                                CommandParameter="{Binding}" />
                        <Button Grid.Column="3" Content="Remove"
                                Command="{Binding $parent[UserControl].((s:SettingsViewModel)DataContext).RemoveActionStepCommand}"
                                CommandParameter="{Binding}" />
                    </Grid>
                    <TextBlock Text="{Binding UnavailableText}" Classes="caption" TextWrapping="Wrap"
                               IsVisible="{Binding !Available}" />
                    <TextBlock Text="{Binding SavedArguments}" Classes="caption" TextWrapping="Wrap"
                               IsVisible="{Binding !Available}" />
                    <ItemsControl ItemsSource="{Binding Arguments}" ItemTemplate="{StaticResource PluginArgumentRow}"
                                  IsVisible="{Binding Available}" />
                    <Grid ColumnDefinitions="160,120" ColumnSpacing="8">
                        <TextBlock Text="Deadline (seconds)" Classes="caption" VerticalAlignment="Center" />
                        <NumericUpDown Grid.Column="1" Value="{Binding TimeoutSeconds}" Minimum="1" Maximum="120" />
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="PluginActionList" x:DataType="s:PluginActionListEditor">
            <StackPanel>
                <Border Classes="setting-row">
                    <Grid ColumnDefinitions="*,260,Auto" ColumnSpacing="8">
                        <TextBlock Text="{Binding Title}" Classes="setting-title" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Choices}" SelectedIndex="{Binding ChoiceIndex}"
                                  HorizontalAlignment="Stretch" IsVisible="{Binding CanAdd}" />
                        <Button Grid.Column="2" Content="Add step" IsVisible="{Binding CanAdd}"
                                Command="{Binding $parent[UserControl].((s:SettingsViewModel)DataContext).AddActionStepCommand}"
                                CommandParameter="{Binding}" />
                    </Grid>
                </Border>
                <Border Classes="setting-row" IsVisible="{Binding !CanAdd}">
                    <TextBlock Text="{Binding AddHintText}" Classes="caption" TextWrapping="Wrap" />
                </Border>
                <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource PluginActionStepRow}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer>
        <Border Padding="16,10">
            <StackPanel>
                <Border Classes="section-header"><TextBlock Text="GAME MODE DISPLAY" /></Border>
                <Border Classes="setting-row alt">
                    <Grid ColumnDefinitions="*,220" ColumnSpacing="12">
                        <StackPanel Spacing="1">
                            <TextBlock Text="Entering Game Mode" Classes="setting-title" />
                            <TextBlock Text="Default starts on the display Windows already calls primary and adjusts scaling only. Custom applies a saved layout, after optionally waiting for a display and running plugin actions."
                                       Classes="caption" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" SelectedIndex="{Binding GameModeLaunchKindIndex}">
                            <ComboBoxItem Content="Default" />
                            <ComboBoxItem Content="Custom" />
                        </ComboBox>
                    </Grid>
                </Border>

                <Border Classes="setting-row">
                    <TextBlock Text="{Binding LaunchSummaryText}" TextWrapping="Wrap" Classes="caption" />
                </Border>

                <StackPanel IsVisible="{Binding ShowCustomLaunch}">
                    <Border Classes="setting-row alt">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel Spacing="1">
                                <TextBlock Text="Game Mode layout" Classes="setting-title" />
                                <TextBlock Text="Arrange the displays the way Game Mode should use them, then capture."
                                           Classes="caption" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Snapshot" Command="{Binding SnapshotGameLayoutCommand}" />
                        </Grid>
                    </Border>
                    <ItemsControl ItemsSource="{Binding GameLayout.Rows}"
                                  ItemTemplate="{StaticResource DisplayRow}" />
                    <Border Classes="setting-row" IsVisible="{Binding GameLayout.HasValidationError}">
                        <TextBlock Text="{Binding GameLayout.ValidationText}" TextWrapping="Wrap" Classes="caption" />
                    </Border>

                    <Border Classes="setting-row alt">
                        <Grid ColumnDefinitions="*,260" ColumnSpacing="12">
                            <StackPanel Spacing="1">
                                <TextBlock Text="Wait for a display" Classes="setting-title" />
                                <TextBlock Text="Game Mode waits for this display without a time limit. The splash offers Cancel while it waits."
                                           Classes="caption" TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding WaitForDisplayChoices}"
                                      SelectedIndex="{Binding WaitForDisplayIndex}" HorizontalAlignment="Stretch" />
                        </Grid>
                    </Border>
                </StackPanel>

                <Border Classes="section-header"><TextBlock Text="LEAVING GAME MODE" /></Border>
                <Border Classes="setting-row alt">
                    <Grid ColumnDefinitions="*,220" ColumnSpacing="12">
                        <StackPanel Spacing="1">
                            <TextBlock Text="Restore" Classes="setting-title" />
                            <TextBlock Text="Either whatever was on screen when Game Mode started, or a saved Desktop layout."
                                       Classes="caption" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" SelectedIndex="{Binding GameModeReturnIndex}">
                            <ComboBoxItem Content="What entry found" />
                            <ComboBoxItem Content="A saved Desktop layout" />
                        </ComboBox>
                    </Grid>
                </Border>
                <StackPanel IsVisible="{Binding ShowDesktopLayout}">
                    <Border Classes="setting-row">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <TextBlock Text="Desktop layout" Classes="setting-title" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="Snapshot" Command="{Binding SnapshotDesktopLayoutCommand}" />
                        </Grid>
                    </Border>
                    <ItemsControl ItemsSource="{Binding DesktopLayout.Rows}"
                                  ItemTemplate="{StaticResource DisplayRow}" />
                    <Border Classes="setting-row" IsVisible="{Binding DesktopLayout.HasValidationError}">
                        <TextBlock Text="{Binding DesktopLayout.ValidationText}" TextWrapping="Wrap" Classes="caption" />
                    </Border>
                </StackPanel>

                <Border Classes="section-header"><TextBlock Text="PLUGIN ACTIONS" /></Border>
                <Border Classes="setting-row alt">
                    <TextBlock TextWrapping="Wrap" Classes="caption"
                               Text="Saved plugin actions run at the four session events below. Entry stops at the first failure; the other three run every step and report what failed. Nothing is ever retried." />
                </Border>
                <ItemsControl ItemsSource="{Binding ActionLists}" ItemTemplate="{StaticResource PluginActionList}" />
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>

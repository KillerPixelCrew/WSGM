<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="using:WSGM.Settings"
        xmlns:pages="using:WSGM.Settings.Pages"
        xmlns:c="using:WSGM.Controls"
        xmlns:ov="using:WSGM.Overlay"
        x:Class="WSGM.Settings.SettingsWindow"
        x:DataType="s:SettingsViewModel"
        Title="WSGM"
        Icon="/Assets/wsgm.ico"
        Width="1280" Height="720" MinWidth="1024" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource HcBackgroundBrush}">

    <!-- Dense two-column utility layout (approved "Option 3 rev 2"): bumper
         TabStrip on top, five always-alive pages toggled by IsVisible (scroll
         positions survive), status strip at the bottom. These styles are the
         setting-row family shared by every page: zebra rows on the page surface
         (HcHeaderBrush) with HcBackgroundBrush "alt" stripes, a 2 px transparent
         border that turns accent when the row's focusable control holds focus,
         accent uppercase section headers with a hairline rule, and compact
         "mini" control metrics. -->
    <Window.Styles>
        <Style Selector="Border.section-header">
            <Setter Property="BorderBrush" Value="{StaticResource HcCardBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="2,0,0,4" />
            <Setter Property="Margin" Value="0,8,0,4" />
        </Style>
        <Style Selector="Border.section-header TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource HcAccentBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LetterSpacing" Value="1.5" />
        </Style>

        <Style Selector="Border.setting-row">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Border.setting-row.alt">
            <Setter Property="Background" Value="{StaticResource HcBackgroundBrush}" />
        </Style>
        <Style Selector="Border.setting-row:focus-within">
            <Setter Property="BorderBrush" Value="{DynamicResource HcAccentBrush}" />
        </Style>

        <!-- Mini controls inside rows: one step tighter than the app-wide metrics. -->
        <Style Selector="Border.setting-row TextBlock.setting-title">
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="Border.setting-row Button">
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Padding" Value="8,1" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Border.setting-row TextBox, Border.setting-row ComboBox, Border.setting-row NumericUpDown">
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Border.setting-row ToggleSwitch, Border.setting-row CheckBox">
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0"
                Background="{StaticResource HcBackgroundBrush}"
                BorderBrush="{StaticResource HcCardBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="14,6">
            <!-- Tab descriptors (labels + Icons geometries) are assigned in
                 code-behind; LB/RB cycle via GamepadNavigation. -->
            <c:TabStrip x:Name="Tabs" />
        </Border>

        <Grid Grid.Row="1" Background="{StaticResource HcHeaderBrush}">
            <pages:SystemPage x:Name="PageSystem" IsVisible="True" />
            <pages:SteamPage x:Name="PageSteam" IsVisible="False" />
            <pages:IntegrationPage x:Name="PageIntegration" IsVisible="False" />
            <pages:StartupPage x:Name="PageStartup" IsVisible="False" />
            <pages:QuickAccessPage x:Name="PageQuickAccess" IsVisible="False" />
            <pages:AppearancePage x:Name="PageAppearance" IsVisible="False" />
        </Grid>

        <Border Grid.Row="2" Classes="hc-footer">
            <Grid Margin="12,5" ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="16">
                <Button Classes="primary" Content="Save changes" Command="{Binding SaveCommand}" MinWidth="120" />
                <TextBlock Grid.Column="1" Text="{Binding ServiceStateText}" Classes="caption" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding ShellStateText}" Classes="caption" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="{Binding StatusText}" Classes="caption" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <ov:GlyphIcon Width="18" Height="18" Button="a" GlyphStyle="{Binding GlyphStyle}" VerticalAlignment="Center" />
                        <TextBlock Text="Select" Classes="caption" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <ov:GlyphIcon Width="18" Height="18" Button="b" GlyphStyle="{Binding GlyphStyle}" VerticalAlignment="Center" />
                        <TextBlock Text="Back" Classes="caption" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="LB/RB  Tab" Classes="caption" VerticalAlignment="Center" />
                    <TextBlock Text="D-pad  Navigate" Classes="caption" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

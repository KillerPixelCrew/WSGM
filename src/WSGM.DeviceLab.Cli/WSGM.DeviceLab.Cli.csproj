<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- The documented command name is `wsgm-device`; the project keeps the WSGM
         naming convention so it sorts with its siblings in the solution. -->
    <AssemblyName>wsgm-device</AssemblyName>
    <RootNamespace>WSGM.DeviceLab.Cli</RootNamespace>
    <SelfContained>false</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\WSGM.DeviceLab.Core\WSGM.DeviceLab.Core.csproj" />
  </ItemGroup>
</Project>

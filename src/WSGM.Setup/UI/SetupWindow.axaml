<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:WSGM.Setup.UI"
        x:Class="WSGM.Setup.UI.SetupWindow"
        x:DataType="ui:SetupViewModel"
        Title="WSGM Setup"
        Width="1280" Height="800" MinWidth="1024" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        TransparencyLevelHint="AcrylicBlur, Blur"
        Background="#CC1F1F1F">
  <!-- Layout and wording follow the approved mockup, src\WSGM.Setup\docs\mockup.html. -->
  <Window.DataTemplates>
    <DataTemplate DataType="ui:MessagePage">
      <StackPanel />
    </DataTemplate>

    <DataTemplate DataType="ui:WelcomePage">
      <Border Classes="card">
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="18" RowSpacing="8">
          <TextBlock Classes="muted" Text="Installs to" />
          <TextBlock Grid.Column="1" Classes="mono" Text="{Binding InstallPath}" />
          <TextBlock Grid.Row="1" Classes="muted" Text="Steam" />
          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SteamStatus}" />
          <TextBlock Grid.Row="2" Classes="muted" Text="Needs" />
          <TextBlock Grid.Row="2" Grid.Column="1" Text="No internet connection." />
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate DataType="ui:LegacyPage">
      <Border Classes="banner">
        <TextBlock TextWrapping="Wrap"
                   Text="WSGM and Steam close while the old version is removed. Close any running game first." />
      </Border>
    </DataTemplate>

    <DataTemplate DataType="ui:UpdatePage">
      <StackPanel Spacing="14">
        <Border Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Classes="section" Text="WHAT CHANGES" />
            <ItemsControl ItemsSource="{Binding Changes}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Classes="row-title" Text="{Binding}" Margin="0,4" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
        <ItemsControl ItemsSource="{Binding Outdated}" IsVisible="{Binding HasOutdated}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <Border Classes="banner warn" Margin="0,0,0,8">
                <TextBlock TextWrapping="Wrap" Text="{Binding}" />
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="ui:MaintainPage">
      <UniformGrid Columns="3" ColumnSpacing="12">
        <Button Command="{Binding Repair}" MinHeight="150" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
          <StackPanel Spacing="6">
            <TextBlock Classes="row-title" Text="Repair" />
            <TextBlock Classes="muted" Text="Reinstall WSGM and its plugin, install missing drivers, and review your profile." />
          </StackPanel>
        </Button>
        <Button Command="{Binding Uninstall}" MinHeight="150" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
          <StackPanel Spacing="6">
            <TextBlock Classes="row-title" Text="Uninstall" />
            <TextBlock Classes="muted" Text="Remove WSGM. You choose what stays." />
          </StackPanel>
        </Button>
        <Button Command="{Binding Close}" MinHeight="150" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
          <StackPanel Spacing="6">
            <TextBlock Classes="row-title" Text="Close" />
            <TextBlock Classes="muted" Text="Leave everything as it is." />
          </StackPanel>
        </Button>
      </UniformGrid>
    </DataTemplate>

    <DataTemplate DataType="ui:HardwarePage">
      <StackPanel Spacing="14">
        <Border Classes="card">
          <StackPanel Spacing="4">
            <TextBlock Classes="row-title" FontSize="18" Text="{Binding Device}" />
            <TextBlock Classes="mono" Text="{Binding Identity}" />
          </StackPanel>
        </Border>
        <ItemsControl ItemsSource="{Binding Candidates}" IsVisible="{Binding HasMatch}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="ui:CandidateOption">
              <RadioButton Classes="choice" GroupName="device" IsChecked="{Binding Selected}" Margin="0,0,0,8">
                <StackPanel Spacing="4">
                  <TextBlock Classes="row-title" Text="{Binding Name}" />
                  <TextBlock Classes="badges" Text="{Binding Badges}" />
                </StackPanel>
              </RadioButton>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border Classes="banner warn" IsVisible="{Binding HasCaution}">
          <TextBlock TextWrapping="Wrap" Text="{Binding Caution}" />
        </Border>
        <CheckBox IsChecked="{Binding InstallPlugin}" IsVisible="{Binding HasMatch}"
                  Content="Install hardware support" />
        <Border Classes="card" IsVisible="{Binding HasMatch}">
          <StackPanel Spacing="6">
            <TextBlock Classes="section" Text="WHAT GETS INSTALLED" />
            <TextBlock Text="WSGM" />
            <ItemsControl ItemsSource="{Binding WillInstall}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Text="{Binding}" Margin="0,2" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
        <Border Classes="banner" IsVisible="{Binding NoMatch}">
          <TextBlock TextWrapping="Wrap"
                     Text="When a WSGM release includes a plugin for this device, the update installs it for you." />
        </Border>
        <StackPanel Spacing="6" IsVisible="{Binding HasCommons}">
          <TextBlock Classes="section" Text="OPTIONAL" />
          <ItemsControl ItemsSource="{Binding Commons}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="ui:CommonOption">
                <CheckBox IsChecked="{Binding Checked}" Content="{Binding Name}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="ui:ProfilePage">
      <StackPanel Spacing="12">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Classes="section" Text="INTEGRATION" />
          <TextBlock Classes="badges" Text="{Binding Chip}" VerticalAlignment="Center" />
        </StackPanel>
        <UniformGrid Columns="2" ColumnSpacing="12">
          <RadioButton Classes="choice" GroupName="level" IsChecked="{Binding IsFull}">
            <StackPanel Spacing="4">
              <TextBlock Classes="row-title" Text="Full" />
              <TextBlock Classes="muted" Text="Everything on: Steam Input handling, Steam UI integration, and WSGM starting Steam for you." />
            </StackPanel>
          </RadioButton>
          <RadioButton Classes="choice" GroupName="level" IsChecked="{Binding IsMinimal}">
            <StackPanel Spacing="4">
              <TextBlock Classes="row-title" Text="Minimal" />
              <TextBlock Classes="muted" Text="The WSGM session only. Steam stays exactly as it is." />
            </StackPanel>
          </RadioButton>
        </UniformGrid>
        <TextBlock Classes="section" Text="START" />
        <UniformGrid Columns="2" ColumnSpacing="12">
          <RadioButton Classes="choice" GroupName="start" IsChecked="{Binding SteamFirst}">
            <StackPanel Spacing="4">
              <TextBlock Classes="row-title" Text="Steam first" />
              <TextBlock Classes="muted" Text="Signs in straight to Steam's Big Picture, like a console." />
            </StackPanel>
          </RadioButton>
          <RadioButton Classes="choice" GroupName="start" IsChecked="{Binding DesktopFirst}">
            <StackPanel Spacing="4">
              <TextBlock Classes="row-title" Text="Desktop first" />
              <TextBlock Classes="muted" Text="Signs in to the Windows desktop. Game Mode is one tap away." />
            </StackPanel>
          </RadioButton>
        </UniformGrid>
        <ToggleSwitch IsChecked="{Binding SignIn}" OnContent="Start WSGM when you sign in"
                      OffContent="Start WSGM when you sign in" />
        <ToggleButton IsChecked="{Binding Customize}" Content="Customize…" MinHeight="48" Padding="22,0" />
        <StackPanel Spacing="4" IsVisible="{Binding Customize}">
          <ItemsControl ItemsSource="{Binding Features}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="ui:FeatureOption">
                <StackPanel Margin="0,2">
                  <ToggleSwitch IsChecked="{Binding On}" IsEnabled="{Binding Enabled}"
                                OnContent="{Binding Label}" OffContent="{Binding Label}" />
                  <TextBlock Classes="muted" Text="{Binding Description}" IsVisible="{Binding HasDescription}"
                             Margin="0,0,0,4" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="section" Text="STEAM AT SIGN-IN" />
          <ToggleSwitch IsChecked="{Binding Takeover}" OnContent="Let WSGM start Steam" OffContent="Let WSGM start Steam" />
          <TextBlock Classes="muted"
                     Text="Windows stops starting Steam on its own. WSGM starts it instead, so Steam can reach elevated games and windows. These entries are switched off, not deleted, and uninstalling WSGM puts them back:" />
          <TextBlock Classes="mono" Text="{Binding TakeoverEntries}" IsVisible="{Binding HasTakeoverEntries}" />
        </StackPanel>
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="ui:DriversPage">
      <StackPanel Spacing="12">
        <Border Classes="banner warn">
          <TextBlock TextWrapping="Wrap"
                     Text="Controller, touch screen and keyboard disconnect for a few seconds. They come back on their own. Don't turn the device off while it happens." />
        </Border>
        <Border Classes="banner">
          <TextBlock TextWrapping="Wrap"
                     Text="The virtual controller starts working after Windows restarts. You can restart at the end of setup or later." />
        </Border>
        <Border Classes="card">
          <StackPanel Spacing="10">
            <StackPanel>
              <TextBlock Classes="row-title" Text="USB/IP driver" />
              <TextBlock Classes="muted" Text="usbip-win2, signed by Microsoft. VIIPER attaches the virtual controller through it." />
            </StackPanel>
            <StackPanel>
              <TextBlock Classes="row-title" Text="HidHide" />
              <TextBlock Classes="muted" Text="Hides the built-in controller from games so they see one controller, not two." />
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="ui:UninstallPage">
      <StackPanel Spacing="12">
        <StackPanel Spacing="12" IsVisible="{Binding Editing}">
          <CheckBox IsChecked="{Binding KeepData}" Content="Keep my settings and data" />
          <TextBlock Classes="muted"
                     Text="Profiles, per-game settings, learned device data, artwork and logs stay. Reinstalling picks them up again." />
          <Border Classes="banner good">
            <TextBlock TextWrapping="Wrap"
                       Text="Your controller is shown to games again either way, even if HidHide stays installed." />
          </Border>
          <ToggleButton IsChecked="{Binding Custom}" Content="Custom…" MinHeight="48" Padding="22,0"
                        IsVisible="{Binding HasOwnedComponents}" />
          <StackPanel Spacing="6" IsVisible="{Binding Custom}">
            <TextBlock Classes="section" Text="DRIVERS" />
            <CheckBox IsChecked="{Binding RemoveUsbip}" IsVisible="{Binding CanRemoveUsbip}"
                      Content="Remove the USB/IP driver (restarts every USB hub)" />
            <CheckBox IsChecked="{Binding RemoveHidHide}" IsVisible="{Binding CanRemoveHidHide}"
                      Content="Remove HidHide (keep it if another app uses it)" />
          </StackPanel>
        </StackPanel>
        <Border Classes="card" IsVisible="{Binding Confirming}">
          <ItemsControl ItemsSource="{Binding Consequences}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Classes="row-title" Text="{Binding}" Margin="0,3" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="ui:ProgressPage">
      <StackPanel Spacing="14">
        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent}" Height="6" />
        <ItemsControl ItemsSource="{Binding Steps}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="ui:StepRow">
              <Grid ColumnDefinitions="28,*" Margin="0,4">
                <TextBlock Text="{Binding Glyph}" FontWeight="Bold" Foreground="{StaticResource HcSuccessBrush}" />
                <StackPanel Grid.Column="1">
                  <TextBlock Text="{Binding Label}" FontSize="15" />
                  <TextBlock Classes="muted" Text="{Binding Note}" IsVisible="{Binding HasNote}" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="ui:SummaryPage">
      <StackPanel Spacing="14">
        <Border Classes="banner bad" IsVisible="{Binding HasProblem}">
          <TextBlock TextWrapping="Wrap" Text="{Binding Problem}" />
        </Border>
        <Border Classes="card">
          <ItemsControl ItemsSource="{Binding Steps}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="ui:StepRow">
                <Grid ColumnDefinitions="28,*" Margin="0,3">
                  <TextBlock Text="{Binding Glyph}" FontWeight="Bold" Foreground="{StaticResource HcSuccessBrush}" />
                  <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="15" TextWrapping="Wrap" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
      </StackPanel>
    </DataTemplate>
  </Window.DataTemplates>

  <Grid ColumnDefinitions="312,*" RowDefinitions="*,52">
    <Border Classes="rail">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="0,0,0,28">
          <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource HcAccentBrush}">
            <TextBlock Text="W" FontWeight="Bold" FontSize="15" Foreground="{StaticResource HcOnAccentBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="WSGM" FontWeight="Bold" FontSize="20" />
            <TextBlock Classes="muted" FontSize="12" Text="{Binding Version, StringFormat='Setup {0}'}" />
          </StackPanel>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Spacing="4">
          <TextBlock Classes="muted" Text="Installs to" />
          <TextBlock Classes="mono" FontSize="11.5" Text="{Binding InstallPath}" />
        </StackPanel>
        <ItemsControl ItemsSource="{Binding Rail}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="ui:RailStep">
              <Grid ColumnDefinitions="36,*" Margin="0,4">
                <Border Width="24" Height="24" CornerRadius="12" BorderThickness="2"
                        BorderBrush="{StaticResource HcControlBorderBrush}">
                  <TextBlock Text="{Binding Marker}" FontSize="12" HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="15" VerticalAlignment="Center"
                           FontWeight="{Binding IsCurrent, Converter={x:Static ui:Converters.BoldWhenTrue}}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </DockPanel>
    </Border>

    <DockPanel Grid.Column="1">
      <Border DockPanel.Dock="Bottom" BorderBrush="#0FFFFFFF" BorderThickness="0,1,0,0" Padding="56,16,56,22">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
          <Button x:Name="BackButton" Content="{Binding Page.Back}" Command="{Binding BackCommand}"
                  IsVisible="{Binding Page.Back, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <Button x:Name="PrimaryButton" Classes="primary" Content="{Binding Page.Primary}"
                  Command="{Binding PrimaryCommand}"
                  Classes.danger="{Binding Page.PrimaryIsDanger}"
                  IsVisible="{Binding Page.Primary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </Border>
      <ScrollViewer Padding="56,44,56,20">
        <StackPanel Spacing="20" MaxWidth="820" HorizontalAlignment="Left">
          <StackPanel Spacing="4">
            <TextBlock Classes="eyebrow" Text="{Binding Page.Eyebrow}" />
            <TextBlock Classes="title" Text="{Binding Page.Title}" />
          </StackPanel>
          <TextBlock Classes="lead" Text="{Binding Page.Lead}" IsVisible="{Binding Page.HasLead}" />
          <ContentControl Content="{Binding Page}" />
        </StackPanel>
      </ScrollViewer>
    </DockPanel>

    <Border Grid.Row="1" Grid.ColumnSpan="2" Classes="hints">
      <DockPanel>
        <TextBlock Classes="muted" Text="{Binding HintLeft}" VerticalAlignment="Center" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="26">
          <TextBlock Text="Ⓐ Select" VerticalAlignment="Center" />
          <TextBlock Text="Ⓑ Back" VerticalAlignment="Center" />
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</Window>

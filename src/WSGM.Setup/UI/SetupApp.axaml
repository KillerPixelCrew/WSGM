<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="WSGM.Setup.UI.SetupApp"
             RequestedThemeVariant="Dark">
  <!-- WSGM's own colour tokens and text styles, linked from src\WSGM\Themes. -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Themes/Palette.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="/Themes/Typography.axaml" />
    <StyleInclude Source="/UI/SetupTheme.axaml" />
  </Application.Styles>
</Application>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="using:OpenFSE.Settings"
        x:Class="OpenFSE.Settings.SettingsWindow"
        x:DataType="s:SettingsViewModel"
        Title="OpenFSE Settings"
        Width="980" Height="780" MinWidth="760" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        TransparencyLevelHint="AcrylicBlur"
        Background="Transparent">

    <ExperimentalAcrylicBorder CornerRadius="16" Margin="1">
        <ExperimentalAcrylicBorder.Material>
            <ExperimentalAcrylicMaterial BackgroundSource="Digger"
                                         TintColor="#101729"
                                         TintOpacity="0.88"
                                         MaterialOpacity="0.72"
                                         FallbackColor="#FF101729" />
        </ExperimentalAcrylicBorder.Material>

        <Grid RowDefinitions="Auto,*,Auto">
            <Border Grid.Row="0" Padding="28,24,28,20" BorderBrush="#22FFFFFF" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="5">
                        <TextBlock Classes="eyebrow" Text="HANDHELD SHELL • CONTROL CENTER" />
                        <TextBlock Classes="page-title" Text="OpenFSE" />
                        <TextBlock Classes="caption" Text="A quiet, controller-first Windows session — configured your way." />
                    </StackPanel>
                    <Border Grid.Column="1" Classes="glass-row" Padding="12,7" VerticalAlignment="Center">
                        <TextBlock Text="SETTINGS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentCyanBrush}" />
                    </Border>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="28,22" Spacing="18">

                    <!-- Shell status -->
                    <Border Classes="glass-panel">
                        <StackPanel Spacing="14">
                            <Grid ColumnDefinitions="5,*,Auto" ColumnSpacing="12">
                                <Border Background="{StaticResource AccentGradient}" CornerRadius="3" />
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock Classes="section-title" Text="Windows shell" />
                                    <TextBlock Classes="caption" Text="Choose whether OpenFSE starts in place of Explorer for this account." />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="SYSTEM" Classes="eyebrow" VerticalAlignment="Center" />
                            </Grid>
                            <Border Classes="glass-row">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{Binding ShellStatusText}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Classes="caption" Text="{Binding AppStatusText}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Content="Install app" Click="OnInstallApp" ToolTip.Tip="Copy OpenFSE to its per-user install location and register it in Start Menu / Settings → Apps (does not change your shell)" />
                                <Button Classes="primary" Content="Install as shell" Click="OnInstall" IsEnabled="{Binding !ShellInstalled}" />
                                <Button Classes="danger" Content="Restore previous shell" Click="OnUninstall" IsEnabled="{Binding ShellInstalled}" />
                            </StackPanel>
                            <TextBlock Classes="caption"
                                       Text="Recovery: Ctrl+Alt+Del → Task Manager → Run new task → explorer.exe for this session, or OpenFSE.exe --restore-shell to restore permanently. Three shell crashes in two minutes also restore your prior shell automatically." />
                        </StackPanel>
                    </Border>

                    <!-- Home app -->
                    <Border Classes="glass-panel">
                        <StackPanel Spacing="14">
                            <Grid ColumnDefinitions="5,*" ColumnSpacing="12">
                                <Border Background="{StaticResource AccentGradient}" CornerRadius="3" />
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock Classes="section-title" Text="Home app" />
                                    <TextBlock Classes="caption" Text="The launcher OpenFSE returns to when you leave the desktop." />
                                </StackPanel>
                            </Grid>
                            <!-- Pick a launcher: everything technical is filled in for you -->
                            <StackPanel Spacing="8">
                                <ComboBox ItemsSource="{Binding LauncherChoices}"
                                          SelectedIndex="{Binding SelectedLauncherIndex}"
                                          HorizontalAlignment="Stretch" MinHeight="42" />
                                <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding LauncherHintText}" />
                            </StackPanel>

                            <Expander Header="Advanced (path, arguments, window matching)">
                                <StackPanel Spacing="10" Margin="0,8,0,0">
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="10" ColumnSpacing="10">
                                        <TextBox Grid.Column="0" Grid.Row="0"
                                                 Watermark="Path to launcher exe"
                                                 Text="{Binding HomeAppPath}" />
                                        <Button Grid.Column="1" Grid.Row="0" Content="Browse…" Click="OnBrowseHomeApp" />
                                        <TextBox Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2"
                                                 Watermark="Arguments"
                                                 Text="{Binding HomeAppArgs}" />
                                    </Grid>
                                    <TextBlock Classes="caption" TextWrapping="Wrap"
                                               Text="Only needed for launchers OpenFSE doesn't know. Picking a launcher above fills these in, along with the process names and window class used to tell when it's running." />
                                </StackPanel>
                            </Expander>
                            <StackPanel Orientation="Horizontal" Spacing="28">
                                <CheckBox Content="Run as administrator" IsChecked="{Binding HomeAppElevated}" />
                                <CheckBox Content="Auto-relaunch when it exits" IsChecked="{Binding HomeAppAutoRelaunch}" />
                            </StackPanel>

                            <!-- UAC prompt level -->
                            <Border Classes="glass-row">
                                <StackPanel Spacing="8">
                                    <CheckBox x:Name="UacCheckBox"
                                              Content="Never show UAC prompts on this PC"
                                              IsChecked="{Binding UacPromptsDisabled, Mode=OneWay}"
                                              Click="OnToggleUac" />
                                    <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding UacStatusText}" />
                                    <TextBlock Classes="caption" TextWrapping="Wrap" Foreground="#FFD08A3E"
                                               Text="Security trade-off: this is the lowest position of the Windows UAC slider (&quot;Never notify&quot;). It applies to the whole PC and every administrator account, so ANY program that requests administrator rights gets them without asking you. Only enable this on a personal device you trust — it is what makes elevated launches silent at boot. Changing it needs one administrator confirmation and applies immediately; unticking restores your previous setting." />
                                </StackPanel>
                            </Border>

                            <!-- Lock on wake -->
                            <Border Classes="glass-row">
                                <StackPanel Spacing="8">
                                    <CheckBox x:Name="LockOnWakeCheckBox"
                                              Content="No lock screen after screen off / standby"
                                              IsChecked="{Binding LockOnWakeDisabled, Mode=OneWay}"
                                              Click="OnToggleLockOnWake" />
                                    <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding LockOnWakeStatusText}" />
                                    <TextBlock Classes="caption" TextWrapping="Wrap" Foreground="#FFD08A3E"
                                               Text="Turns off &quot;Require a password on wakeup&quot; — as a machine policy AND on every power plan, so tools like Handheld Companion switching plans can't bring the lock screen back — and sets the NoLockScreen policy to remove the lock screen UI (Windows 11 Home ignores that last part on some builds). Anyone who picks up the device can use it without signing in, so keep it for a personal handheld. Needs one administrator confirmation; unticking restores the previous behaviour." />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Startup apps -->
                    <Border Classes="glass-panel">
                        <StackPanel Spacing="14">
                            <Grid ColumnDefinitions="5,*" ColumnSpacing="12">
                                <Border Background="{StaticResource AccentGradient}" CornerRadius="3" />
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock Classes="section-title" Text="Startup apps" />
                                    <TextBlock Classes="caption" Text="Launch supporting utilities in order before your home app starts." />
                                </StackPanel>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding StartupApps}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="s:StartupAppRow">
                                        <Border Classes="glass-row" Margin="0,3">
                                            <Grid ColumnDefinitions="Auto,*,180,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="6">
                                                <CheckBox Grid.Column="0" IsChecked="{Binding Enabled}" VerticalAlignment="Center" ToolTip.Tip="Enabled" />
                                                <TextBox Grid.Column="1" Text="{Binding Path}" Watermark="Application path" />
                                                <TextBox Grid.Column="2" Text="{Binding Args}" Watermark="Arguments" />
                                                <CheckBox Grid.Column="3" IsChecked="{Binding Elevated}" Content="Admin" VerticalAlignment="Center" />
                                                <Button Grid.Column="4" Classes="icon" Content="↑" Click="OnMoveUp" ToolTip.Tip="Move up" />
                                                <Button Grid.Column="5" Classes="icon" Content="↓" Click="OnMoveDown" ToolTip.Tip="Move down" />
                                                <Button Grid.Column="6" Content="Browse" Click="OnBrowseStartupApp" />
                                                <Button Grid.Column="7" Classes="icon danger" Content="×" Click="OnRemoveApp" ToolTip.Tip="Remove" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                <ComboBox Grid.Column="0" ItemsSource="{Binding StartupSuggestions}"
                                          SelectedIndex="{Binding SelectedSuggestionIndex}"
                                          HorizontalAlignment="Stretch" MinHeight="40"
                                          ToolTip.Tip="Programs found on this PC that are commonly started before the launcher" />
                                <Button Grid.Column="1" Classes="primary" Content="Add" Click="OnAddApp" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                    <TextBlock Text="Delay between apps (ms)" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    <NumericUpDown Value="{Binding StaggerDelayMs}" Minimum="0" Maximum="30000" Increment="250" Width="150" FormatString="0" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Overlay -->
                    <Border Classes="glass-panel">
                        <StackPanel Spacing="14">
                            <Grid ColumnDefinitions="5,*" ColumnSpacing="12">
                                <Border Background="{StaticResource AccentGradient}" CornerRadius="3" />
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock Classes="section-title" Text="Overlay &amp; input" />
                                    <TextBlock Classes="caption" Text="Use a desktop hotkey, touch-edge gestures, or your controller to summon the quick menu." />
                                </StackPanel>
                            </Grid>
                            <Border Classes="glass-row">
                                <StackPanel Spacing="12">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock Text="Hotkey" Width="70" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                        <CheckBox Content="Ctrl" IsChecked="{Binding HotkeyCtrl}" />
                                        <CheckBox Content="Alt" IsChecked="{Binding HotkeyAlt}" />
                                        <CheckBox Content="Shift" IsChecked="{Binding HotkeyShift}" />
                                        <CheckBox Content="Win" IsChecked="{Binding HotkeyWin}" />
                                        <ComboBox ItemsSource="{Binding HotkeyKeys}" SelectedIndex="{Binding HotkeyKeyIndex}" Width="130" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="28">
                                        <CheckBox Content="Swipe from bottom edge" IsChecked="{Binding GestureBottom}" />
                                        <CheckBox Content="Swipe from right edge" IsChecked="{Binding GestureRight}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Grid ColumnDefinitions="Auto,170,Auto,Auto" ColumnSpacing="10">
                                <TextBlock Text="Button glyphs" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding GlyphStyles}" SelectedIndex="{Binding GlyphStyleIndex}" />
                                <Button Grid.Column="2" Content="Test overlay" Click="OnTestOverlay" />
                                <Button Grid.Column="3" Content="Touch keyboard" Click="OnTouchKeyboard" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Padding="28,16" BorderBrush="#22FFFFFF" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <Button Classes="primary" Content="Save changes" FontWeight="Bold" MinWidth="148" Click="OnSave" />
                    <TextBlock x:Name="SaveStatus" Classes="caption" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </ExperimentalAcrylicBorder>
</Window>

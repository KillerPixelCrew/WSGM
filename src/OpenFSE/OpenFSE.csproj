<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>OpenFSE</AssemblyName>
    <RootNamespace>OpenFSE</RootNamespace>
    <Version>0.1.0</Version>

    <!-- NativeAOT single exe -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <StripSymbols>false</StripSymbols>
    <!-- Per Avalonia NativeAOT guidance -->
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>

    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.*" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.*" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.*" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.*" />
    <!-- WinUI-style NavigationView, SettingsCard, ToggleSwitch and InfoBar: the
         Avalonia counterparts to the iNKORE Modern WPF controls used by Handheld Companion. -->
    <PackageReference Include="FluentAvaloniaUI" Version="2.4.1" />
    <!-- Controller input. Plain-DllImport bindings (AOT-safe), bundles native SDL3.dll
         for win-x64 so build and publish output pick it up automatically. -->
    <PackageReference Include="ppy.SDL3-CS" Version="2026.722.0" />
  </ItemGroup>
</Project>

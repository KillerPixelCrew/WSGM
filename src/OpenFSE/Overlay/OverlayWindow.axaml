<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ov="using:OpenFSE.Overlay"
        x:Class="OpenFSE.Overlay.OverlayWindow"
        x:DataType="ov:OverlayViewModel"
        Title="OpenFSE Overlay"
        WindowState="FullScreen"
        SystemDecorations="None"
        Topmost="True"
        ShowInTaskbar="False"
        Background="#CC101014">

    <Window.Styles>
        <Style Selector="Button.overlay">
            <Setter Property="MinHeight" Value="72" />
            <Setter Property="MinWidth" Value="420" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="#28FFFFFF" />
        </Style>
        <Style Selector="Button.overlay:focus /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="#FFFFFFFF" />
            <Setter Property="BorderThickness" Value="3" />
        </Style>
        <Style Selector="Button.power">
            <Setter Property="MinHeight" Value="72" />
            <Setter Property="MinWidth" Value="132" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="#28FFFFFF" />
        </Style>
        <Style Selector="Button.power:focus /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="#FFFFFFFF" />
            <Setter Property="BorderThickness" Value="3" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="*,Auto,*,Auto" Background="Transparent"
          PointerPressed="OnBackgroundPressed">

        <StackPanel Grid.Row="1" Spacing="16" HorizontalAlignment="Center">

            <TextBlock Text="OpenFSE" FontSize="32" FontWeight="Bold"
                       HorizontalAlignment="Center" Foreground="White" Margin="0,0,0,8" />

            <Border IsVisible="{Binding HasWarning}" Background="#66AA3300" CornerRadius="8" Padding="12"
                    MaxWidth="560">
                <TextBlock Text="{Binding WarningText}" TextWrapping="Wrap" Foreground="White" />
            </Border>

            <Button x:Name="HomeAppButton" Classes="overlay"
                    Content="{Binding HomeAppButtonText}" Click="OnHomeApp" />

            <Button x:Name="DesktopButton" Classes="overlay"
                    Content="{Binding DesktopButtonText}" Click="OnDesktop" />

            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                <Button Classes="power" Content="Sleep" Click="OnSleep" />
                <Button x:Name="RestartButton" Classes="power" Content="Restart" Click="OnRestart" />
                <Button x:Name="ShutdownButton" Classes="power" Content="Shutdown" Click="OnShutdown" />
            </StackPanel>

            <Button Classes="overlay" Content="Close" Click="OnClose" />

        </StackPanel>

        <!-- Controller hint bar (Kenney CC0 glyphs, style-configurable) -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="24"
                    HorizontalAlignment="Center" Margin="0,0,0,32">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ov:GlyphIcon Width="36" Height="36" Button="a"
                              GlyphStyle="{Binding GlyphStyle}" VerticalAlignment="Center" />
                <TextBlock Text="Select" FontSize="18" Foreground="#CCFFFFFF" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ov:GlyphIcon Width="36" Height="36" Button="b"
                              GlyphStyle="{Binding GlyphStyle}" VerticalAlignment="Center" />
                <TextBlock Text="Back" FontSize="18" Foreground="#CCFFFFFF" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>

    </Grid>
</Window>

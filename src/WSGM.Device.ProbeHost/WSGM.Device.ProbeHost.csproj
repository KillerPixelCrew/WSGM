<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>WSGM.Device.ProbeHost</AssemblyName>
    <RootNamespace>WSGM.Device.ProbeHost</RootNamespace>
    <SelfContained>false</SelfContained>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Disposable, one probe per process. Kept separate from WSGM.DeviceHost so a
         probe's typed, profile-scoped interfaces can never appear in production
         DeviceHost IPC: they are not in the same assembly to begin with. -->
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\WSGM.DeviceLab.Core\WSGM.DeviceLab.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.0" />
  </ItemGroup>
</Project>

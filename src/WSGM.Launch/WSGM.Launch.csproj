<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Console subsystem (shows a CLI window), NOT WinExe: a windowless GUI
         wrapper is treated by Steam as a game and gets Steam Input hooked into it,
         which kills it before it runs. The Steam Input lease wrapper this replaced
         was a console app for the same reason. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- Explicit usings, matching WSGM.csproj: the canonical SteamInterop binding
         linked below carries its own explicit usings by contract, and implicit
         usings would flag every one of them as redundant. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\WSGM\Assets\wsgm.ico</ApplicationIcon>
    <AssemblyName>WSGM.Launch</AssemblyName>
    <RootNamespace>WSGM.Launch</RootNamespace>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!-- The wrapper and WSGM compile the same canonical binding sources from the submodule.
       The native DLLs already ship beside both executables in the app directory. -->
  <ItemGroup>
    <!-- The resident app and wrapper must submit the same de-elevation task document. -->
    <Compile Include="..\WSGM\Core\ScheduledTaskXml.cs" Link="Shared\ScheduledTaskXml.cs"/>
    <!-- PlatformSupport.cs is the binding project's own assembly attribute, not binding code. -->
    <Compile Include="..\..\external\steam-input-lease\bindings\SteamInterop.Net\*.cs"
             Exclude="..\..\external\steam-input-lease\bindings\SteamInterop.Net\PlatformSupport.cs"
             LinkBase="SteamInterop"/>
  </ItemGroup>
</Project>

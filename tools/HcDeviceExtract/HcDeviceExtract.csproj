<Project Sdk="Microsoft.NET.Sdk">
  <!-- Development-time tool: reads the decompiled Handheld Companion source in _ref and writes Device
       Lab knowledge records. It is not part of WSGM.slnx and never ships. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- System.Windows.Forms.Keys resolves the virtual-key values HC's KeyCode names stand for. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WSGM.Tools.HcDeviceExtract</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0"/>
  </ItemGroup>
</Project>

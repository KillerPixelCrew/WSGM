<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="using:FluentAvalonia.Styling" xmlns:controls="using:FluentAvalonia.UI.Controls"
             x:Class="WSGM.OverlayMockup.MockupApp" RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Palette.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <!-- Startup palette pair: change both colors together to preserve primary-action contrast. -->
      <Color x:Key="AccentColor">#FF9D3D</Color>
      <Color x:Key="OnAccentColor">#17191C</Color>
      <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
      <SolidColorBrush x:Key="AccentField" Color="{StaticResource AccentColor}" Opacity="0.12" />
      <SolidColorBrush x:Key="OnAccent" Color="{StaticResource OnAccentColor}" />
      <SolidColorBrush x:Key="Ink" Color="#F4F5F7" />
      <SolidColorBrush x:Key="Secondary" Color="#BEC3CC" />
      <SolidColorBrush x:Key="Muted" Color="#989FAA" />
      <SolidColorBrush x:Key="Divider" Color="#414751" />
      <SolidColorBrush x:Key="Hover" Color="#363D47" />
      <SolidColorBrush x:Key="Pressed" Color="#454D59" />
      <SolidColorBrush x:Key="FocusFill" Color="#424953" />
      <SolidColorBrush x:Key="Warning" Color="#E6C56D" />
      <SolidColorBrush x:Key="Danger" Color="#F18383" />
      <SolidColorBrush x:Key="Success" Color="#8CC6A1" />
      <SolidColorBrush x:Key="Scrim" Color="#880B0D10" />
      <SolidColorBrush x:Key="GlassCanvas" Color="#BE171A1F" />
      <SolidColorBrush x:Key="GlassRail" Color="#E01C2026" />
      <SolidColorBrush x:Key="GlassControls" Color="#B322272E" />
      <SolidColorBrush x:Key="GlassGroup" Color="#A62B3139" />
      <SolidColorBrush x:Key="GlassSurface" Color="#F02B3139" />
      <SolidColorBrush x:Key="OpaqueCanvas" Color="#171A1F" />
      <SolidColorBrush x:Key="OpaqueRail" Color="#1C2026" />
      <SolidColorBrush x:Key="OpaqueControls" Color="#22272E" />
      <SolidColorBrush x:Key="OpaqueGroup" Color="#2B3139" />
      <SolidColorBrush x:Key="OpaqueSurface" Color="#303741" />
      <CornerRadius x:Key="ControlRadius">4</CornerRadius>
      <CornerRadius x:Key="SurfaceRadius">6</CornerRadius>
      <Thickness x:Key="FocusBorder">2</Thickness>
      <x:Double x:Key="SpaceSmall">4</x:Double>
      <x:Double x:Key="SpaceMedium">8</x:Double>
      <x:Double x:Key="SpaceLarge">12</x:Double>
      <Thickness x:Key="GroupPadding">16</Thickness>
      <Thickness x:Key="ShellPadding">24</Thickness>
      <x:Double x:Key="TouchTarget">44</x:Double>
      <x:Double x:Key="RailTarget">48</x:Double>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <fa:FluentAvaloniaTheme CustomAccentColor="{StaticResource AccentColor}" />
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter" />
      <Setter Property="FontSize" Value="14" /><Setter Property="Foreground" Value="{DynamicResource Ink}" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource Muted}" />
    </Style>
    <Style Selector="Border.group, Border.utility-surface, Border.power-surface">
      <Setter Property="Background" Value="{DynamicResource Group}" />
      <Setter Property="CornerRadius" Value="{StaticResource SurfaceRadius}" />
      <Setter Property="Padding" Value="{StaticResource GroupPadding}" />
    </Style>
    <Style Selector="Border.utility-surface, Border.power-surface, Border.keyboard-surface">
      <Setter Property="Background" Value="{DynamicResource Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.rail-plane">
      <Setter Property="Background" Value="{DynamicResource Rail}" />
    </Style>
    <Style Selector="Border.controls-plane">
      <Setter Property="Background" Value="{DynamicResource Controls}" />
    </Style>
    <Style Selector="Border.setting-row">
      <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" /><Setter Property="Padding" Value="0,4" />
    </Style>
    <Style Selector="Border.stat">
      <Setter Property="Padding" Value="0,8" />
    </Style>
    <Style Selector="Button">
      <Setter Property="MinHeight" Value="{StaticResource TouchTarget}" />
      <Setter Property="MinWidth" Value="{StaticResource TouchTarget}" />
      <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
      <Setter Property="BorderThickness" Value="{StaticResource FocusBorder}" />
      <Setter Property="BorderBrush" Value="Transparent" /><Setter Property="FocusAdorner" Value="{x:Null}" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="Background" Value="{DynamicResource Group}" /><Setter Property="Padding" Value="12,8" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
            <Grid>
              <Border Name="SelectionRule" Background="{DynamicResource Accent}" IsVisible="False" />
              <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                Padding="{TemplateBinding Padding}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="Center" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.destination, Button.section-row, Button.utility, Button.tray-item">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.destination">
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="Button.destination.selected">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.destination.selected /template/ Border#SelectionRule">
      <Setter Property="IsVisible" Value="True" /><Setter Property="Height" Value="2" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>
    <Style Selector="Button.section-row.selected">
      <Setter Property="Background" Value="{DynamicResource AccentField}" />
    </Style>
    <Style Selector="Button.section-row.selected /template/ Border#SelectionRule">
      <Setter Property="IsVisible" Value="True" /><Setter Property="Width" Value="3" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.action-tile">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="MinHeight" Value="88" />
      <Setter Property="Padding" Value="12" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource Accent}" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
    </Style>
    <Style Selector="Button.app-item.active /template/ Border#SelectionRule">
      <Setter Property="IsVisible" Value="True" /><Setter Property="Height" Value="2" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="Background" Value="{DynamicResource Secondary}" />
    </Style>
    <Style Selector="Button:pointerover">
      <Setter Property="Background" Value="{DynamicResource Hover}" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    </Style>
    <Style Selector="Button:focus">
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
      <Setter Property="Background" Value="{DynamicResource FocusFill}" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    </Style>
    <Style Selector="Button:pressed">
      <Setter Property="Background" Value="{DynamicResource Pressed}" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    </Style>
    <Style Selector="Button.destructive, Button.destructive:pointerover, Button.destructive:pressed, Button.destructive:focus">
      <Setter Property="Foreground" Value="{DynamicResource Danger}" />
    </Style>
    <Style Selector="Button:disabled">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
    <Style Selector="ComboBox, TextBox, ToggleSwitch, Slider, controls|FANumberBox">
      <Setter Property="MinHeight" Value="{StaticResource TouchTarget}" />
    </Style>
    <Style Selector="ComboBox, TextBox, ToggleSwitch, Slider">
      <Setter Property="FocusAdorner">
        <Template>
          <Border BorderBrush="{DynamicResource Accent}" BorderThickness="2"
                  CornerRadius="{StaticResource ControlRadius}" IsHitTestVisible="False" />
        </Template>
      </Setter>
    </Style>
    <Style Selector="ComboBox, TextBox, controls|FANumberBox">
      <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
      <Setter Property="BorderThickness" Value="{StaticResource FocusBorder}" />
    </Style>
    <Style Selector="ComboBox:focus-within, TextBox:focus-within, controls|FANumberBox:focus-within">
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="TextBox:focus-within /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
      <Setter Property="BorderThickness" Value="{StaticResource FocusBorder}" />
      <Setter Property="Background" Value="{DynamicResource FocusFill}" />
    </Style>
    <Style Selector="controls|FASettingsExpander">
      <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
    </Style>
    <Style Selector="controls|FAInfoBar.banner">
      <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
    </Style>
    <Style Selector="controls|FAInfoBadge">
      <Setter Property="Background" Value="{DynamicResource Hover}" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    </Style>
    <Style Selector="controls|FASettingsExpanderItem">
      <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1" Padding="0,4">
            <Grid ColumnDefinitions="*,Auto" MinHeight="48">
              <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                <ContentPresenter Content="{TemplateBinding Content}" />
                <TextBlock Text="{TemplateBinding Description}" Foreground="{DynamicResource Muted}" FontSize="11"
                           TextWrapping="Wrap" />
              </StackPanel>
              <ContentPresenter Grid.Column="1" Content="{TemplateBinding Footer}" VerticalAlignment="Center" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
  </Application.Styles>
</Application>

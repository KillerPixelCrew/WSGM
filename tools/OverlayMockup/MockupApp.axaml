<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="using:FluentAvalonia.Styling"
             xmlns:controls="using:FluentAvalonia.UI.Controls"
             x:Class="WSGM.OverlayMockup.MockupApp"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Palette.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <SolidColorBrush x:Key="Ink" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Muted" Color="#B8B8B8" />
      <SolidColorBrush x:Key="Accent" Color="#FF9D3D" />
      <SolidColorBrush x:Key="GlassTint" Color="#AD232323" />
      <SolidColorBrush x:Key="GlassCard" Color="#B32C2C2C" />
      <SolidColorBrush x:Key="GlassLine" Color="#24555555" />
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <fa:FluentAvaloniaTheme CustomAccentColor="#FF9D3D" />
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{StaticResource GlassCard}" />
      <Setter Property="BorderBrush" Value="{StaticResource GlassLine}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="16" />
    </Style>
    <Style Selector="Button">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
    </Style>
    <Style Selector="Button:focus-visible">
      <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
    </Style>
    <Style Selector="Button.nav">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="MinHeight" Value="44" />
    </Style>
    <Style Selector="Button.nav.selected">
      <Setter Property="Background" Value="#3DFF9D3D" />
      <Setter Property="Foreground" Value="{StaticResource Accent}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.tile">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="12" />
      <Setter Property="MinHeight" Value="86" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Background" Value="{StaticResource GlassCard}" />
      <Setter Property="BorderBrush" Value="{StaticResource GlassLine}" />
      <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style Selector="Button.tile:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#FF383838" />
    </Style>
    <Style Selector="Button.tile:focus-visible">
      <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource HcAccentBrush}" />
      <Setter Property="Foreground" Value="Black" />
      <Setter Property="Padding" Value="14,8" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="controls|FASettingsExpander">
      <Setter Property="Background" Value="#452C2C2C" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style Selector="controls|FASettingsExpanderItem">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid ColumnDefinitions="*,Auto" MinHeight="40" Margin="0,1">
            <ContentPresenter Content="{TemplateBinding Content}"
                              VerticalAlignment="Center" Margin="0,0,12,0" />
            <ContentPresenter Grid.Column="1" Content="{TemplateBinding Footer}"
                              VerticalAlignment="Center" />
          </Grid>
        </ControlTemplate>
      </Setter>
    </Style>
  </Application.Styles>
</Application>

    <PackageReference Include="FluentAvaloniaUI" Version="3.1.0" />
    <PackageReference Include="Avalonia.Labs.Panels" Version="12.0.2" />
    <AvaloniaResource Include="../../src/WSGM/Themes/Palette.axaml" Link="Palette.axaml" />
  </ItemGroup>
</Project>

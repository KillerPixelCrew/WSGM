<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Console subsystem on purpose: the spike's whole value is observable
         diagnostics, and a console wrapper is also what Steam already accepts as a
         non-Steam shortcut target without treating the wrapper itself as the game. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <AssemblyName>WsgmUwpSpike</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>Wsgm.UwpSpike</RootNamespace>
    <DebugType>none</DebugType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <!-- A bench receiver: added to Steam as a non-Steam game and launched through Steam, it prints what
       Steam Input delivers to a game, the virtual XInput pad and injected keys, as they change.
       Outside WSGM.slnx on purpose, like tools/DeckSpike, and it references nothing of WSGM. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <AssemblyName>SteamReceiver</AssemblyName>
    <RootNamespace>SteamReceiver</RootNamespace>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
